# Banana's changes over ROCKNIX's RK3566 kernel config (linux-rocknix.config): a kernel that boots straight to a
# read-only squashfs root, with nothing on the boot path the menu doesn't need.
CONFIG_LOCALVERSION="-banana"
# no initramfs: root=PARTLABEL=banana-root, mounted by the kernel itself
CONFIG_INITRAMFS_SOURCE=""
# root on squashfs, LZ4 (the fastest to decompress)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
# CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE is not set
# the menu draws on KMS directly: no fbdev, no console on the panels, no VTs to switch
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_VT is not set
# CONFIG_LOGO is not set
# the menu's hardware built in (the joypad and DSI panel drivers are added by external.mk)
CONFIG_INPUT_JOYSTICK=y
# the joypad driver polls through the old input-polldev API (ROCKNIX's RK3326 patch brings it back)
CONFIG_INPUT_POLLDEV=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_TOUCHSCREEN_GOODIX=y
# Panfrost (Mesa) for SuperDrastic's shaders and RetroArch's GLES; loaded after the menu is up
CONFIG_DRM_PANFROST=m
# suspend to RAM; PM_DEBUG for /sys/power/pm_print_times (each device's suspend and resume time in dmesg, to find
# what holds a wake-up up on the hardware)
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_WAKELOCKS is not set
# start on schedutil; banana-perf picks per profile
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# not used on a handheld that boots from an SD card
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SCHED_AUTOGROUP is not set
# file sharing over Wi-Fi (Settings > Network > File sharing): the kernel's SMB3 server, a module loaded only when
# sharing is switched on
CONFIG_SMB_SERVER=m
# out of ROCKNIX's config, shared by many devices, what the RG DS never uses: a smaller root (modules) and nothing
# on the network path (no packet filtering or connection tracking on every Wi-Fi packet)
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_NET_MPLS_GSO is not set
# CONFIG_NET_NSH is not set
# CONFIG_WIREGUARD is not set
# CONFIG_TUN is not set
# CONFIG_VETH is not set
# CONFIG_PPP is not set
# Wi-Fi: the RTL8821CS on SDIO alone (rtw88_8821cs)
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_RTL_CARDS is not set
# CONFIG_RTL8XXXU is not set
# CONFIG_RTW89 is not set
# CONFIG_RTW88_8822BS is not set
# CONFIG_RTW88_8822BU is not set
# CONFIG_RTW88_8822CS is not set
# CONFIG_RTW88_8822CU is not set
# CONFIG_RTW88_8723DS is not set
# CONFIG_RTW88_8723CS is not set
# CONFIG_RTW88_8723DU is not set
# CONFIG_RTW88_8821CU is not set
# CONFIG_RTW88_8821AU is not set
# CONFIG_RTW88_8812AU is not set
# CONFIG_RTW88_8814AU is not set
# no Bluetooth stack in userspace yet: the kernel's would only take room
# CONFIG_BT is not set
# USB serial adapters, NTFS, the video codec and 2D blocks, USB CEC adapters, serial mice
# CONFIG_USB_SERIAL is not set
# CONFIG_NTFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
# CONFIG_VIDEO_HANTRO is not set
# CONFIG_USB_PULSE8_CEC is not set
# CONFIG_USB_RAINSHADOW_CEC is not set
# CONFIG_SERIO_SERPORT is not set
# CONFIG_NFSD is not set
# CONFIG_RTL8187 is not set
# CONFIG_RTL8723BS is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_UNIX_DIAG is not set
# the whole image booted in QEMU (tools/qemu-boot.sh, the CI's boot job): a PCI host, an SD card on a PCI SDHCI
# (so the card is mmcblk0 as on the handheld), two panels on a virtio GPU, a virtio keyboard and tablet, the RTC
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_RTC_DRV_PL031=y
