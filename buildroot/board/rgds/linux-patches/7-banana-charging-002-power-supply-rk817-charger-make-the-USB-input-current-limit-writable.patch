 {
 	struct rk817_charger *charger = power_supply_get_drvdata(ps);
+	unsigned int reg;
+	int ret;
 
 	switch (prop) {
 	case POWER_SUPPLY_PROP_ONLINE:
 		val->intval = charger->plugged_in;
 		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = regmap_read(charger->rk808->regmap, RK817_PMIC_CHRG_IN,
+				  &reg);
+		if (ret)
+			return ret;
+		if (!(reg & RK817_USB_ILIM_EN))
+			return -ENODATA;
+		val->intval = rk817_input_cur_ua[FIELD_GET(RK817_USB_ILIM_SEL, reg)];
+		break;
