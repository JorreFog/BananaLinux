+/*
+ * USB input current limits in uA, indexed by the RK817_USB_ILIM_SEL value.
+ * The selector is not ordered by current.
+ */
+static const int rk817_input_cur_ua[] = {
+	450000, 80000, 850000, 1500000, 1750000, 2000000, 2500000, 3000000,
+};
+
+/* Input limits applied at init and after every unplug: 1.5A and 4.5V. */
+#define RK817_INPUT_CUR_DEFAULT_SEL	3
+#define RK817_INPUT_VOL_DEFAULT_SEL	5
+
+/*
+ * Highest input current limit userspace may select. The 3A setting may draw
+ * up to 3.2A, and the driver cannot tell what the source supplies.
+ */
+#define RK817_INPUT_CUR_MAX_UA		2000000
 
 static int rk817_chg_cur_from_reg(u8 reg)
 {
@@ -604,11 +627,22 @@
