@@ -635,12 +669,104 @@
 
 }
 
+/* Writes the current limit with the default minimum input voltage. */
+static int rk817_chg_write_input(struct rk817_charger *charger,
+				 unsigned int ilim_sel)
+{
+	lockdep_assert_held(&charger->input_lock);
+
+	return regmap_write_bits(charger->rk808->regmap, RK817_PMIC_CHRG_IN,
+				 RK817_USB_VLIM_EN | RK817_USB_VLIM_SEL |
+				 RK817_USB_ILIM_EN | RK817_USB_ILIM_SEL,
+				 RK817_USB_VLIM_EN |
+				 FIELD_PREP(RK817_USB_VLIM_SEL,
+					    RK817_INPUT_VOL_DEFAULT_SEL) |
+				 RK817_USB_ILIM_EN |
+				 FIELD_PREP(RK817_USB_ILIM_SEL, ilim_sel));
+}
+
+static int rk817_chg_write_default_input(struct rk817_charger *charger)
+{
+	int ret;
+
+	ret = rk817_chg_write_input(charger, RK817_INPUT_CUR_DEFAULT_SEL);
+	if (ret)
+		dev_warn(charger->dev, "unable to set default input limits: %d\n",
+			 ret);
+
+	return ret;
+}
+
+/*
+ * Set minimum USB input voltage to 4.5v and average USB input current limit
+ * to 1.5A, and enable both limits.
+ */
+static int rk817_chg_reset_input(struct rk817_charger *charger)
+{
+	guard(mutex)(&charger->input_lock);
+
+	return rk817_chg_write_default_input(charger);
+}
+
+/*
+ * A raised input limit is only for the charger attached now, and only while
+ * the charger's thermal foldback is enabled. The plug state is checked under
+ * input_lock, which the unplug handler takes to put the default back, so that
+ * reset always lands after any write that raced with the unplug.
+ */
+static int rk817_chg_set_input_current(struct rk817_charger *charger, int ua)
+{
+	struct regmap *regmap = charger->rk808->regmap;
+	unsigned int i, reg;
+	int sel = -1;
+	int ret;
+
+	ua = min(ua, RK817_INPUT_CUR_MAX_UA);
+	for (i = 0; i < ARRAY_SIZE(rk817_input_cur_ua); i++) {
+		if (rk817_input_cur_ua[i] > ua)
+			continue;
+		if (sel < 0 || rk817_input_cur_ua[i] > rk817_input_cur_ua[sel])
+			sel = i;
+	}
+	if (sel < 0)
+		return -EINVAL;
+
+	guard(mutex)(&charger->input_lock);
+
+	if (rk817_input_cur_ua[sel] >
+	    rk817_input_cur_ua[RK817_INPUT_CUR_DEFAULT_SEL]) {
+		ret = regmap_read(regmap, RK817_PMIC_CHRG_OUT, &reg);
+		if (ret)
+			return ret;
+		if (!(reg & RK817_CHRG_CT_EN) ||
+		    rk817_chg_cur_from_reg(FIELD_GET(RK817_CHRG_CUR_SEL, reg)) >
+		    2000000 || FIELD_GET(RK817_CHRG_VOL_SEL, reg) > 5)
+			return -EOPNOTSUPP;
+	}
+
+	ret = regmap_read(regmap, RK817_SYS_STS, &reg);
+	if (ret)
+		return ret;
+	if (!charger->plugged_in || !(reg & RK817_PLUG_IN_STS))
+		return -ENODEV;
+
+	ret = rk817_chg_write_input(charger, sel);
+	if (ret)
+		rk817_chg_write_default_input(charger);
+
+	return ret;
+}
+
