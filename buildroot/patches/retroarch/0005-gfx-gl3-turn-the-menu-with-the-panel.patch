From: Banana <bananalinux@proton.me>
Date: Tue, 27 Oct 2026 14:10:00 +0000
Subject: [PATCH] gfx/gl3, menu/rgui: turn the menu with the panel on KMS/GBM

On a handheld whose panel is mounted turned in the shell -- the Retroid Pocket
Classic's 1080x1240 in a landscape body -- the game is rotated by video_rotation
but the menu stays in the framebuffer's portrait orientation because everywhere
else the window system owns the output's orientation.  On KMS/GBM there is
nothing above RetroArch, so the menu ends up sideways.

Turn the menu texture at blit time from the user's video_rotation (never from
the core's: a vertical arcade game must not spin the interface).  And compose
RGUI in the landscape shape the user is looking at, because the final blit
fills the window with whatever shape the canvas was composed in -- turning a
portrait canvas by 90 degrees would stretch it by the square of the panel's
aspect, while a landscape canvas turned 1:1 is square.  180 degrees swaps no
axes and is left alone.

Upstream-Status: Pending
---
--- a/gfx/drivers/gl3.c
+++ b/gfx/drivers/gl3.c
@@ -176,6 +176,7 @@
    math_matrix_4x4 mvp_yflip;
    math_matrix_4x4 mvp_no_rot;
    math_matrix_4x4 mvp_no_rot_yflip;
+   math_matrix_4x4 mvp_menu;
 
    uint16_t flags;
 
@@ -442,7 +443,7 @@
    gl3_t *gl3 = (gl3_t*)data;
    if (!gl3)
       return NULL;
-   return &gl3->mvp_no_rot;
+   return &gl3->mvp_menu;
 }
 
 static const float *gfx_display_gl3_get_default_vertices(void)
@@ -974,7 +975,7 @@
       glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_RED);
 
       gl->chain.shader->set_coords(gl->chain.shader_data, coords);
-      gl->chain.shader->set_mvp(gl->chain.shader_data, &gl->mvp_no_rot);
+      gl->chain.shader->set_mvp(gl->chain.shader_data, &gl->mvp_menu);
 
       glDrawArrays(GL_TRIANGLES, 0, coords->vertices);
    }
@@ -1881,6 +1882,32 @@
    return false;
 }
 
+/*
+ * Turn the menu with the *panel*, never with the core.  A rotated panel mounted
+ * in the shell must turn the menu as well, and a game that asks to be rotated
+ * (a vertical arcade board) must not spin the interface with it.  The angle is
+ * the user's video_rotation, and the ortho is the unit square so a quarter turn
+ * exchanges the axes 1:1 -- no stretching, no per-frame copy.
+ */
+static void gl3_set_menu_projection(gl3_t *gl)
+{
+   settings_t *settings   = config_get_ptr();
+   unsigned user_rotation = settings ? (settings->uints.video_rotation % 4) : 0;
+   float radians          = M_PI * (user_rotation * 90u) / 180.0f;
+   float cosine           = cosf(radians);
+   float sine             = sinf(radians);
+   math_matrix_4x4 rot;
+
+   memset(&rot, 0, sizeof(rot));
+   MAT_ELEM_4X4(rot, 0, 0) = cosine;
+   MAT_ELEM_4X4(rot, 0, 1) = -sine;
+   MAT_ELEM_4X4(rot, 1, 0) = sine;
+   MAT_ELEM_4X4(rot, 1, 1) = cosine;
+   MAT_ELEM_4X4(rot, 2, 2) = 1.0f;
+   MAT_ELEM_4X4(rot, 3, 3) = 1.0f;
+   matrix_4x4_multiply(gl->mvp_menu, rot, gl->mvp_no_rot);
+}
+
 static void gl3_set_projection(gl3_t *gl,
       const struct video_ortho *ortho, bool allow_rotate)
 {
@@ -1896,6 +1923,8 @@
    matrix_4x4_ortho(gl->mvp_no_rot, ortho->left, ortho->right,
                     ortho->bottom, ortho->top, ortho->znear, ortho->zfar);
 
+   gl3_set_menu_projection(gl);
+
    if (!allow_rotate)
    {
       gl->mvp = gl->mvp_no_rot;
--- a/menu/drivers/rgui.c
+++ b/menu/drivers/rgui.c
@@ -7658,6 +7658,17 @@
    unsigned video_height               = video_info->height;
    gfx_display_t *p_disp               = disp_get_ptr();
 
+   /* Compose RGUI in the shape the user sees (landscape for a panel turned in
+    * the shell), because gl3_draw_menu_texture turns the final texture and
+    * turning a portrait-composed canvas by 90 degrees would stretch it by the
+    * square of the panel's aspect.  180 degrees swaps no axes. */
+   if ( (settings->uints.video_rotation % 2) == 1)
+   {
+      unsigned swap = video_width;
+      video_width   = video_height;
+      video_height  = swap;
+   }
+
    if (bg_filler_thickness_enable != ((rgui->flags & RGUI_FLAG_BG_THICKNESS) > 0))
    {
       rgui->flags           |=  RGUI_FLAG_BG_MODIFIED
