+                continue;
+            }
+        }
 
         if (connector->connection == DRM_MODE_CONNECTED && connector->count_modes) {
             /* If it's a connected connector with available videomodes, try to add
@@ -984,6 +1003,7 @@
             KMSDRM_drmModeFreeConnector(connector);
