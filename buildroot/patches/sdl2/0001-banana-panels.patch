                                      (float)item->touchscreen_data->range_y;
 
+#ifdef SDL_VIDEO_DRIVER_DUMMY
+                            BP_MapTouch(&norm_x, &norm_y);   /* Banana: onto the bottom panel's part of the window */
+#endif
                             if (item->touchscreen_data->range_pressure > 0) {
