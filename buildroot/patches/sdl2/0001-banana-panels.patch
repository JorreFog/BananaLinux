+++ b/src/video/kmsdrm/SDL_kmsdrmvideo.c	2026-10-12 15:30:37.153585391 +0200
@@ -964,7 +964,13 @@
     }
 
     /* Iterate on the available connectors. For every connected connector,
-       we create an SDL_Display and add it to the list of SDL Displays. */
+       we create an SDL_Display and add it to the list of SDL Displays.
+       Banana: SDL_KMSDRM_FIRST names a connector ("DSI-2", the RG DS's top panel) that becomes display 0, where
