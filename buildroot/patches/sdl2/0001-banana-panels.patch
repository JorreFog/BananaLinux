+++ b/src/video/dummy/SDL_bananapanels.h	2026-10-12 15:07:26.708958934 +0200
@@ -0,0 +1,15 @@
+/*
+  Banana: the dummy video driver's window on both panels of the RG DS (SDL_BANANA_PANELS; SDL_bananapanels.c).
+*/
+#include "../../SDL_internal.h"
+
+#ifndef SDL_bananapanels_h_
+#define SDL_bananapanels_h_
+
+extern int BP_Init(int *w, int *h);          /* 0: on, and the two panels' size together */
+extern int BP_Active(void);
+extern int BP_Present(const void *pixels, int pitch, int w, int h);
+extern void BP_MapTouch(float *x, float *y);
+extern void BP_Quit(void);
+
+#endif /* SDL_bananapanels_h_ */
