From: JorreFog <JorreFog@users.noreply.github.com>
Subject: [PATCH] Banana: the dummy driver's window on both panels; evdev devices found without udev

SDL_BANANA_PANELS=side|stack makes the dummy video driver's display the RG DS's two panels together: each frame of
the window's framebuffer goes straight onto them (raw DRM: two dumb buffers a panel, page flips paced to the
refresh, the panels' own modes kept), and the bottom panel's touchscreen lands on the bottom panel's part of the
window. For apps made for a window over both panels under sway (ROCKNIXDS Bank & Trade), on a system with no
compositor. Without the variable the dummy driver is unchanged (SuperDrastic runs DraStic on it).

And with no libudev, SDL's evdev input found no devices at all (a TODO): /dev/input/event* are scanned and
classed by their capabilities instead.

Upstream-Status: Inappropriate [Banana-specific]
---
diff --color -ruN a/SDL2-2.32.10/src/core/linux/SDL_evdev.c SDL2-2.32.10/src/core/linux/SDL_evdev.c
--- a/src/core/linux/SDL_evdev.c	2025-01-01 16:47:53.000000000 +0100
+++ b/src/core/linux/SDL_evdev.c	2026-10-12 15:18:57.562363391 +0200
@@ -30,6 +30,9 @@
  */
 
 #include "SDL_evdev.h"
+#ifdef SDL_VIDEO_DRIVER_DUMMY
+#include "../../video/dummy/SDL_bananapanels.h"
+#endif
 #include "SDL_evdev_kbd.h"
 
 #include <sys/stat.h>
@@ -207,7 +210,31 @@
                     }
                 }
             } else {
-                /* TODO: Scan the devices manually, like a caveman */
+                /* Banana (no udev daemon): scan the devices manually, like a caveman. Each event device's
+                   capabilities give its class, as udev's would. Not for the plain dummy driver, which reads no
+                   input (SuperDrastic's DraStic: its keyboard must stay as it is). */
+                const char *vd = SDL_GetHint(SDL_HINT_VIDEODRIVER);
+                int i;
+                for (i = 0; i < 64 && !(vd && SDL_strcmp(vd, "dummy") == 0); i++) {
+                    char path[32];
+                    unsigned long ev[NBITS(EV_MAX)], abs[NBITS(ABS_MAX)], key[NBITS(KEY_MAX)], rel[NBITS(REL_MAX)];
+                    int fd, cls;
+                    (void)SDL_snprintf(path, sizeof(path), "/dev/input/event%d", i);
+                    fd = open(path, O_RDONLY | O_CLOEXEC);
+                    if (fd < 0) {
+                        continue;
+                    }
+                    SDL_zeroa(ev); SDL_zeroa(abs); SDL_zeroa(key); SDL_zeroa(rel);
+                    ioctl(fd, EVIOCGBIT(0, sizeof(ev)), ev);
+                    ioctl(fd, EVIOCGBIT(EV_ABS, sizeof(abs)), abs);
+                    ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(key)), key);
+                    ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel)), rel);
+                    close(fd);
+                    cls = SDL_EVDEV_GuessDeviceClass(ev, abs, key, rel);
+                    if (cls & (SDL_UDEV_DEVICE_MOUSE | SDL_UDEV_DEVICE_KEYBOARD | SDL_UDEV_DEVICE_TOUCHSCREEN | SDL_UDEV_DEVICE_TOUCHPAD)) {
+                        SDL_EVDEV_device_added(path, cls);
+                    }
+                }
             }
         }
 #endif /* SDL_USE_LIBUDEV */
