@@ -98,7 +99,7 @@ bool osd_font_sdl::open(std::string const &font_path, std::string const &_name,
 	}
 
 	// if that didn't work, crank up the FontConfig database
-#if !defined(SDLMAME_HAIKU) && !defined(SDLMAME_EMSCRIPTEN)
