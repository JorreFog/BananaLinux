Build without fontconfig, which BananaOS doesn't have: MAME_NO_FONTCONFIG leaves out FcInit/FcFini and the SDL font
provider's fontconfig lookups. The provider stays (SDL_ttf): a font given by file path (-uifont /path/font.ttf) is drawn
sharp at any size, where the built-in bitmap font scaled up came out soft.

diff --git a/src/osd/modules/font/font_sdl.cpp b/src/osd/modules/font/font_sdl.cpp
index 9767f5d3..d676c5dd 100644
--- a/src/osd/modules/font/font_sdl.cpp
+++ b/src/osd/modules/font/font_sdl.cpp
@@ -17,7 +17,8 @@
 
 #include <SDL2/SDL_ttf.h>
 
-#if !defined(SDLMAME_HAIKU) && !defined(SDLMAME_EMSCRIPTEN)
+// Banana: MAME_NO_FONTCONFIG, no fontconfig (BananaOS has none): fonts by file path only (-uifont /path/font.ttf)
+#if !defined(SDLMAME_HAIKU) && !defined(SDLMAME_EMSCRIPTEN) && !defined(MAME_NO_FONTCONFIG)
 #include <fontconfig/fontconfig.h>
 #endif
 
@@ -53,7 +54,7 @@ private:
 
