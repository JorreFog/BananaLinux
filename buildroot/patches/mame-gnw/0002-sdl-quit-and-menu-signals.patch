+// Banana: SIGUSR1 opens or closes MAME's menu (the RG DS's F, tapped on its own: gw-hotkeys sends it), as a press
+// and release of Tab, the menu's key, on the keyboard SDL reports
+static volatile std::sig_atomic_t s_banana_menu_request = 0;
+
+static void banana_menu_signal(int)
+{
+	s_banana_menu_request = 1;
+}
+
+static void banana_menu_key()
+{
+	static bool installed = false;
+	static Uint32 release_at = 0;	// SDL ticks; 0: no key held
+	if (!installed)
+	{
+		installed = true;
+		std::signal(SIGUSR1, banana_menu_signal);
+	}
+	SDL_Event key;
+	SDL_zero(key);
+	key.key.keysym.scancode = SDL_SCANCODE_TAB;
+	key.key.keysym.sym = SDLK_TAB;
+	if (s_banana_menu_request)
+	{
+		s_banana_menu_request = 0;
+		key.type = SDL_KEYDOWN;
+		key.key.state = SDL_PRESSED;
+		SDL_PushEvent(&key);
+		// held for 100 ms (several frames: the UI reads the keys once a frame, and this runs more often than that)
+		release_at = SDL_GetTicks() + 100;
+		if (release_at == 0)
+		{
+			release_at = 1;
+		}
+	}
+	else if (release_at != 0 && SDL_TICKS_PASSED(SDL_GetTicks(), release_at))
+	{
+		release_at = 0;
+		key.type = SDL_KEYUP;
+		key.key.state = SDL_RELEASED;
+		SDL_PushEvent(&key);
+	}
+}
+
 void sdl_osd_interface::process_events()
 {
+	banana_menu_key();
+
 	std::lock_guard<std::mutex> lock(subscription_mutex());
 	SDL_Event event;
 	while (SDL_PollEvent(&event))
@@ -480,6 +528,11 @@ void sdl_osd_interface::process_events()
 		// handle UI events
 		switch (event.type)
 		{
+		case SDL_QUIT:
