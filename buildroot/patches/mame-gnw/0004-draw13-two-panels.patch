+// Banana: SIGUSR2 swaps the window's top and bottom halves (the RG DS's two stacked panels; L2 through gw-hotkeys)
+static volatile std::sig_atomic_t s_banana_swap = 0;
+
+static void banana_swap_signal(int)
+{
+	s_banana_swap = !s_banana_swap;
+}
