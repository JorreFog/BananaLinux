+// the left stick as the d-pad: past half its throw radially, split into eight 45-degree octants (tan 22.5 deg ~
+// 41/100), so a circular gate's diagonals (cos 45 deg ~ 71%, or a stick whose left reach is shorter than its right)
+// never fall short of a per-axis threshold and turn into Up or Down alone
+static uint32_t stick_dpad(int64_t x, int64_t y, int64_t half) {
+    const int64_t t = half / 2;
+    if (x * x + y * y < t * t) return 0;
+    const int64_t ax = std::abs(x), ay = std::abs(y);
+    uint32_t b = 0;
+    if (ax * 100 >= ay * 41) b |= x < 0 ? KeyLeft : KeyRight;
+    if (ay * 100 >= ax * 41) b |= y < 0 ? KeyUp : KeyDown;
+    return b;
+}
 
