-// RetroArch's file for the game: the same name, else the same name without regions (the USA's first, then Europe's)
+// The recognized region tags used in libretro's DS filenames, including combined tags such as (USA, Europe).
+static uint32_t regions(std::string_view name) {
+    static constexpr std::string_view keys[] = {
+        "USA", "Europe", "Japan", "Korea", "Germany", "France", "Spain", "Italy",
+        "Netherlands", "China", "Australia", "Taiwan", "Canada", "Brazil", "World", "Asia", "Russia"
+    };
+    for (size_t start = name.find_first_of("(["); start != name.npos; start = name.find_first_of("([", start)) {
+        if (name[start] == '[') {
+            const size_t end = name.find(']', start + 1);
+            if (end == name.npos) break;
+            start = end + 1;
+            continue;
+        }
+        size_t end = name.find(')', ++start);
+        if (end == name.npos) break;
+        auto tag = name.substr(start, end - start);
+        uint32_t mask = 0;
+        while (!tag.empty()) {
+            size_t comma = tag.find(',');
+            auto key = tag.substr(0, comma);
+            key = key.substr(0, key.find_last_not_of(' ') + 1);
+            const auto found = std::find(std::begin(keys), std::end(keys), key);
+            if (found == std::end(keys)) {
+                mask = 0;
+                break;
+            }
+            mask |= uint32_t{1} << (found - std::begin(keys));
+            if (comma == tag.npos) break;
+            tag.remove_prefix(comma + 1);
+            tag.remove_prefix(std::min(tag.find_first_not_of(' '), tag.size()));
+            if (tag.empty()) mask = 0;
+        }
+        if (mask) return mask;
+        start = end + 1;
+    }
+    return 0;
+}
