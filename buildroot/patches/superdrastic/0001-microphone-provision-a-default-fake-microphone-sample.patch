diff --git a/src/audio.c b/src/audio.c
index 28ee877..ed8bedd 100644
--- a/src/audio.c
+++ b/src/audio.c
@@ -606,8 +606,54 @@ int audio_mic_meter(float *level, float *floor_, float *thresh) {
     return mic_state;
 }
 void audio_mic_quiet(int on) { mic_quiet = on; }
+
+/* DraStic's "fake microphone" is not the real capture: it plays a WAV it reads once at the game's start, looking for
+ * <dir>/microphone/<game>.wav and then <dir>/microphone/microphone.wav under its working directory. With no file at
+ * all spu_fake_microphone_start() still sets the active flag, but spu_get_microphone_sample() has no data pointer and
+ * returns `rand() & 0x1fff`, which the DS's TSC AUX conversion (sxth; add #0x8000; asr #4) turns into 0x800..0x9FF -
+ * the DS's silence. Every other part of the chain is right, so a mic key press reaches the game as nothing. Provision
+ * a default blow: a 16-bit mono PCM RIFF/WAVE the loader accepts (fmt: PCM, 1 channel, 16 bits, 44.1 kHz). Written
+ * beside DraStic only when the card has no sample of its own, so a user's microphone/<game>.wav is left alone. */
+void audio_mic_sample_ensure(void);
+void audio_mic_sample_ensure(void) {
+    struct stat st;
+    if (stat("microphone/microphone.wav", &st) == 0) return;   /* the card's own sample stays */
+    mkdir("microphone", 0755);
+    const int rate = 44100, secs = 2;
+    long n = (long)rate * secs;
+    int16_t *pcm = malloc((size_t)n * sizeof *pcm);
+    if (!pcm) return;
+    uint32_t s = 0x2545f491u; double lp = 0, lp2 = 0;
+    for (long i = 0; i < n; i++) {
+        s ^= s << 13; s ^= s >> 17; s ^= s << 5;                       /* xorshift: white noise */
+        double w = (int32_t)s / 2147483648.0;
+        lp  += 0.35 * (w - lp);                                        /* a blow: noise low-passed twice (wind) */
+        lp2 += 0.35 * (lp - lp2);
+        double env = 1.0;
+        if (i < rate / 20) env = (double)i / (rate / 20);              /* 50 ms in */
+        if (i > n - rate / 10) env = (double)(n - i) / (rate / 10);    /* 100 ms out */
+        pcm[i] = (int16_t)(lp2 * env * 20000.0);
+    }
+    FILE *f = fopen("microphone/microphone.wav", "wb");
+    if (f) {
+        uint32_t dlen = (uint32_t)(n * 2), riff = dlen + 36, brate = (uint32_t)rate * 2, fsz = 16;
+        uint16_t one = 1, bits = 16, block = 2;
+        fwrite("RIFF", 1, 4, f); fwrite(&riff, 4, 1, f); fwrite("WAVE", 1, 4, f);
+        fwrite("fmt ", 1, 4, f); fwrite(&fsz, 4, 1, f); fwrite(&one, 2, 1, f); fwrite(&one, 2, 1, f);
+        fwrite(&rate, 4, 1, f); fwrite(&brate, 4, 1, f); fwrite(&block, 2, 1, f); fwrite(&bits, 2, 1, f);
+        fwrite("data", 1, 4, f); fwrite(&dlen, 4, 1, f);
+        size_t w = fwrite(pcm, sizeof *pcm, (size_t)n, f);
+        fclose(f);
+        dsflip_log("[mic] no fake-microphone sample on the card: wrote microphone/microphone.wav (%ld ms, %zu/%ld samples)%s\n",
+                   (long)secs * 1000, w, n, w == (size_t)n ? "" : " (short write)");
+    } else {
+        dsflip_log("[mic] no fake-microphone sample and can't write microphone/microphone.wav: DraStic plays silence\n");
+    }
+    free(pcm);
+}
 /* called once DraStic's audio is open (SDL_OpenAudio returned), so the output is set up before the mic is */
 void audio_mic_start(void) {
+    audio_mic_sample_ensure();      /* the in-game menu's Blow presses the fake mic too, so this is not gated on thresh */
     const char *t = getenv("DSHOOK_MIC_THRESH");
     static float thresh;
     thresh = t ? (float)strtod(t, 0) : 0;
