config BR2_PACKAGE_MESA3D_PANFROST
	bool "mesa3d-panfrost"
	depends on !BR2_PACKAGE_MESA3D
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_SYNC_1
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_FORMAT_MODIFIER_PLANE_COUNT
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_DMA_BUF
	help
	  Mesa with the Panfrost driver alone (the RK3566's Mali-G52), EGL on DRM, OpenGL ES and GBM: the GPU for
	  SuperDrastic's shaders and RetroArch. Mesa 25.0 is the last release whose Panfrost needs no LLVM and no
	  OpenCL C compiler, which Buildroot's mesa3d would build for the host and put on the target.

if BR2_PACKAGE_MESA3D_PANFROST

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mesa3d-panfrost"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mesa3d-panfrost"

config BR2_PACKAGE_PROVIDES_LIBGBM
	default "mesa3d-panfrost"

endif
