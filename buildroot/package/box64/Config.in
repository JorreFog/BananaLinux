config BR2_PACKAGE_BOX64
	bool "box64"
	depends on BR2_aarch64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	select BR2_PACKAGE_NCURSES # libtinfo.so.6 for box64-bash
	help
	  Runs x86_64 Linux programs on ARM64 with a dynamic
	  recompiler, handing their calls into system libraries
	  (Vulkan, Wayland, ALSA, SDL) to the ARM64 ones. BananaOS's
	  PC games on the AYN Thor: Wine's x86_64 build runs under it
	  (usr/libexec/banana/pc-games), with its 32-bit side (Box32)
	  for Windows programs that are 32-bit.

	  https://github.com/ptitSeb/box64
