+/// the RG DS Plus's pad (the rocknix-singleadc-joypad driver, vendor 484b) as
+/// the R36S numbers it. its face buttons are the standard gamepad numbers
+/// (A BTN_EAST 305 and B BTN_SOUTH 304 match the R36S's own, so they are left
+/// alone), but X, Y, the shoulders and the triggers are not where the R36S
+/// keeps them, and select, start, F and the sticks' buttons are the usual
+/// 314 to 318.
+fn rkds_button(code: u16) -> u16 {
+    match code {
+        306 => X,      // BTN_NORTH
+        307 => Y,      // BTN_WEST
+        308 => L1,     // BTN_TL
+        309 => R1,     // BTN_TR
+        310 => L2,     // BTN_TL2
+        311 => R2,     // BTN_TR2
+        314 => SELECT, // BTN_SELECT
+        315 => START,  // BTN_START
+        316 => FN,     // BTN_MODE
+        317 => L3,     // BTN_THUMBL
+        318 => R3,     // BTN_THUMBR
+        other => other, // B (304), A (305) and the d-pad (544-547) already fit
+    }
+}
