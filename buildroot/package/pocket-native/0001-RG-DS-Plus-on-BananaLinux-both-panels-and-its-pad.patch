+/// the DSI interface number of the top panel, from banana-ui's BANANA_TOP
+/// (DSI-2 on the RG DS Plus), defaulting to 2.
+fn top_connector_id() -> u32 {
+    let name = std::env::var("BANANA_TOP").unwrap_or_else(|_| "DSI-2".to_owned());
+    name.rsplit(|c: char| !c.is_ascii_digit()).next().and_then(|digits| digits.parse().ok()).unwrap_or(2)
+}
