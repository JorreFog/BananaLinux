From 2c04d2671d1834443f0449179ded13a36d71002c Mon Sep 17 00:00:00 2001
From: opencode <opencode@localhost>
Date: Mon, 26 Oct 2026 12:58:20 -0400
Subject: [PATCH 2/7] only let go of a panel's buffer when its flip was queued

settle released whichever buffer was shown even when a panel had no flip
pending, which is the buffer the display is reading: freeing it there
would leave the CRTC scanning memory the allocator has taken back. Only
release a panel that actually queued a flip.
---
 engine/gpu/src/raster/gles.rs | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/engine/gpu/src/raster/gles.rs b/engine/gpu/src/raster/gles.rs
index 4923897..f70cc23 100644
--- a/engine/gpu/src/raster/gles.rs
+++ b/engine/gpu/src/raster/gles.rs
@@ -1392,9 +1392,14 @@ impl Kms {
                     self.held_since = std::time::Instant::now();
                 }
             }
-            self.primary.release(&self.drm, &self.gbm, self.fd, primary)?;
+            // only a panel whose flip was queued has an old buffer to let go
+            // of: without one, shown is what the display is reading and must
+            // be left alone
+            if let Some(pending) = primary {
+                self.primary.release(&self.drm, &self.gbm, self.fd, pending)?;
+            }
             if let (Some(panel), Some(pending)) = (self.second.as_mut(), second) {
-                panel.release(&self.drm, &self.gbm, self.fd, Some(pending))?;
+                panel.release(&self.drm, &self.gbm, self.fd, pending)?;
             }
         }
         Ok(())
@@ -1483,8 +1488,8 @@ impl KmsPanel {
 
     /// lets go of the buffer a flip replaced once it has happened, keeping
     /// the one the flip put up.
-    unsafe fn release(&mut self, drm: &libloading::Library, gbm: &libloading::Library, fd: i32, pending: Option<(*mut c_void, u32)>) -> Result<(), String> {
-        if let Some((bo, fb)) = std::mem::replace(&mut self.shown, pending) {
+    unsafe fn release(&mut self, drm: &libloading::Library, gbm: &libloading::Library, fd: i32, pending: (*mut c_void, u32)) -> Result<(), String> {
+        if let Some((bo, fb)) = std::mem::replace(&mut self.shown, Some(pending)) {
             call!(drm, "drmModeRmFB", fn(i32, u32) -> i32, fd, fb);
             call!(gbm, "gbm_surface_release_buffer", fn(*mut c_void, *mut c_void) -> (), self.surface, bo);
         }
