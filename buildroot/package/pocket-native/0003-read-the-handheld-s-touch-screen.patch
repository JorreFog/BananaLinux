+++ b/frontend/src/lib.rs
@@ -176,6 +176,14 @@ pub fn run(mut args: Vec<String>) {
                 Some((device, name)) => input::read_pad(device, name, pad.clone()),
                 None => log::warn!("no gamepad found"),
             }
+            // a handheld with a touch screen touches the bottom screen where
+            // a finger is, instead of moving the cursor with the right stick
+            if probe.is_none() {
+                match input::touchscreen() {
+                    Some((device, name)) => input::read_touch(device, name, pad.clone()),
+                    None => log::warn!("no touch screen found"),
