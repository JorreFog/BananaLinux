From 52e7006ea807930902144db1f85c51e0edb0637e Mon Sep 17 00:00:00 2001
From: opencode <opencode@localhost>
Date: Mon, 26 Oct 2026 13:54:04 -0400
Subject: [PATCH 3/7] read the handheld's touch screen

The Pad has had fingers and a second-window touch since the Android port,
but nothing on Linux ever filled them, so a handheld with a real touch
panel (the RG DS Plus, its bottom screen) could only touch with the right
stick and R2. Read the panel: the evdev whose sysfs path banana-ui's
BANANA_TOUCH names, or the first whose name says touch, a finger's place
leaving as the second window's screen's, across and down from 0 to 1,
which is the bottom screen's touch when it is alone on that window.
---
 frontend/src/input.rs | 75 +++++++++++++++++++++++++++++++++++++++++++
 frontend/src/lib.rs   |  8 +++++
 2 files changed, 83 insertions(+)

diff --git a/frontend/src/input.rs b/frontend/src/input.rs
index 3529bad..4518962 100644
--- a/frontend/src/input.rs
+++ b/frontend/src/input.rs
@@ -44,6 +44,16 @@ const BUTTONS: [(u16, PadState); 12] = [
 /// a stick's travel, the most it reports.
 pub const STICK: f32 = 1800.0;
 
+// evdev's numbers for the touch screen's events.
+const EV_SYN: u16 = 0;
+const EV_KEY: u16 = 1;
+const EV_ABS: u16 = 3;
+const SYN_REPORT: u16 = 0;
+const BTN_TOUCH: u16 = 0x14a;
+const ABS_MT_POSITION_X: u16 = 0x35;
+const ABS_MT_POSITION_Y: u16 = 0x36;
+const ABS_MT_TRACKING_ID: u16 = 0x39;
+
 #[derive(Default)]
 pub struct Pad {
     pub keys: HashSet<u16>,
@@ -231,6 +241,71 @@ pub fn read_pad(path: String, name: String, pad: Arc<Mutex<Pad>>) {
     });
 }
 
+/// the bottom panel's touch screen: the evdev whose sysfs path names it, as
+/// banana-ui's BANANA_TOUCH does (fe5e0000.i2c on the RG DS Plus), or else
+/// the first device whose name says touch. The top panel has one too, which
+/// the 3DS does not use.
+pub fn touchscreen() -> Option<(String, String)> {
+    let devices = std::fs::read_to_string("/proc/bus/input/devices").ok()?;
+    let wanted = std::env::var("BANANA_TOUCH").unwrap_or_else(|_| "fe5e0000.i2c".to_owned());
+    let mut fallback = None;
+    for block in devices.split("\n\n") {
+        let Some(name) = block.lines().find_map(|line| line.strip_prefix("N: Name=")).map(|name| name.trim_matches('"').to_owned()) else { continue };
+        let Some(handlers) = block.lines().find_map(|line| line.strip_prefix("H: Handlers=")) else { continue };
+        let Some(event) = handlers.split_whitespace().find(|handler| handler.starts_with("event")) else { continue };
+        let found = (format!("/dev/input/{event}"), name);
+        if block.lines().any(|line| line.starts_with("S: Sysfs=") && line.contains(&wanted)) {
+            return Some(found);
+        }
+        if found.1.to_lowercase().contains("touch") && fallback.is_none() {
+            fallback = Some(found);
+        }
+    }
+    fallback
+}
+
+/// reads the touch screen. A finger's place leaves as the second window's
+/// screen's, across and down from 0 to 1, which the frontend turns into the
+/// 3DS's touch on the bottom screen. Multitouch protocol B, and the older
+/// single-touch reports, both land here; a second finger is taken as the
+/// first, which is all the 3DS has.
+pub fn read_touch(path: String, name: String, pad: Arc<Mutex<Pad>>) {
+    log::info!("touch from {name}");
+    std::thread::spawn(move || {
+        let Ok(mut device) = std::fs::File::open(&path) else {
+            log::error!("could not open {path}");
+            return;
+        };
+        let x_range = axis_range(&device, ABS_MT_POSITION_X as usize).unwrap_or((0, 1023));
+        let y_range = axis_range(&device, ABS_MT_POSITION_Y as usize).unwrap_or((0, 767));
+        let (mut x, mut y) = (0, 0);
+        let mut down = false;
+        let mut event = [0u8; 24];
+        while device.read_exact(&mut event).is_ok() {
+            let kind = u16::from_ne_bytes([event[16], event[17]]);
+            let code = u16::from_ne_bytes([event[18], event[19]]);
+            let value = i32::from_ne_bytes([event[20], event[21], event[22], event[23]]);
+            match (kind, code) {
+                (EV_ABS, ABS_MT_POSITION_X) => x = value,
+                (EV_ABS, ABS_MT_POSITION_Y) => y = value,
+                (EV_ABS, ABS_MT_TRACKING_ID) => down = value >= 0,
+                (EV_KEY, BTN_TOUCH) => down = value != 0,
+                // a report ends: the finger's place is where the last report
+                // put it, and none means it is off the screen
+                (EV_SYN, SYN_REPORT) => {
+                    let place = down.then(|| {
+                        let across = (x - x_range.0) as f32 / (x_range.1 - x_range.0).max(1) as f32;
+                        let down = (y - y_range.0) as f32 / (y_range.1 - y_range.0).max(1) as f32;
+                        (across.clamp(0.0, 1.0), down.clamp(0.0, 1.0))
+                    });
+                    pad.lock().unwrap().second_touch = place;
+                }
+                _ => {}
+            }
+        }
+    });
+}
+
 /// an H700 handheld's button as the R36S numbers it.
 fn h700_button(code: u16) -> u16 {
     match code {
