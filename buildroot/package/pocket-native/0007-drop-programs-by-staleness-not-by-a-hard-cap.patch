From d73f855586d68c7110e47f0bf81220ecfb907cf9 Mon Sep 17 00:00:00 2001
From: opencode <opencode@localhost>
Date: Mon, 26 Oct 2026 15:26:22 -0400
Subject: [PATCH 7/7] drop programs by staleness, not by a hard cap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The program cache is what fills a 1 GB device: the prewarm puts 347 of
them up at startup and each costs the driver on the order of a megabyte.
A hard cap churned — it dropped programs the level was still using only
to compile them again — so drop by age instead: a program not used for
3000 batches goes, which frees the prewarmed and earlier-level ones
without touching the level being played.
---
 engine/gpu/src/raster/gles.rs | 56 +++++++++++++++++------------------
 1 file changed, 28 insertions(+), 28 deletions(-)

diff --git a/engine/gpu/src/raster/gles.rs b/engine/gpu/src/raster/gles.rs
index 7e8eda3..575216d 100644
--- a/engine/gpu/src/raster/gles.rs
+++ b/engine/gpu/src/raster/gles.rs
@@ -273,10 +273,14 @@ const EQUATIONS: [u32; 5] = [glow::FUNC_ADD, glow::FUNC_SUBTRACT, glow::FUNC_REV
 /// batches a second this is a few seconds' worth.
 const TEXTURE_KEEP_FLUSHES: u64 = 200;
 
-/// how many compiled programs stay cached. Past this the least recently used
-/// go, so a title that makes new ones all through a level cannot grow the
-/// driver's memory without bound.
-const PROGRAM_CACHE_MAX: usize = 320;
+/// how many batches a compiled program stays cached after its last use. Each
+/// one costs the driver on the order of a megabyte, and a title makes new
+/// ones all through a level, so this is what keeps a few hundred of them from
+/// becoming hundreds of megabytes on a 1 GB handheld. Long enough that a
+/// level's own programs are never dropped under it (which would only make it
+/// compile them again), short enough that the ones prewarmed or a level ago
+/// and no longer used go.
+const PROGRAM_KEEP_FLUSHES: u64 = 3000;
 
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 enum Kind {
@@ -5283,31 +5287,27 @@ impl Gles {
             });
         }
         // a program costs the driver far more than a texture, and the map is
-        // otherwise never emptied: a level's worth is fine, thousands of them
-        // are hundreds of megabytes on a handheld. Keep the most recently
-        // used; one that comes back is compiled again, the driver's own cache
-        // making that quick.
-        if self.programs.len() > PROGRAM_CACHE_MAX {
-            let mut by_age: Vec<(ProgramKey, u64)> = self.programs.iter().map(|(key, made)| (key.clone(), made.used)).collect();
-            by_age.sort_unstable_by_key(|(_, used)| *used);
-            let dropping = by_age.len() - PROGRAM_CACHE_MAX;
-            let mut gone = Vec::with_capacity(dropping);
-            for (key, _) in by_age.into_iter().take(dropping) {
-                if let Some(made) = self.programs.remove(&key) {
-                    gone.push(made.program);
-                }
-            }
-            if !gone.is_empty() {
-                let gl = self.gl;
-                log::debug!("dropped {} programs, {} left", gone.len(), self.programs.len());
-                self.worker.post_keeping(move || {
-                    disturb();
-                    for program in gone {
-                        // SAFETY: on the GL thread, after every draw that used it
-                        unsafe { gl.delete_program(program) };
-                    }
-                });
+        // otherwise never emptied: one not used for a long while is dropped,
+        // which frees what the prewarm and earlier levels left without
+        // touching the level being played.
+        let mut gone = Vec::new();
+        self.programs.retain(|_, made| {
+            let keep = flushes - made.used < PROGRAM_KEEP_FLUSHES;
+            if !keep {
+                gone.push(made.program);
             }
+            keep
+        });
+        if !gone.is_empty() {
+            let gl = self.gl;
+            log::debug!("dropped {} programs, {} left", gone.len(), self.programs.len());
+            self.worker.post_keeping(move || {
+                disturb();
+                for program in gone {
+                    // SAFETY: on the GL thread, after every draw that used it
+                    unsafe { gl.delete_program(program) };
+                }
+            });
         }
     }
 
