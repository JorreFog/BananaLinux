From 0d27e0919c3835c848661857f662711ff45304e6 Mon Sep 17 00:00:00 2001
From: opencode <opencode@localhost>
Date: Mon, 26 Oct 2026 15:04:52 -0400
Subject: [PATCH 4/7] keep decoded textures cached for a shorter window
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Each cached entry also pins the CPU-side texels it was made from — the
key is that allocation's address, so the Arc has to live as long as the
entry — which on a 1 GB handheld is a lot of host RAM with a 600-batch
window. 200 keeps a few seconds of them instead.
---
 engine/gpu/src/raster/gles.rs | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/engine/gpu/src/raster/gles.rs b/engine/gpu/src/raster/gles.rs
index f70cc23..00a8a6d 100644
--- a/engine/gpu/src/raster/gles.rs
+++ b/engine/gpu/src/raster/gles.rs
@@ -266,7 +266,12 @@ const FACTORS: [u32; 15] = [
 ];
 const EQUATIONS: [u32; 5] = [glow::FUNC_ADD, glow::FUNC_SUBTRACT, glow::FUNC_REVERSE_SUBTRACT, glow::MIN, glow::MAX];
 
-const TEXTURE_KEEP_FLUSHES: u64 = 600;
+/// how many batches a decoded texture stays cached after its last use. Each
+/// entry also pins the CPU-side texels it was made from (the key is that
+/// allocation's address, so the Arc has to live as long as the entry), so on
+/// a handheld short of memory a long window is a lot of host RAM: at 60
+/// batches a second this is a few seconds' worth.
+const TEXTURE_KEEP_FLUSHES: u64 = 200;
 
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 enum Kind {
