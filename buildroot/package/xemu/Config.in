config BR2_PACKAGE_XEMU
	bool "xemu"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_USE_MMU # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBGBM && BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_HAS_LIBGL # links -lGL, draws with desktop OpenGL (a 4.0 core context)
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_PIXMAN
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_LIBEPOXY
	select BR2_PACKAGE_LIBSAMPLERATE
	select BR2_PACKAGE_LIBPCAP
	select BR2_PACKAGE_SLIRP
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_VULKAN_HEADERS
	select BR2_PACKAGE_VULKAN_LOADER
	help
	  xemu, the original Xbox emulator (SDL 3, Vulkan, on Wayland).
	  The Xbox BIOS, EEPROM and hard disk image come from the
	  user. Launcher: /usr/libexec/banana/run-xemu. Needs desktop
	  OpenGL beside Vulkan, which a GLES-only image (the AYN
	  Thor's) doesn't have.

	  https://xemu.app
