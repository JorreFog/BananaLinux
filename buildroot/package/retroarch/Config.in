config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES && BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_LIBUDEV_ZERO
	help
	  RetroArch, for the systems other than the DS: on one panel through KMS and GLES (no compositor), ALSA,
	  udev input (libudev-zero), and its RGUI menu, whose pixel look fits the menu's.

if BR2_PACKAGE_RETROARCH
source "$BR2_EXTERNAL_BANANA_PATH/package/retroarch/cores.in"
endif
