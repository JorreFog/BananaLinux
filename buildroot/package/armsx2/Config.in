config BR2_PACKAGE_ARMSX2
	bool "armsx2"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_13 # C++20
	depends on BR2_PACKAGE_HAS_LIBGBM && BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_ZSTD
	select BR2_PACKAGE_LZ4
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_PLUTOSVG
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBPCAP
	select BR2_PACKAGE_SHADERC
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_EXTRA_CMAKE_MODULES
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_VULKAN_HEADERS
	help
	  ARMSX2, the PlayStation 2 emulator with ARM64 recompilers
	  (a PCSX2 fork), with its SDL 3 front end (no Qt).
	  Launcher: /usr/libexec/banana/run-armsx2.

	  https://github.com/ARMSX2/ARMSX2
