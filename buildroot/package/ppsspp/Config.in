config BR2_PACKAGE_PPSSPP
	bool "ppsspp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_13 # C++20
	depends on BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_WAYLAND
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_VULKAN_HEADERS
	select BR2_PACKAGE_WAYLAND
	help
	  PPSSPP, the PSP emulator (SDL 2 on Wayland, Vulkan), at
	  ROCKNIX's SM8550 commit and patches. Launcher:
	  /usr/libexec/banana/run-ppsspp.

	  https://www.ppsspp.org
