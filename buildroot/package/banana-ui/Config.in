config BR2_PACKAGE_BANANA_UI
	bool "banana-ui"
	depends on BR2_aarch64 # sevenzip
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ZLIB
	# banana-fetch, Files' servers: FTP and FTPS (libcurl with OpenSSL: the server's certificate pinned in OpenSSL's
	# own check), SFTP (libssh2), SMB (libsmb2), passwords sealed (OpenSSL), 7z and RAR (7zz)
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_FORCE_TLS
	select BR2_PACKAGE_LIBSSH2
	select BR2_PACKAGE_LIBSMB2
	select BR2_PACKAGE_SEVENZIP
	help
	  Banana's frontend: ROCKNIXDS Pixel's engine drawn in software straight onto both panels, and its helpers
	  (banana-fetch: Files' file servers, archives unpacked).
