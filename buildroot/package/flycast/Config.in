config BR2_PACKAGE_FLYCAST
	bool "flycast"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_13 # C++20
	depends on BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_WAYLAND
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBMINIUPNPC
	select BR2_PACKAGE_LUA
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_VULKAN_HEADERS
	help
	  Flycast, the Dreamcast, Naomi and Atomiswave emulator
	  (standalone, SDL 2 on Wayland, Vulkan). Launcher:
	  /usr/libexec/banana/run-flycast.

	  https://github.com/flyinghead/flycast
