+					const u16 texel = read16(t + i * 2);
+					return rgba(
+						convert5To8Bit(getBits<11, 5, u8>(texel)), convert5To8Bit(getBits<6, 5, u8>(texel)), convert5To8Bit(getBits<1, 5, u8>(texel)),
+						getBit<0>(texel) ? 0xff : 0
+					);
+				});
+				break;
+			case PICA::TextureFmt::RGB565:
+				decodeTiles<128>(width, height, src, out, [](const u8* t, u32 i) {
+					const u16 texel = read16(t + i * 2);
+					return rgba(
+						convert5To8Bit(getBits<11, 5, u8>(texel)), convert6To8Bit(getBits<5, 6, u8>(texel)), convert5To8Bit(getBits<0, 5, u8>(texel)), 0xff
+					);
+				});
+				break;
+			case PICA::TextureFmt::RGBA4:
+				decodeTiles<128>(width, height, src, out, [](const u8* t, u32 i) {
+					const u16 texel = read16(t + i * 2);
+					return rgba(
+						convert4To8Bit(getBits<12, 4, u8>(texel)), convert4To8Bit(getBits<8, 4, u8>(texel)), convert4To8Bit(getBits<4, 4, u8>(texel)),
+						convert4To8Bit(getBits<0, 4, u8>(texel))
+					);
+				});
+				break;
+			case PICA::TextureFmt::IA8:
+				decodeTiles<128>(width, height, src, out, [](const u8* t, u32 i) {
+					const u8 intensity = t[i * 2 + 1];
+					return rgba(intensity, intensity, intensity, t[i * 2]);
+				});
+				break;
+			case PICA::TextureFmt::RG8:
+				decodeTiles<128>(width, height, src, out, [](const u8* t, u32 i) { return rgba(t[i * 2 + 1], t[i * 2], 0, 0xff); });
+				break;
+			case PICA::TextureFmt::I8:
+				decodeTiles<64>(width, height, src, out, [](const u8* t, u32 i) { return rgba(t[i], t[i], t[i], 0xff); });
+				break;
+			case PICA::TextureFmt::A8:
+				decodeTiles<64>(width, height, src, out, [](const u8* t, u32 i) { return rgba(0, 0, 0, t[i]); });
+				break;
+			case PICA::TextureFmt::IA4:
+				decodeTiles<64>(width, height, src, out, [](const u8* t, u32 i) {
+					const u8 intensity = convert4To8Bit(t[i] >> 4);
+					return rgba(intensity, intensity, intensity, convert4To8Bit(t[i] & 0xf));
+				});
+				break;
+			case PICA::TextureFmt::I4:
+				decodeTiles<32>(width, height, src, out, [](const u8* t, u32 i) {
+					const u8 intensity = convert4To8Bit((t[i / 2] >> ((i & 1) * 4)) & 0xf);
+					return rgba(intensity, intensity, intensity, 0xff);
+				});
+				break;
+			case PICA::TextureFmt::A4:
+				decodeTiles<32>(width, height, src, out, [](const u8* t, u32 i) { return rgba(0, 0, 0, convert4To8Bit((t[i / 2] >> ((i & 1) * 4)) & 0xf)); });
+				break;
+			case PICA::TextureFmt::ETC1: ::decodeETC<false>(width, height, src, out); break;
+			case PICA::TextureFmt::ETC1A4: ::decodeETC<true>(width, height, src, out); break;
+			default: Helpers::panic("[Texture::decodeTexture] Unimplemented format = %d", static_cast<int>(format));
+		}
+	}
 }
