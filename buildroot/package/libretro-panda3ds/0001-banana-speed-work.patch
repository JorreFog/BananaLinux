+// PICA procedural texture (texture unit 3), following Citra's software implementation (video_core/rasterizer proctex):
+// noise, shift, clamp, the U/V combiner mapped through the RGB/alpha map LUTs, then the colour LUT. No proctex mipmaps
+// (level 0 only), like Citra's software renderer. The LUTs are rows of u_tex_luts after the lighting and fog rows:
+// 25 noise, 26 RGB map, 27 alpha map (value, difference), 28/29 colour (rg, ba), 30/31 colour difference (rg, ba).
+void FragmentGenerator::compileProcTexFunctions(std::string& shader, const PICA::FragmentConfig& config) {
+	const auto& pt = config.procTex;
+
+	if (api == API::GLES) {
+		// Noise hashes integers and the coordinates can be large: mediump is not enough
+		shader += "\nprecision highp float;\nprecision highp int;\n";
+	}
+
+	shader += R"(
+		float ptLookupLUT(int row, float coord) {
+			coord *= 128.0;
+			int i = clamp(int(coord), 0, 127);
+			vec2 e = texelFetch(u_tex_luts, ivec2(i, row), 0).rg;
+			return e.r + (coord - float(i)) * e.g;
+		}
+
+		float ptClamp(float coord, int mode) {
+			if (mode == 0) return coord > 1.0 ? 0.0 : coord;                    // to zero
+			if (mode == 1) return min(coord, 1.0);                               // to edge
+			if (mode == 2) return fract(coord);                                  // symmetrical repeat
+			if (mode == 3) {                                                     // mirrored repeat
+				int integer = int(coord);
+				float frac = coord - float(integer);
+				return (integer % 2) == 0 ? frac : 1.0 - frac;
+			}
+			return coord <= 0.5 ? 0.0 : 1.0;                                     // pulse
+		}
+
+		float ptShift(float v, int mode, int clampMode) {
+			float offset = clampMode == 3 ? 1.0 : 0.5;
+			if (mode == 1) return offset * float((int(v) / 2) % 2);
+			if (mode == 2) return offset * float(((int(v) + 1) / 2) % 2);
+			return 0.0;
+		}
+	)";
+
+	if (pt.noiseEnable) {
+		shader += R"(
+		int ptRand1D(int v) {
+			const int table[16] = int[16](0, 4, 10, 8, 4, 9, 7, 12, 5, 15, 13, 14, 11, 15, 2, 11);
+			return (((v % 9 + 2) * 3) & 0xF) ^ table[(v / 9) & 0xF];
+		}
+
+		float ptRand2D(int x, int y) {
+			const int table[16] = int[16](10, 2, 15, 8, 0, 7, 4, 5, 5, 13, 2, 6, 13, 9, 3, 14);
+			int u2 = ptRand1D(x);
+			int v2 = ptRand1D(y);
+			v2 += ((u2 & 3) == 1) ? 4 : 0;
+			v2 ^= (u2 & 1) * 6;
