+
+void Texture::decodeToRGBA8(std::span<const u8> data, u32* out) {
+	const u32 width = size.u(), height = size.v();
+	const u8* src = data.data();
+	using Colour::convert4To8Bit, Colour::convert5To8Bit, Colour::convert6To8Bit;
+
+	if ((width % 8) != 0 || (height % 8) != 0 || Banana::baseline()) [[unlikely]] {
+		// Not whole tiles (the PICA's textures always are): texel by texel
+		for (u32 v = 0; v < height; v++) {
+			for (u32 u = 0; u < width; u++) {
+				out[v * width + u] = decodeTexel(u, v, format, data);
+			}
+		}
+	} else {
+		switch (format) {
+			case PICA::TextureFmt::RGBA8:
