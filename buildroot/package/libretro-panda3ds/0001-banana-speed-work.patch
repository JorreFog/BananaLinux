+					const u8* p = t + i * 4;
+					return rgba(p[3], p[2], p[1], p[0]);
+				});
+				break;
+			case PICA::TextureFmt::RGB8:
+				decodeTiles<192>(width, height, src, out, [](const u8* t, u32 i) {
+					const u8* p = t + i * 3;
+					return rgba(p[2], p[1], p[0], 0xff);
+				});
+				break;
+			case PICA::TextureFmt::RGBA5551:
