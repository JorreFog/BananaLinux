+++ b/tests/banana/texture_decode_test.cpp
@@ -0,0 +1,38 @@
+// The tiled texture decoder (Texture::decodeToRGBA8) against the texel-by-texel one (Texture::decodeTexel), every
+// format, random data and real-looking sizes. Built with BUILD_BENCH: build/texture-decode-test
+#include <cstdio>
+#include <random>
+#include <vector>
+
+#include "renderer_gl/textures.hpp"
+
+int main() {
+	std::mt19937 rng(1234);
+	int failures = 0;
+	const PICA::TextureFmt formats[] = {
+		PICA::TextureFmt::RGBA8, PICA::TextureFmt::RGB8, PICA::TextureFmt::RGBA5551, PICA::TextureFmt::RGB565, PICA::TextureFmt::RGBA4,
+		PICA::TextureFmt::IA8,   PICA::TextureFmt::RG8,  PICA::TextureFmt::I8,       PICA::TextureFmt::A8,     PICA::TextureFmt::IA4,
+		PICA::TextureFmt::I4,    PICA::TextureFmt::A4,   PICA::TextureFmt::ETC1,     PICA::TextureFmt::ETC1A4,
+	};
+	const u32 sizes[][2] = {{8, 8}, {16, 8}, {64, 32}, {128, 128}, {256, 64}, {32, 512}};
+	for (auto fmt : formats) {
+		for (auto& sz : sizes) {
+			Texture tex(0, fmt, sz[0], sz[1], 0);
+			std::vector<u8> data(tex.sizeInBytes());
+			for (auto& b : data) b = u8(rng());
+			std::vector<u32> fast(sz[0] * sz[1]);
+			tex.decodeToRGBA8(data, fast.data());
+			for (u32 v = 0; v < sz[1]; v++) {
+				for (u32 u = 0; u < sz[0]; u++) {
+					const u32 slow = tex.decodeTexel(u, v, fmt, data);
+					if (slow != fast[v * sz[0] + u]) {
+						if (failures++ < 10)
+							std::printf("%s %ux%u (%u, %u): %08X != %08X\n", PICA::textureFormatToString(fmt), sz[0], sz[1], u, v, fast[v * sz[0] + u], slow);
+					}
+				}
+			}
+		}
+	}
+	std::printf("%s: %d mismatches\n", failures ? "FAIL" : "ok", failures);
+	return failures != 0;
+}
