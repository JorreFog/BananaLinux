+	// coordinates as the PICA has them
+	shader += std::string("vec2 rawUV = ") + coords[std::min<u32>(pt.coordSource, 2)] + ";\n";
+	shader += "vec2 uv = abs(vec2(rawUV.x, 1.0 - rawUV.y));\n";
+	shader += "float u = uv.x;\nfloat v = uv.y;\n";
+	// The shift offsets come from the coordinates before noise
+	shader += "float uShift = ptShift(v, " + std::to_string(u32(pt.uShift)) + ", " + uClamp + ");\n";
+	shader += "float vShift = ptShift(u, " + std::to_string(u32(pt.vShift)) + ", " + vClamp + ");\n";
+	if (pt.noiseEnable) {
+		shader += "float noiseU = ptNoiseCoef(u, v) * procTexNoise.x;\n";
+		shader += "float noiseV = ptNoiseCoef(v, u) * procTexNoise.y;\n";
+		shader += "u = abs(u + noiseU);\nv = abs(v + noiseV);\n";
+	}
+	shader += "u = ptClamp(u + uShift, " + uClamp + ");\n";
+	shader += "v = ptClamp(v + vShift, " + vClamp + ");\n";
+	shader += "float lutCoord = ptLookupLUT(26, " + combiner(pt.colourCombiner) + ");\n";
+
+	// Colour LUT: coordinate 0 is entry [offset], 1 is entry [offset + width - 1]
+	shader += "float index = procTexParams.w + lutCoord * (procTexParams.z - 1.0);\n";
+	if (pt.linearFilter) {
+		shader += R"(
+			int i = clamp(int(index), 0, 255);
+			float frac = index - float(i);
+			vec4 colour = vec4(texelFetch(u_tex_luts, ivec2(i, 28), 0).rg, texelFetch(u_tex_luts, ivec2(i, 29), 0).rg);
+			vec4 diff = vec4(texelFetch(u_tex_luts, ivec2(i, 30), 0).rg, texelFetch(u_tex_luts, ivec2(i, 31), 0).rg);
+			colour = clamp(colour + frac * diff, 0.0, 1.0);
+		)";
+	} else {
+		shader += R"(
+			int i = clamp(int(round(index)), 0, 255);
+			vec4 colour = vec4(texelFetch(u_tex_luts, ivec2(i, 28), 0).rg, texelFetch(u_tex_luts, ivec2(i, 29), 0).rg);
+		)";
+	}
+
+	if (pt.separateAlpha) {
+		// The alpha skips the colour LUT and comes from the alpha map
+		shader += "colour.a = clamp(ptLookupLUT(27, " + combiner(pt.alphaCombiner) + "), 0.0, 1.0);\n";
+	}
+	shader += "return colour;\n}\n";
+}
