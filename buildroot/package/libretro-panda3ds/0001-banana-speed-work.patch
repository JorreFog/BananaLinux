+// panda3ds-bench: Panda3DS with no window, for measuring it. It runs a ROM for a number of frames as fast as it can
+// and reports the time each scene took (scenes are the stress-test ROM's "BENCH scene=..." debug strings), the
+// slowest frames and the memory used.
+//
+//   panda3ds-bench <rom> [--frames N] [--renderer gl|null] [--config file.toml] [--marks] [--gpu-thread on|off] [--dump dir]
+//                  [--dump-frames a,b,c] [--maps file]
+//
+// --renderer gl draws through OpenGL ES 3.1 on an EGL surfaceless context (Mesa's llvmpipe on a PC, panfrost on the
+// handheld). --marks makes the syscall 0xBA5E at each frame and scene start, which tools/3ds-perf/a55prof.c (a QEMU
+// plugin) turns into instruction counts per frame and per function. --maps writes /proc/self/maps at the end (for
+// a55prof's code with no symbol).
+//
+// --dump dir (GL renderer only) writes <dir>/<scene>.png with the last frame shown before the next scene's marker,
+// and for the scene still running when the run ends, its last frame. --dump-frames a,b,c also writes
+// <dir>/frame<N>.png after emulator frame N (0-based, counting from the ROM's start, the same frame numbers as the
+// table's "first" column). Each PNG is 400x480: the top screen over the bottom screen, centred, at native resolution.
+// While dumping, every frame is read back from the GPU, so don't time a run that dumps.
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "banana_opts.hpp"
+#include "emulator.hpp"
+#include <stb_image_write.h>
+#include <glad/gl.h>
+
+namespace {
+	using Clock = std::chrono::steady_clock;
+
+	bool marks = false;
+	void mark(long id, long value) {
+		if (marks) syscall(0xBA5E, id, value);
+	}
+
+	struct Scene {
+		std::string name;
+		int firstFrame = 0;
+		std::vector<double> frameMs;
+	};
+
+	EGLDisplay display = EGL_NO_DISPLAY;
+	EGLContext context = EGL_NO_CONTEXT;
+
+	bool initEGL() {
+		auto getPlatformDisplay = (PFNEGLGETPLATFORMDISPLAYEXTPROC)eglGetProcAddress("eglGetPlatformDisplayEXT");
+		if (getPlatformDisplay) display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+		if (display == EGL_NO_DISPLAY) display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+		if (display == EGL_NO_DISPLAY || !eglInitialize(display, nullptr, nullptr)) return false;
+		eglBindAPI(EGL_OPENGL_ES_API);
+		const EGLint configAttribs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_NONE};
+		EGLConfig config;
+		EGLint count = 0;
+		if (!eglChooseConfig(display, configAttribs, &config, 1, &count) || count == 0) {
+			// surfaceless displays may have no pbuffer configs: any ES3 config, no surface
+			const EGLint anyAttribs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_NONE};
+			if (!eglChooseConfig(display, anyAttribs, &config, 1, &count) || count == 0) return false;
+		}
+		const EGLint contextAttribs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 1, EGL_NONE};
+		context = eglCreateContext(display, config, EGL_NO_CONTEXT, contextAttribs);
+		if (context == EGL_NO_CONTEXT) return false;
+		if (!eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) return false;
+		return gladLoadGLES2Loader(reinterpret_cast<GLADloadproc>(eglGetProcAddress)) != 0;
+	}
+
+	long peakRssKB() {
+		struct rusage usage;
+		getrusage(RUSAGE_SELF, &usage);
+		return usage.ru_maxrss;
+	}
+
+	double percentile(std::vector<double> v, double p) {
+		if (v.empty()) return 0;
+		std::sort(v.begin(), v.end());
+		return v[std::min(v.size() - 1, size_t(p * (v.size() - 1) + 0.5))];
+	}
+}  // namespace
+
+int main(int argc, char** argv) {
+	if (argc < 2) {
+		std::fprintf(stderr, "usage: %s <rom> [--frames N] [--renderer gl|null] [--config file.toml] [--marks] [--gpu-thread on|off] [--dump dir] [--dump-frames a,b,c] [--maps file]\n", argv[0]);
+		return 2;
+	}
+	std::filesystem::path rom = std::filesystem::absolute(argv[1]);
+	int frames = 1500;
+	std::string renderer = "null", configFile, dumpDir, mapsFile, jitDumpFile;
+	// The GPU on its own thread (GL only), unless asked not to or measuring upstream's behaviour
+	bool gpuThread = !Banana::baseline();
+	std::vector<int> dumpFrames;
+	for (int i = 2; i < argc; i++) {
+		std::string a = argv[i];
+		if (a == "--frames" && i + 1 < argc) frames = std::atoi(argv[++i]);
+		else if (a == "--renderer" && i + 1 < argc) renderer = argv[++i];
+		else if (a == "--config" && i + 1 < argc) configFile = std::filesystem::absolute(argv[++i]).string();
+		else if (a == "--marks") marks = true;
+		else if (a == "--gpu-thread" && i + 1 < argc) gpuThread = std::string(argv[++i]) != "off";
+		else if (a == "--dump" && i + 1 < argc) dumpDir = std::filesystem::absolute(argv[++i]).string();
+		else if (a == "--dump-frames" && i + 1 < argc) {
+			for (std::string list = argv[++i]; !list.empty();) {
+				size_t comma = list.find(',');
+				dumpFrames.push_back(std::atoi(list.substr(0, comma).c_str()));
+				list = comma == std::string::npos ? "" : list.substr(comma + 1);
+			}
+		} else if (a == "--maps" && i + 1 < argc) mapsFile = std::filesystem::absolute(argv[++i]).string();
+		else if (a == "--dump-jit" && i + 1 < argc) jitDumpFile = std::filesystem::absolute(argv[++i]).string();
+	}
+
+	// The emulator reads config.toml from the working folder: one of our own, with the renderer asked for, no audio
+	// output and nothing else read from the user's settings
+	std::filesystem::path work = std::filesystem::temp_directory_path() / ("panda3ds-bench-" + std::to_string(getpid()));
+	std::filesystem::create_directories(work);
+	std::filesystem::current_path(work);
+	{
+		std::string extra;
+		if (!configFile.empty()) {
+			std::ifstream in(configFile);
+			extra.assign(std::istreambuf_iterator<char>(in), {});
+		}
+		std::ofstream cfg("config.toml");
+		if (extra.find("[GPU]") == std::string::npos)
+			cfg << "[GPU]\nRenderer = \"" << (renderer == "gl" ? "OpenGL" : "Null") << "\"\nEnableVSync = false\n";
+		if (extra.find("[Audio]") == std::string::npos) cfg << "[Audio]\nEnableAudio = false\nMuteAudio = true\n";
+		if (extra.find("[General]") == std::string::npos) cfg << "[General]\nUsePortableBuild = true\nPrintAppVersion = false\n";
+		cfg << extra;
+	}
+
+	if (renderer == "gl" && !initEGL()) {
+		std::fprintf(stderr, "no OpenGL ES 3.1 context (EGL surfaceless)\n");
+		return 1;
+	}
+
+	mark(1, 0);
+	auto emu = std::make_unique<Emulator>();
+	if (renderer == "gl") {
+		emu->getRenderer()->setupGLES();
+		emu->initGraphicsContext(nullptr);
+		emu->setOutputSize(Emulator::width, Emulator::height);
+		if (gpuThread) {
+			// The GL context moves to the GPU's own thread (PICA/gpu_worker.hpp)
+			eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+			emu->startGPUThread([] { eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context); });
+		}
+	}
+
+	std::vector<Scene> scenes;
+	scenes.push_back({"boot", 0, {}});
+	int frame = 0;
+	bool looped = false;
+	emu->getKernel().debugStringHook = [&](const std::string& msg) {
+		if (msg.rfind("BENCH loop", 0) == 0) looped = true;
+		auto at = msg.find("name=");
+		if (msg.rfind("BENCH scene=", 0) != 0 || at == std::string::npos) return;
+		std::string name = msg.substr(at + 5);
+		name = name.substr(0, name.find(' '));
+		scenes.push_back({name, frame, {}});
+		mark(3, frame);
+	};
+
+	auto t0 = Clock::now();
+	if (!emu->loadROM(rom)) {
+		std::fprintf(stderr, "can't load %s\n", rom.c_str());
+		return 1;
+	}
+	double loadMs = std::chrono::duration<double, std::milli>(Clock::now() - t0).count();
+	mark(2, 0);
+
+	// Dumping: keep the previous frame's screens, since a scene's marker shows up in the frame that already belongs
+	// to the next scene
+	const bool dumping = !dumpDir.empty() && renderer == "gl";
+	if (!dumpDir.empty() && renderer != "gl") std::fprintf(stderr, "--dump needs --renderer gl, not dumping\n");
+	if (dumping) std::filesystem::create_directories(dumpDir);
+	std::vector<u8> screen, prevScreen;
+	bool havePrev = false;
+	auto writePng = [&](const std::string& name, const std::vector<u8>& rgba) {
+		const std::string path = dumpDir + "/" + name + ".png";
+		if (!stbi_write_png(path.c_str(), 400, 480, 4, rgba.data(), 400 * 4)) std::fprintf(stderr, "can't write %s\n", path.c_str());
+	};
+
+	auto start = Clock::now();
+	for (frame = 0; frame < frames; frame++) {
+		auto f0 = Clock::now();
+		mark(4, frame);
+		const size_t before = scenes.size();
+		emu->runFrame();
+		double ms = std::chrono::duration<double, std::milli>(Clock::now() - f0).count();
+		// a frame that started a scene belongs to it
+		scenes.back().frameMs.push_back(ms);
+		if (dumping) {
+			emu->runOnGPUThread([&] { emu->getRenderer()->readScreen(screen); });
+			// the scene that just ended (not "boot"): its last frame is the previous one
+			if (scenes.size() != before && havePrev && scenes.size() >= 3) writePng(scenes[scenes.size() - 2].name, prevScreen);
+			if (std::find(dumpFrames.begin(), dumpFrames.end(), frame) != dumpFrames.end())
+				writePng("frame" + std::to_string(frame), screen);
+			std::swap(screen, prevScreen);
+			havePrev = true;
+		}
+		if (looped) break;
+	}
+	// the scene still running at the end (unless the loop marker ended the run: that frame is already the next scene)
+	if (dumping && havePrev && !looped && scenes.size() >= 2) writePng(scenes.back().name, prevScreen);
+	emu->syncGPU();
+	mark(5, frame);
+	if (!mapsFile.empty()) {
+		// what each address range is (the libraries, the JIT's code), for a55prof's [nosym] regions
+		std::ifstream in("/proc/self/maps");
+		std::ofstream out(mapsFile);
+		out << in.rdbuf();
+	}
+	if (!jitDumpFile.empty()) {
+		// The JIT's code (the rwx mappings), each as "<start hex> <size hex>" then the bytes, for a disassembler
+		std::ifstream in("/proc/self/maps");
+		std::ofstream out(jitDumpFile, std::ios::binary);
+		std::string line;
+		while (std::getline(in, line)) {
+			unsigned long start, end;
+			char perms[5] = {};
+			if (std::sscanf(line.c_str(), "%lx-%lx %4s", &start, &end, perms) == 3 && std::string(perms).rfind("rwx", 0) == 0) {
+				const unsigned long size = end - start;
+				out.write(reinterpret_cast<const char*>(&start), 8);
+				out.write(reinterpret_cast<const char*>(&size), 8);
+				out.write(reinterpret_cast<const char*>(start), std::streamsize(size));
+			}
+		}
+	}
+	double totalMs = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+
+	std::printf("rom %s renderer %s frames %d load %.1f ms total %.1f ms (%.2f fps) peak RSS %ld MB\n", rom.filename().c_str(),
+				renderer.c_str(), frame, loadMs, totalMs, frame * 1000.0 / totalMs, peakRssKB() / 1024);
+	std::printf("%-8s %6s %6s %9s %9s %9s %9s\n", "scene", "first", "frames", "mean ms", "p50 ms", "p95 ms", "max ms");
+	for (auto& s : scenes) {
+		if (s.frameMs.empty()) continue;
+		double sum = 0;
+		for (double v : s.frameMs) sum += v;
+		std::printf("%-8s %6d %6zu %9.3f %9.3f %9.3f %9.3f\n", s.name.c_str(), s.firstFrame, s.frameMs.size(), sum / s.frameMs.size(),
+					percentile(s.frameMs, 0.5), percentile(s.frameMs, 0.95), percentile(s.frameMs, 1.0));
+	}
+	std::fflush(stdout);
+	std::error_code ec;
+	std::filesystem::current_path("/");
+	std::filesystem::remove_all(work, ec);
+	std::_Exit(0);  // skip the emulator's teardown: nothing to save
+}
