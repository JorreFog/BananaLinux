+		while (std::getline(in, line)) {
+			unsigned long start, end;
+			char perms[5] = {};
+			if (std::sscanf(line.c_str(), "%lx-%lx %4s", &start, &end, perms) == 3 && std::string(perms).rfind("rwx", 0) == 0) {
+				const unsigned long size = end - start;
+				out.write(reinterpret_cast<const char*>(&start), 8);
+				out.write(reinterpret_cast<const char*>(&size), 8);
+				out.write(reinterpret_cast<const char*>(start), std::streamsize(size));
+			}
+		}
+	}
+	double totalMs = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+
+	std::printf("rom %s renderer %s frames %d load %.1f ms total %.1f ms (%.2f fps) peak RSS %ld MB\n", rom.filename().c_str(),
+				renderer.c_str(), frame, loadMs, totalMs, frame * 1000.0 / totalMs, peakRssKB() / 1024);
+	std::printf("%-8s %6s %6s %9s %9s %9s %9s %9s\n", "scene", "first", "frames", "mean ms", "p50 ms", "p95 ms", "max ms", "ARM11 %");
+	for (auto& s : scenes) {
+		if (s.frameMs.empty()) continue;
+		double sum = 0;
+		for (double v : s.frameMs) sum += v;
+		std::printf("%-8s %6d %6zu %9.3f %9.3f %9.3f %9.3f %8.1f%%\n", s.name.c_str(), s.firstFrame, s.frameMs.size(), sum / s.frameMs.size(),
+					percentile(s.frameMs, 0.5), percentile(s.frameMs, 0.95), percentile(s.frameMs, 1.0),
+					s.ticks ? 100.0 * double(s.ticks - s.idleTicks) / double(s.ticks) : 0.0);
+	}
+	std::fflush(stdout);
+	std::error_code ec;
+	std::filesystem::current_path("/");
+	std::filesystem::remove_all(work, ec);
+	std::_Exit(0);  // skip the emulator's teardown: nothing to save
+}
diff --git a/src/renderer.cpp b/src/renderer.cpp
index 390a3fa6..bb1972fd 100644
--- a/src/renderer.cpp
+++ b/src/renderer.cpp
@@ -45,6 +45,7 @@ const char* Renderer::typeToString(RendererType rendererType) {
 void Renderer::doSoftwareTextureCopy(u32 inputAddr, u32 outputAddr, u32 copySize, u32 inputWidth, u32 inputGap, u32 outputWidth, u32 outputGap) {
 	u8* inputPointer = gpu.getPointerPhys<u8>(inputAddr);
 	u8* outputPointer = gpu.getPointerPhys<u8>(outputAddr);
+	u8* const outputStart = outputPointer;
 
 	if (inputPointer == nullptr || outputPointer == nullptr) {
 		return;
@@ -76,4 +77,106 @@ void Renderer::doSoftwareTextureCopy(u32 inputAddr, u32 outputAddr, u32 copySize
 			outputPointer += outputGap;
 		}
 	}
+
+	// The copy changed guest memory directly: drop what was decoded from it (textures uploaded through TextureCopy)
+	if (outputPointer > outputStart) invalidateRange(outputAddr, u32(outputPointer - outputStart));
+}
+
+namespace {
+	// Display transfer pixel formats (GX_TRANSFER_FMT_*), as stored in memory
+	u32 transferBpp(u32 format) {
+		switch (format) {
+			case 0: return 4;  // RGBA8
+			case 1: return 3;  // RGB8
+			default: return 2; // RGB565, RGB5A1, RGBA4
+		}
+	}
+
+	struct RGBA {
+		u32 r, g, b, a;
+	};
+
+	RGBA decodeTransferPixel(const u8* p, u32 format) {
+		switch (format) {
+			case 0: return {p[3], p[2], p[1], p[0]};
+			case 1: return {p[2], p[1], p[0], 255};
+			case 2: {
+				const u32 v = p[0] | (p[1] << 8);
+				return {((v >> 11) & 31) * 255 / 31, ((v >> 5) & 63) * 255 / 63, (v & 31) * 255 / 31, 255};
+			}
+			case 3: {
+				const u32 v = p[0] | (p[1] << 8);
+				return {((v >> 11) & 31) * 255 / 31, ((v >> 6) & 31) * 255 / 31, ((v >> 1) & 31) * 255 / 31, (v & 1) * 255};
+			}
+			default: {
+				const u32 v = p[0] | (p[1] << 8);
+				return {((v >> 12) & 15) * 17, ((v >> 8) & 15) * 17, ((v >> 4) & 15) * 17, (v & 15) * 17};
+			}
+		}
+	}
+
+	void encodeTransferPixel(u8* p, u32 format, RGBA c) {
+		u32 v;
+		switch (format) {
+			case 0: p[0] = u8(c.a); p[1] = u8(c.b); p[2] = u8(c.g); p[3] = u8(c.r); return;
+			case 1: p[0] = u8(c.b); p[1] = u8(c.g); p[2] = u8(c.r); return;
+			case 2: v = ((c.r >> 3) << 11) | ((c.g >> 2) << 5) | (c.b >> 3); break;
+			case 3: v = ((c.r >> 3) << 11) | ((c.g >> 3) << 6) | ((c.b >> 3) << 1) | (c.a >> 7); break;
+			default: v = ((c.r >> 4) << 12) | ((c.g >> 4) << 8) | ((c.b >> 4) << 4) | (c.a >> 4); break;
+		}
+		p[0] = u8(v);
+		p[1] = u8(v >> 8);
+	}
+
+	// Byte offset of pixel (x, y) in a surface made of 8x8 Morton-ordered tiles, rows of tiles one after another
+	u32 tiledOffset(u32 x, u32 y, u32 width, u32 bpp) {
+		u32 i = 0;
+		for (u32 bit = 0; bit < 3; bit++) {
+			i |= ((x >> bit) & 1) << (2 * bit);
+			i |= ((y >> bit) & 1) << (2 * bit + 1);
+		}
+		return ((y & ~7u) * width + (x & ~7u) * 8 + i) * bpp;
+	}
+}  // namespace
+
+bool Renderer::doSoftwareDisplayTransfer(u32 inputAddr, u32 outputAddr, u32 inputSize, u32 outputSize, u32 flags) {
+	const u32 inputWidth = inputSize & 0xffff, inputHeight = inputSize >> 16;
+	const u32 inputFormat = Helpers::getBits<8, 3>(flags), outputFormat = Helpers::getBits<12, 3>(flags);
+	const bool flip = flags & 1;
+	const bool linearToTiled = (flags >> 1) & 1;
+	const bool rawCopy = (flags >> 3) & 1;
+	const u32 scaling = Helpers::getBits<24, 2>(flags);
+	if (rawCopy || inputFormat > 4 || outputFormat > 4 || scaling == 3 || (flags & (1 << 16))) return false;  // not handled
+
+	// With scaling, the output size is given unscaled
+	const u32 scaleX = scaling != 0 ? 1 : 0, scaleY = scaling == 2 ? 1 : 0;
+	const u32 outputWidth = (outputSize & 0xffff) >> scaleX, outputHeight = (outputSize >> 16) >> scaleY;
+	const u32 inBpp = transferBpp(inputFormat), outBpp = transferBpp(outputFormat);
+	if (outputWidth == 0 || outputHeight == 0 || (outputWidth << scaleX) > inputWidth || (outputHeight << scaleY) > inputHeight) return false;
+
+	const u8* in = gpu.getPointerPhys<u8>(inputAddr, inputWidth * inputHeight * inBpp);
+	u8* out = gpu.getPointerPhys<u8>(outputAddr, outputWidth * outputHeight * outBpp);
+	if (in == nullptr || out == nullptr) return false;
+
+	for (u32 y = 0; y < outputHeight; y++) {
+		const u32 outY = flip ? outputHeight - 1 - y : y;
+		for (u32 x = 0; x < outputWidth; x++) {
+			RGBA sum = {0, 0, 0, 0};
+			for (u32 sy = 0; sy <= scaleY; sy++) {
+				for (u32 sx = 0; sx <= scaleX; sx++) {
+					const u32 ix = (x << scaleX) + sx, iy = (y << scaleY) + sy;
+					const u32 offset = linearToTiled ? (iy * inputWidth + ix) * inBpp : tiledOffset(ix, iy, inputWidth, inBpp);
+					const RGBA c = decodeTransferPixel(in + offset, inputFormat);
+					sum.r += c.r, sum.g += c.g, sum.b += c.b, sum.a += c.a;
+				}
+			}
+			const u32 shift = scaleX + scaleY;
+			const RGBA c = {sum.r >> shift, sum.g >> shift, sum.b >> shift, sum.a >> shift};
+			const u32 offset = linearToTiled ? tiledOffset(x, outY, outputWidth, outBpp) : (outY * outputWidth + x) * outBpp;
+			encodeTransferPixel(out + offset, outputFormat, c);
+		}
+	}
+
+	invalidateRange(outputAddr, outputWidth * outputHeight * outBpp);
+	return true;
 }
diff --git a/tests/banana/libretro_host.cpp b/tests/banana/libretro_host.cpp
new file mode 100644
index 00000000..bff45a1a
--- /dev/null
+++ b/tests/banana/libretro_host.cpp
@@ -0,0 +1,147 @@
+// libretro-host: the least of a libretro frontend, to run and time the Panda3DS core without RetroArch. It gives the
+// core an OpenGL ES 3.1 context (EGL surfaceless) and an FBO as "RetroArch's framebuffer", runs N frames and writes the
+// frames asked for as PPM images (400x480, top-down).
+//
+//   libretro-host <core.so> <rom> [frames] [dump dir] [frame,frame...]
+//
+// g++ -O2 -std=c++20 tests/banana/libretro_host.cpp -Ithird_party/libretro/include -ldl -lEGL -lGLESv2 -o libretro-host
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl31.h>
+#include <dlfcn.h>
+#include <libretro.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static retro_hw_render_callback hw;
+static GLuint fbo, fboTexture;
+static std::string saveDir = "/tmp";
+
+static uintptr_t currentFramebuffer() { return fbo; }
+static retro_proc_address_t procAddress(const char* name) { return (retro_proc_address_t)eglGetProcAddress(name); }
+
+static bool environment(unsigned cmd, void* data) {
+	switch (cmd) {
+		case RETRO_ENVIRONMENT_SET_HW_RENDER: {
+			auto* cb = static_cast<retro_hw_render_callback*>(data);
+			if (cb->context_type != RETRO_HW_CONTEXT_OPENGLES3) return false;
+			hw = *cb;
+			cb->get_current_framebuffer = currentFramebuffer;
+			cb->get_proc_address = procAddress;
+			hw.get_current_framebuffer = currentFramebuffer;
+			hw.get_proc_address = procAddress;
+			return true;
+		}
+		case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY:
+		case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY: *static_cast<const char**>(data) = saveDir.c_str(); return true;
+		case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT: return true;
+		case RETRO_ENVIRONMENT_GET_PREFERRED_HW_RENDER: *static_cast<unsigned*>(data) = RETRO_HW_CONTEXT_OPENGLES3; return true;
+		default: return false;
+	}
+}
+
+static void videoRefresh(const void*, unsigned, unsigned, size_t) {}
+static size_t audioBatch(const int16_t*, size_t frames) { return frames; }
+static void inputPoll() {}
+static int16_t inputState(unsigned, unsigned, unsigned, unsigned) { return 0; }
+
+int main(int argc, char** argv) {
+	if (argc < 3) {
+		std::fprintf(stderr, "usage: %s <core.so> <rom> [frames] [dump dir] [frame,frame...]\n", argv[0]);
+		return 2;
+	}
+	const int frames = argc > 3 ? std::atoi(argv[3]) : 600;
+	const std::string dumpDir = argc > 4 ? argv[4] : "";
+	std::vector<int> dumpFrames;
+	for (std::string list = argc > 5 ? argv[5] : ""; !list.empty();) {
+		size_t comma = list.find(',');
+		dumpFrames.push_back(std::atoi(list.substr(0, comma).c_str()));
+		list = comma == std::string::npos ? "" : list.substr(comma + 1);
+	}
+
+	auto getPlatformDisplay = (PFNEGLGETPLATFORMDISPLAYEXTPROC)eglGetProcAddress("eglGetPlatformDisplayEXT");
+	EGLDisplay display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+	eglInitialize(display, nullptr, nullptr);
+	eglBindAPI(EGL_OPENGL_ES_API);
+	const EGLint pbufferAttribs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_NONE};
+	const EGLint anyAttribs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_NONE};
+	EGLConfig config;
+	EGLint count = 0;
+	if (!eglChooseConfig(display, pbufferAttribs, &config, 1, &count) || count == 0) eglChooseConfig(display, anyAttribs, &config, 1, &count);
+	const EGLint contextAttribs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 1, EGL_NONE};
+	EGLContext context = count ? eglCreateContext(display, config, EGL_NO_CONTEXT, contextAttribs) : EGL_NO_CONTEXT;
+	if (context == EGL_NO_CONTEXT || !eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) {
+		std::fprintf(stderr, "no GLES 3.1 context\n");
+		return 1;
+	}
+	std::fprintf(stderr, "libretro-host: %s, %s\n", (const char*)glGetString(GL_VERSION), (const char*)glGetString(GL_RENDERER));
+	glGenTextures(1, &fboTexture);
+	glBindTexture(GL_TEXTURE_2D, fboTexture);
+	glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 400, 480);
+	glGenFramebuffers(1, &fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, fboTexture, 0);
+
+	void* core = dlopen(argv[1], RTLD_NOW);
+	if (!core) {
+		std::fprintf(stderr, "%s\n", dlerror());
+		return 1;
+	}
+#define SYM(name) auto name = reinterpret_cast<decltype(&::name)>(dlsym(core, #name))
+	SYM(retro_set_environment);
+	SYM(retro_set_video_refresh);
+	SYM(retro_set_audio_sample_batch);
+	SYM(retro_set_input_poll);
+	SYM(retro_set_input_state);
+	SYM(retro_init);
+	SYM(retro_load_game);
+	SYM(retro_run);
+	SYM(retro_unload_game);
+	SYM(retro_deinit);
+	retro_set_environment(environment);
+	retro_set_video_refresh(videoRefresh);
+	retro_set_audio_sample_batch(audioBatch);
+	retro_set_input_poll(inputPoll);
+	retro_set_input_state(inputState);
+	retro_init();
+	retro_game_info game{argv[2], nullptr, 0, nullptr};
+	if (!retro_load_game(&game)) {
+		std::fprintf(stderr, "can't load %s\n", argv[2]);
+		return 1;
+	}
+	hw.context_reset();
+
+	std::vector<double> times;
+	std::vector<unsigned char> pixels(400 * 480 * 4);
+	auto start = std::chrono::steady_clock::now();
+	for (int f = 0; f < frames; f++) {
+		auto t0 = std::chrono::steady_clock::now();
+		retro_run();
+		times.push_back(std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+		if (!dumpDir.empty() && std::find(dumpFrames.begin(), dumpFrames.end(), f) != dumpFrames.end()) {
+			glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+			glReadPixels(0, 0, 400, 480, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+			std::string path = dumpDir + "/frame" + std::to_string(f) + ".ppm";
+			FILE* out = std::fopen(path.c_str(), "wb");
+			std::fprintf(out, "P6\n400 480\n255\n");
+			for (int y = 479; y >= 0; y--)
+				for (int x = 0; x < 400; x++) std::fwrite(&pixels[(y * 400 + x) * 4], 1, 3, out);
+			std::fclose(out);
+		}
+	}
+	double total = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+	std::sort(times.begin(), times.end());
+	std::printf("frames %d total %.1f ms (%.2f fps) p50 %.3f ms p95 %.3f ms\n", frames, total, frames * 1000.0 / total, times[times.size() / 2],
+				times[times.size() * 95 / 100]);
+	std::fflush(stdout);
+	hw.context_destroy();
+	retro_unload_game();
+	std::_Exit(0);
+}
diff --git a/tests/banana/texture_decode_test.cpp b/tests/banana/texture_decode_test.cpp
new file mode 100644
index 00000000..5978e846
--- /dev/null
+++ b/tests/banana/texture_decode_test.cpp
@@ -0,0 +1,38 @@
+// The tiled texture decoder (Texture::decodeToRGBA8) against the texel-by-texel one (Texture::decodeTexel), every
+// format, random data and real-looking sizes. Built with BUILD_BENCH: build/texture-decode-test
+#include <cstdio>
+#include <random>
+#include <vector>
+
+#include "renderer_gl/textures.hpp"
+
+int main() {
+	std::mt19937 rng(1234);
+	int failures = 0;
+	const PICA::TextureFmt formats[] = {
+		PICA::TextureFmt::RGBA8, PICA::TextureFmt::RGB8, PICA::TextureFmt::RGBA5551, PICA::TextureFmt::RGB565, PICA::TextureFmt::RGBA4,
+		PICA::TextureFmt::IA8,   PICA::TextureFmt::RG8,  PICA::TextureFmt::I8,       PICA::TextureFmt::A8,     PICA::TextureFmt::IA4,
+		PICA::TextureFmt::I4,    PICA::TextureFmt::A4,   PICA::TextureFmt::ETC1,     PICA::TextureFmt::ETC1A4,
+	};
+	const u32 sizes[][2] = {{8, 8}, {16, 8}, {64, 32}, {128, 128}, {256, 64}, {32, 512}};
+	for (auto fmt : formats) {
+		for (auto& sz : sizes) {
+			Texture tex(0, fmt, sz[0], sz[1], 0);
+			std::vector<u8> data(tex.sizeInBytes());
+			for (auto& b : data) b = u8(rng());
+			std::vector<u32> fast(sz[0] * sz[1]);
+			tex.decodeToRGBA8(data, fast.data());
+			for (u32 v = 0; v < sz[1]; v++) {
+				for (u32 u = 0; u < sz[0]; u++) {
+					const u32 slow = tex.decodeTexel(u, v, fmt, data);
+					if (slow != fast[v * sz[0] + u]) {
+						if (failures++ < 10)
+							std::printf("%s %ux%u (%u, %u): %08X != %08X\n", PICA::textureFormatToString(fmt), sz[0], sz[1], u, v, fast[v * sz[0] + u], slow);
+					}
+				}
+			}
+		}
+	}
+	std::printf("%s: %d mismatches\n", failures ? "FAIL" : "ok", failures);
+	return failures != 0;
+}
