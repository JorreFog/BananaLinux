+#pragma once
+#include <cstdlib>
+
+// BananaOS's speed work on Panda3DS can be switched off as a whole for A/B measurements: PANDA3DS_BASELINE=1 in the
+// environment runs the code paths upstream Panda3DS runs (panda3ds-bench, tools/3ds-perf in BananaOS).
+namespace Banana {
+	inline bool baseline() {
+		static const bool off = [] {
+			const char* v = std::getenv("PANDA3DS_BASELINE");
+			return v != nullptr && v[0] == '1';
+		}();
+		return off;
+	}
+}  // namespace Banana
