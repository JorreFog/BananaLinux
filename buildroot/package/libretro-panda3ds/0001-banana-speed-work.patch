+	// tile is at x = bits 0, 2, 4 of i and y = bits 1, 3, 5. Decoding a tile at a time reads the source in order and
+	// works out each texel's place once per format instead of once per texel.
+	struct MortonTable {
+		u8 x[64], y[64];
+		constexpr MortonTable() : x(), y() {
+			for (u32 i = 0; i < 64; i++) {
+				x[i] = u8((i & 1) | ((i >> 1) & 2) | ((i >> 2) & 4));
+				y[i] = u8(((i >> 1) & 1) | ((i >> 2) & 2) | ((i >> 3) & 4));
+			}
+		}
+	};
+	constexpr MortonTable morton;
+
+	template <u32 tileBytes, typename Fn>
+	void decodeTiles(u32 width, u32 height, const u8* src, u32* out, Fn&& texel) {
+		for (u32 ty = 0; ty < height; ty += 8) {
+			for (u32 tx = 0; tx < width; tx += 8) {
+				u32* tile = out + ty * width + tx;
+				for (u32 i = 0; i < 64; i++) {
+					tile[morton.y[i] * width + morton.x[i]] = texel(src, i);
+				}
+				src += tileBytes;
+			}
+		}
+	}
+
+	u16 read16(const u8* p) { return u16(p[0]) | (u16(p[1]) << 8); }
+	u32 rgba(u32 r, u32 g, u32 b, u32 a) { return (a << 24) | (b << 16) | (g << 8) | r; }
+
+	constexpr u32 signExtend3(u32 val) { return u32(s32(val) << 29 >> 29); }
+
+	// One 4x4 ETC1 block, all 16 texels: the same arithmetic as Texture::decodeETC, with the block's two base colours
+	// and modifier tables worked out once. alphaData holds 16 4-bit alphas (ETC1A4) or is all ones (ETC1).
+	void decodeETCBlock(u64 colourData, u64 alphaData, u32* out, u32 stride) {
+		static constexpr s32 modifiers[8][2] = {{2, 8}, {5, 17}, {9, 29}, {13, 42}, {18, 60}, {24, 80}, {33, 106}, {47, 183}};
+		const u32 subindices = getBits<0, 16, u32>(colourData);
+		const u32 negationFlags = getBits<16, 16, u32>(colourData);
+		const bool flip = getBit<32>(colourData);
+		const bool diffMode = getBit<33>(colourData);
+		const u32 table[2] = {getBits<37, 3, u32>(colourData), getBits<34, 3, u32>(colourData)};
+
+		s32 base[2][3];
+		if (diffMode) {
+			const s32 r = getBits<59, 5, s32>(colourData), g = getBits<51, 5, s32>(colourData), b = getBits<43, 5, s32>(colourData);
+			const s32 r2 = r + s32(signExtend3(getBits<56, 3, u32>(colourData)));
+			const s32 g2 = g + s32(signExtend3(getBits<48, 3, u32>(colourData)));
+			const s32 b2 = b + s32(signExtend3(getBits<40, 3, u32>(colourData)));
+			base[0][0] = Colour::convert5To8Bit(r), base[0][1] = Colour::convert5To8Bit(g), base[0][2] = Colour::convert5To8Bit(b);
+			base[1][0] = Colour::convert5To8Bit(r2), base[1][1] = Colour::convert5To8Bit(g2), base[1][2] = Colour::convert5To8Bit(b2);
+		} else {
+			base[0][0] = Colour::convert4To8Bit(getBits<60, 4, s32>(colourData));
+			base[0][1] = Colour::convert4To8Bit(getBits<52, 4, s32>(colourData));
+			base[0][2] = Colour::convert4To8Bit(getBits<44, 4, s32>(colourData));
+			base[1][0] = Colour::convert4To8Bit(getBits<56, 4, s32>(colourData));
+			base[1][1] = Colour::convert4To8Bit(getBits<48, 4, s32>(colourData));
+			base[1][2] = Colour::convert4To8Bit(getBits<40, 4, s32>(colourData));
+		}
+
+		for (u32 v = 0; v < 4; v++) {
+			for (u32 u = 0; u < 4; u++) {
+				const u32 texelIndex = u * 4 + v;
+				const u32 sub = (flip ? v : u) >= 2 ? 1 : 0;
+				s32 modifier = modifiers[table[sub]][(subindices >> texelIndex) & 1];
+				if ((negationFlags >> texelIndex) & 1) modifier = -modifier;
+
+				const u32 alpha = Colour::convert4To8Bit(u8((alphaData >> (4 * texelIndex)) & 0xf));
+				out[v * stride + u] = rgba(
+					u32(std::clamp(base[sub][0] + modifier, 0, 255)), u32(std::clamp(base[sub][1] + modifier, 0, 255)),
+					u32(std::clamp(base[sub][2] + modifier, 0, 255)), alpha
+				);
+			}
+		}
+	}
+
+	template <bool hasAlpha>
+	void decodeETC(u32 width, u32 height, const u8* src, u32* out) {
+		constexpr u32 blockBytes = hasAlpha ? 16 : 8;
+		for (u32 ty = 0; ty < height; ty += 8) {
+			for (u32 tx = 0; tx < width; tx += 8) {
+				// The 4 blocks of a tile: (0, 0), (4, 0), (0, 4), (4, 4)
+				for (u32 b = 0; b < 4; b++) {
+					u64 alphaData = ~u64(0), colourData;
+					if constexpr (hasAlpha) std::memcpy(&alphaData, src, 8);
+					std::memcpy(&colourData, src + (hasAlpha ? 8 : 0), 8);
+					decodeETCBlock(colourData, alphaData, out + (ty + (b >> 1) * 4) * width + tx + (b & 1) * 4, width);
+					src += blockBytes;
+				}
+			}
+		}
+	}
+}  // namespace
+
