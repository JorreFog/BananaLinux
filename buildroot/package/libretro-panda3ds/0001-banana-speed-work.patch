diff --git a/include/PICA/gpu_worker.hpp b/include/PICA/gpu_worker.hpp
new file mode 100644
index 00000000..a0c478bb
--- /dev/null
+++ b/include/PICA/gpu_worker.hpp
@@ -0,0 +1,79 @@
+#pragma once
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+// The GPU on a thread of its own (BananaOS): the GSP's work (command lists, memory fills, display transfers, texture
+// copies, the frame's display) runs here in the order it was submitted, on the thread that owns the GL context, while
+// the emulated CPU goes on. On a 3DS the PICA and the transfer engine run beside the ARM11 too; games wait for their
+// interrupts before touching what they draw, and GPUService delivers those interrupts only once this queue is empty.
+//
+// On a handheld with four slow cores this takes the renderer and the GL driver (a large part of a 3D frame) off the
+// emulated CPU's core.
+class GPUWorker {
+	std::thread thread;
+	std::mutex lock;
+	std::condition_variable workReady, workDone;
+	std::deque<std::function<void()>> queue;
+	bool working = false;  // an item is running
+	bool quit = false;
+
+	void loop(std::function<void()> onStart) {
+		if (onStart) onStart();
+		std::unique_lock guard(lock);
+		while (true) {
+			workReady.wait(guard, [this] { return quit || !queue.empty(); });
+			if (queue.empty() && quit) break;
+			auto item = std::move(queue.front());
+			queue.pop_front();
+			working = true;
+			guard.unlock();
+			item();
+			guard.lock();
+			working = false;
+			if (queue.empty()) workDone.notify_all();
+		}
+	}
+
+  public:
+	~GPUWorker() { stop(); }
+
+	bool running() const { return thread.joinable(); }
+
+	// onStart runs first on the new thread (making the GL context current there)
+	void start(std::function<void()> onStart) {
+		quit = false;
+		thread = std::thread([this, onStart = std::move(onStart)] { loop(onStart); });
+	}
+
+	void stop() {
+		if (!thread.joinable()) return;
+		{
+			std::scoped_lock guard(lock);
+			quit = true;
+		}
+		workReady.notify_all();
+		thread.join();
+	}
+
+	void submit(std::function<void()> item) {
+		{
+			std::scoped_lock guard(lock);
+			queue.push_back(std::move(item));
+		}
+		workReady.notify_one();
+	}
+
+	// Wait until everything submitted so far has run
+	void drain() {
+		std::unique_lock guard(lock);
+		workDone.wait(guard, [this] { return queue.empty() && !working; });
+	}
+
+	bool idle() {
+		std::scoped_lock guard(lock);
+		return queue.empty() && !working;
+	}
+};
