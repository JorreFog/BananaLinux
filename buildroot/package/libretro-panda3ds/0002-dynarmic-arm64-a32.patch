+namespace Dynarmic::Backend::Arm64 {
+
+// BananaOS's changes to this backend (Panda3DS on the RG DS Plus's Cortex-A55): PANDA3DS_BASELINE=1 in the environment
+// turns them off, for A/B measurements
+inline bool BananaBaseline() {
+    static const bool baseline = [] {
+        const char* v = std::getenv("PANDA3DS_BASELINE");
+        return v && v[0] == '1';
+    }();
+    return baseline;
+}
