+// BananaOS: an NZCV write that a later full NZCV write overwrites, with nothing between them that could read the flags,
+// is dropped (and with it, after dead code elimination, the MRS that read them and the flag-setting form of the
+// instruction). Thumb-1 code, which sets the flags with nearly every ALU instruction, stored NZCV after each of them.
+void A32DeadNZCVElimination(IR::Block& block) {
+    bool overwritten = false;  // a later instruction writes all of NZCV before anything can read it
+    for (auto it = block.rbegin(); it != block.rend(); ++it) {
+        IR::Inst& inst = *it;
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::A32SetCpsrNZCV:
+            if (overwritten) {
+                inst.Invalidate();
+            }
+            overwritten = true;
+            continue;
+        case IR::Opcode::A32SetCpsrNZCVRaw:
+        case IR::Opcode::A32SetCpsrNZCVQ:
+        case IR::Opcode::A32SetCpsr:
+            overwritten = true;
+            continue;
+        case IR::Opcode::A32GetRegister:
+        case IR::Opcode::A32SetRegister:
+        case IR::Opcode::A32GetExtendedRegister32:
+        case IR::Opcode::A32GetExtendedRegister64:
+        case IR::Opcode::A32SetExtendedRegister32:
+        case IR::Opcode::A32SetExtendedRegister64:
+        case IR::Opcode::Void:
+            continue;
+        default:
+            break;
+        }
+        if (inst.ReadsFromCPSR() || inst.WritesToCPSR() || inst.MayHaveSideEffects()) {
+            overwritten = false;
+        }
+    }
+}
+
