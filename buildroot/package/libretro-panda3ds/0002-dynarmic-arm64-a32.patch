+// Whether an emitted instruction leaves NZCV alone, from a short list of what the block's tail holds between the guest's
+// flag-setting instruction and its conditional branch: loads and stores of the JIT state (base Xstate or SP: no fastmem,
+// whose faults run a callback), and ADD/SUB/logical/move/bitfield instructions that don't set flags. Anything else
+// (a call, a branch, a guest memory access, a flag-setting instruction) and the flags aren't trusted.
+bool KeepsNZCV(std::uint32_t insn) {
+    if ((insn & 0x0A000000) == 0x08000000) {  // loads and stores
+        const std::uint32_t rn = (insn >> 5) & 31;
+        const bool unsigned_imm = (insn & 0x3B000000) == 0x39000000;
+        const bool pair = (insn & 0x3A000000) == 0x28000000;
+        return (unsigned_imm || pair) && (rn == 28 || rn == 31);
+    }
+    if ((insn & 0x1F000000) == 0x11000000) return (insn & 0x20000000) == 0;  // ADD/SUB (immediate), not ADDS/SUBS
+    if ((insn & 0x1F200000) == 0x0B000000) return (insn & 0x20000000) == 0;  // ADD/SUB (shifted register)
+    if ((insn & 0x1F800000) == 0x12000000) return (insn & 0x60000000) != 0x60000000;  // logical (immediate), not ANDS
+    if ((insn & 0x1F000000) == 0x0A000000) return (insn & 0x60000000) != 0x60000000;  // logical (shifted register)
+    if ((insn & 0x1F800000) == 0x12800000) return true;  // MOVN/MOVZ/MOVK
+    if ((insn & 0x1F800000) == 0x13000000) return true;  // SBFM/BFM/UBFM (shifts, extends)
+    if ((insn & 0xFFF00000) == 0xD5300000) return true;  // MRS
+    return false;
+}
