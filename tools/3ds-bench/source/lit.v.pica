; Transform + per-vertex directional lighting (Gouraud), textured.
; Uniforms
.fvec projection[4], modelView[4]
.fvec lightVec   ; view-space unit vector towards the light (xyz)
.fvec lightClr   ; diffuse light colour (rgb)
.fvec ambient    ; ambient colour (rgb), w = object alpha

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias innrm v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * pos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	; view-space normal, normalised
	dp3 r2.x, modelView[0], innrm
	dp3 r2.y, modelView[1], innrm
	dp3 r2.z, modelView[2], innrm
	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2.xyz, r3.xxx

	; diffuse = max(0, N.L)
	dp3 r4.x, lightVec, r2
	max r4.x, zeros, r4.x

	; colour = min(1, ambient + lightClr * diffuse), alpha = ambient.w
	mul r5, lightClr, r4.xxxx
	add r5, ambient, r5
	min r5, ones, r5
	mov r5.w, ambient.w
	mov outclr, r5
	end
.end
