#!/bin/sh
# A Qualcomm AudioReach handheld's sound (the AYN Thor's: the ADSP, q6apm, the LPASS macros, SoundWire, a WCD938x
# codec and two AW88166 amplifiers, the sc8280xp machine driver), brought up before bananad opens it. The drivers
# are modules and, with no udev, nothing loads them by itself; and the order matters, each step needing the one before
# it to have probed:
#   1. the ADSP's remoteproc (qcom_q6v5_pas). Its GPR services take a second or two to answer: a q6apm loaded before
#      that logs "CMD timeout for [10001021]" (APM_CMD_GET_SPF_STATE) and never retries, so wait for it to run.
#   2. the DSP's services (q6apm, q6prm and its LPASS clocks) as early as possible: q6apm's first command waits up to
#      5 s for the ADSP and everything below queues behind it.
#   3. the LPASS macros (SoundWire takes its clock from the RX macro), the SoundWire bus, the codec on it.
#   4. the machine driver, which loads the topology the DSP runs the graph from; then the card is waited for (bananad
#      reads /proc/asound/cards once, at its start).
# From Banana Pocket's rcS (the Retroid Pocket Classic, the same stack with a WCD937x), where this order took the
# first sound from ~20 s to ~8 s after the kernel (its docs/BOOT-SOUND.md). The codec's modules and the board's own
# after the card (the battery manager, which bananad reads) come from the hardware profile:
#   HW_AUDIO_CODEC_MODULES, HW_LATE_MODULES (/etc/banana/hw.conf)
#
#   qcom-audio            (rcS, before bananad; the steps' times go to /run/banana/boot-times)
[ -r /etc/banana/hw.conf ] && . /etc/banana/hw.conf
mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" >> /run/banana/boot-times; }

modprobe -a qcom_q6v5_pas qcom_q6v5 qcom_sysmon qcom_common 2>/dev/null
mark "audio: adsp modprobe"
# (the remoteproc says "running" a moment before the DSP answers; q6apm's own wait covers that)
i=0
while [ $i -lt 40 ] && ! grep -q running /sys/class/remoteproc/remoteproc*/state 2>/dev/null; do sleep 0.2; i=$((i + 1)); done
mark "audio: adsp running"
modprobe -a snd-q6dsp-common snd-q6apm q6apm-dai q6apm-lpass-dais q6prm q6prm-clocks 2>/dev/null
mark "audio: q6apm+q6prm"
modprobe -a snd-soc-lpass-macro-common snd-soc-lpass-rx-macro snd-soc-lpass-tx-macro snd-soc-lpass-va-macro \
    soundwire-qcom 2>/dev/null
mark "audio: macros+soundwire"
modprobe -a snd-soc-wcd-common snd-soc-wcd-mbhc snd-soc-wcd-classh ${HW_AUDIO_CODEC_MODULES} 2>/dev/null
mark "audio: codec"
modprobe -a snd-soc-qcom-common 2>/dev/null
modprobe snd-soc-sc8280xp 2>/dev/null
mark "audio: machine"
i=0
while [ $i -lt 40 ] && ! grep -q '\[' /proc/asound/cards 2>/dev/null; do sleep 0.1; i=$((i + 1)); done
mark "audio: card"
[ -n "$HW_LATE_MODULES" ] && modprobe -a $HW_LATE_MODULES 2>/dev/null
mark "audio: done"
exit 0
