#!/bin/sh
# RetroAchievements secrets out of retroarch.cfg, which file sharing shows (it hides banana/accounts.conf):
#   ra-secrets scrub
# RetroArch writes its account's password and login token into retroarch.cfg whenever it saves its settings (on
# exit, "Save configuration", a login in its own menu). They go to accounts.conf instead, the account RetroArch
# used becoming the one there if it differs (the last login wins), and leave retroarch.cfg. run-retroarch runs this
# before and after a game, and file sharing before it starts (a game cut short by a power loss left them there).
CFG=/data/retroarch/retroarch.cfg
A=/data/banana/accounts.conf
acct() { sed -n "s/^$1=//p" $A 2>/dev/null | head -n 1; }
acct_set() { [ -f $A ] && sed -i "/^$1=/d" $A; printf '%s=%s\n' "$1" "$2" >> $A; }
cfg() { sed -n "s/^$1 = \"\\(.*\\)\"\$/\\1/p" $CFG | tail -n 1; }
case $1 in
scrub)
    [ -f $CFG ] || exit 0
    grep -qE '^cheevos_(password|token) = ' $CFG || exit 0
    cu=$(cfg cheevos_username); cp=$(cfg cheevos_password); ct=$(cfg cheevos_token)
    if [ -n "$cu" ] && { [ -n "$cp" ] || [ -n "$ct" ]; }; then
        if [ "$cu" != "$(acct ra_user)" ]; then
            # another account than the setup's (or none): RetroArch's login replaces it
            acct_set ra_user "$cu"
            if [ -n "$cp" ]; then acct_set ra_password "$cp"; elif [ -f $A ]; then sed -i '/^ra_password=/d' $A; fi
            if [ -n "$ct" ]; then acct_set ra_retroarch_token "$ct"; elif [ -f $A ]; then sed -i '/^ra_retroarch_token=/d' $A; fi
        else
            [ -n "$cp" ] && [ "$cp" != "$(acct ra_password)" ] && acct_set ra_password "$cp"
            [ -n "$ct" ] && acct_set ra_retroarch_token "$ct"
        fi
    fi
    sed -i '/^cheevos_password = /d; /^cheevos_token = /d' $CFG
    ;;
*) echo "usage: ra-secrets scrub" >&2; exit 1 ;;
esac
exit 0
