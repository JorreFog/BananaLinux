#!/bin/sh
# The DS's in-game saves shared by the two DS emulators. DraStic (SuperDrastic) keeps drastic/backup/<game>.dsv;
# BananaDS (melonDS) keeps saves/nds/<game>.sav. DraStic's own .dsv is the raw save; a .dsv written by DeSmuME (a
# card scraped under another firmware, a save copied from a PC) has DeSmuME's footer after it: a 16-byte
# "|-DESMUME SAVE-|" cookie as the last 16 bytes, and 36 bytes before the end the u32 the raw save was padded to.
# Before either emulator starts a game the newer of the two is written over the other in its own form (the footer
# left off for BananaDS), the file replaced kept as .bak. The save's exact size is kept: melonDS picks the save
# memory from the ROM, and a file of another size is what makes a game say its save data is corrupted. Run by
# run-drastic and run-bananads.
#   nds-saves <rom>
G=${1##*/}; G=${G%.*}
DSV="/data/drastic/backup/$G.dsv"
SAV="/data/saves/nds/$G.sav"
mkdir -p /data/drastic/backup /data/saves/nds
# a save from ROCKNIX, beside the game (roms/nds/<game>.dsv, on either card, #25): taken when Banana has no save for
# the game yet, so a copy of the old file can never write over a game played here since; the file beside the game
# stays as it is
R="${1%.*}.dsv"
if [ -f "$R" ] && [ ! -f "$DSV" ] && [ ! -f "$SAV" ]; then
    cp -p "$R" "$DSV" && echo "nds-saves: $G: the save beside the game (ROCKNIX's) taken"
fi
# raw_of_dsv <dsv> <out>: the raw save inside a .dsv, DeSmuME's footer and padding left off; the file as it is
# when it has no footer (DraStic's own)
raw_of_dsv() {
    _n=$(wc -c < "$1") || return 1
    [ "$_n" -gt 122 ] || { cat "$1" > "$2"; return 0; }
    [ "$(tail -c 16 "$1")" = "|-DESMUME SAVE-|" ] || { cat "$1" > "$2"; return 0; }
    # padded_size (u32 LE, 36 bytes from the end) is where DeSmuME put the raw save's end; the fixed 122-byte
    # footer is the fallback when it is missing (od absent) or out of range
    _p=$(od -An -tu4 -j $((_n - 36)) -N 4 "$1" 2>/dev/null | tr -d ' \n')
    case $_p in ''|*[!0-9]*) _p=$((_n - 122)) ;; esac
    { [ "$_p" -gt 0 ] && [ "$_p" -le $((_n - 40)) ]; } || _p=$((_n - 122))
    head -c "$_p" "$1" > "$2"
}

if [ -f "$DSV" ] && { [ ! -f "$SAV" ] || [ "$DSV" -nt "$SAV" ]; }; then
    raw_of_dsv "$DSV" "$SAV.new" || exit 0
    if [ -f "$SAV" ] && cmp -s "$SAV.new" "$SAV"; then rm -f "$SAV.new"; exit 0; fi
    [ -f "$SAV" ] && cp -p "$SAV" "$SAV.bak"
    mv -f "$SAV.new" "$SAV" && touch -r "$DSV" "$SAV"
    echo "nds-saves: $G: DraStic's save is newer: BananaDS takes it ($(wc -c < "$SAV") bytes)"
elif [ -f "$SAV" ] && { [ ! -f "$DSV" ] || [ "$SAV" -nt "$DSV" ]; }; then
    if [ -f "$DSV" ]; then
        raw_of_dsv "$DSV" "$DSV.cmp.$$"
        cmp -s "$DSV.cmp.$$" "$SAV" && { rm -f "$DSV.cmp.$$"; exit 0; }
        rm -f "$DSV.cmp.$$"
        cp -p "$DSV" "$DSV.bak"
    fi
    cat "$SAV" > "$DSV.new" && mv -f "$DSV.new" "$DSV" && touch -r "$SAV" "$DSV"
    echo "nds-saves: $G: BananaDS's save is newer: DraStic takes it ($(wc -c < "$DSV") bytes)"
fi
exit 0
