#!/bin/sh
# The DS's in-game saves shared by the two DS emulators. DraStic (SuperDrastic) keeps drastic/backup/<game>.dsv;
# BananaDS (melonDS) keeps saves/nds/<game>.sav. A .dsv in DeSmuME's format, which is what DraStic writes (and
# DeSmuME, and ROCKNIX's DraStic beside the game), is the raw save followed by DeSmuME's 122-byte footer: a
# 16-byte "|-DESMUME SAVE-|" cookie as the last 16 bytes, and 36 bytes before the end the u32 the raw save was
# padded to. DraStic also reads a raw save with no footer, which is what it is given here. Before either emulator
# starts a game the newer of the two is written over the other in its own form (the footer left off for BananaDS),
# the file replaced kept as .bak. The raw size is kept as it is: melonDS sizes the save memory from its game list,
# not from the file, and fits a file of another size to it (cut short, or padded with 0xFF) without a word. Run by
# run-drastic and run-bananads. A save under 512 bytes (the smallest real one is a 4 Kbit EEPROM's) is no save: it
# never goes over one that has something in it (#96); the other way round instead.
#   nds-saves <rom>
#   BANANA_ROOT=<dir> nds-saves <rom>   the data partition somewhere else than /data (system/tests/launchers-test.sh;
#                                       banana-sync's --root, not BANANA_DATA: that is banana/ to banana-ui and update)
DATA=${BANANA_ROOT:-/data}
G=${1##*/}; G=${G%.*}
DSV="$DATA/drastic/backup/$G.dsv"
SAV="$DATA/saves/nds/$G.sav"
mkdir -p "$DATA/drastic/backup" "$DATA/saves/nds"
# a save from ROCKNIX, beside the game (roms/nds/<game>.dsv, on either card, #25): taken when Banana has no save for
# the game yet, so a copy of the old file can never write over a game played here since; the file beside the game
# stays as it is
R="${1%.*}.dsv"
if [ -s "$R" ] && [ ! -f "$DSV" ] && [ ! -f "$SAV" ]; then
    cp -p "$R" "$DSV" && echo "nds-saves: $G: the save beside the game (ROCKNIX's) taken"
fi
# size <file>: its bytes, 0 when there is none
size() { wc -c 2>/dev/null < "$1" || echo 0; }
# raw_of_dsv <dsv> <out>: the raw save inside a .dsv, DeSmuME's footer and padding left off; the file as it is
# when it has no footer (one nds-saves wrote). Fails (out not written) for a footer whose fields don't add up: its
# version (20 bytes from the end) not 0, or the padded size not the file less one of the footer's two lengths, 122
# bytes or the 40 an older DraStic wrote without the text line. Such a file is left for its owner, not guessed at
raw_of_dsv() {
    _n=$(wc -c < "$1") || return 1
    # (each write checked, and its size: on a full card a copy cut short counted as done and went over the save)
    { [ "$_n" -gt 40 ] && [ "$(tail -c 16 "$1")" = "|-DESMUME SAVE-|" ]; } || { cat "$1" > "$2" && [ "$(size "$2")" = "$_n" ]; return; }
    _v=$(od -An -tu4 -j $((_n - 20)) -N 4 "$1" | tr -d ' \n')
    _p=$(od -An -tu4 -j $((_n - 36)) -N 4 "$1" | tr -d ' \n')
    [ "$_v" = 0 ] || return 1
    case $_p in "$((_n - 122))"|"$((_n - 40))") ;; *) return 1 ;; esac
    head -c "$_p" "$1" > "$2" && [ "$(size "$2")" = "$_p" ]
}
# keep <file>: <file>.bak, a whole copy or none at all (made beside it and renamed: a copy cut short on a full card
# never replaces a good backup)
keep() { cp -p "$1" "$1.bak.new" && [ "$(size "$1.bak.new")" = "$(size "$1")" ] && mv -f "$1.bak.new" "$1.bak" || { rm -f "$1.bak.new"; return 1; }; }

TO= WHY=newer
if [ -f "$DSV" ] && { [ ! -f "$SAV" ] || [ "$DSV" -nt "$SAV" ]; }; then TO=sav
elif [ -f "$SAV" ] && { [ ! -f "$DSV" ] || [ "$SAV" -nt "$DSV" ]; }; then TO=dsv; fi
# the newer one empty (a game quit before it wrote, a file made and never filled: SM64DS in SuperDrastic, #96) and
# the older one a save: the older one is kept and goes over the empty one instead
if [ "$TO" = sav ] && [ "$(size "$SAV")" -gt 0 ]; then
    raw_of_dsv "$DSV" "$SAV.new" || { rm -f "$SAV.new"; echo "nds-saves: $G: DraStic's save: its footer doesn't add up or it couldn't be read (card full?), left as it is"; exit 0; }
    n=$(size "$SAV.new"); rm -f "$SAV.new"
    [ "$n" -lt 512 ] && { echo "nds-saves: $G: DraStic's save is newer but empty ($n bytes): BananaDS's kept, DraStic takes it"; TO=dsv WHY=kept; }
elif [ "$TO" = dsv ] && [ "$(size "$SAV")" -lt 512 ] && [ "$(size "$DSV")" -gt 0 ]; then
    echo "nds-saves: $G: BananaDS's save is newer but empty ($(size "$SAV") bytes): DraStic's kept, BananaDS takes it"; TO=sav WHY=kept
fi

if [ "$TO" = sav ]; then
    raw_of_dsv "$DSV" "$SAV.new" || { rm -f "$SAV.new"; echo "nds-saves: $G: DraStic's save: its footer doesn't add up or it couldn't be copied (card full?): BananaDS's left as it is" >&2; exit 0; }
    if [ -f "$SAV" ] && cmp -s "$SAV.new" "$SAV"; then rm -f "$SAV.new"; exit 0; fi
    if [ -f "$SAV" ] && ! keep "$SAV"; then rm -f "$SAV.new"; echo "nds-saves: $G: no room for a backup of BananaDS's save: left as it is" >&2; exit 0; fi
    mv -f "$SAV.new" "$SAV" && touch -r "$DSV" "$SAV"
    echo "nds-saves: $G: DraStic's save is $WHY: BananaDS takes it ($(wc -c < "$SAV") bytes)"
elif [ "$TO" = dsv ]; then
    if [ -f "$DSV" ]; then
        raw_of_dsv "$DSV" "$DSV.cmp.$$" && cmp -s "$DSV.cmp.$$" "$SAV" && { rm -f "$DSV.cmp.$$"; exit 0; }
        rm -f "$DSV.cmp.$$"
        keep "$DSV" || { echo "nds-saves: $G: no room for a backup of DraStic's save: left as it is" >&2; exit 0; }
    fi
    { cat "$SAV" > "$DSV.new" && [ "$(size "$DSV.new")" = "$(size "$SAV")" ]; } || { rm -f "$DSV.new"; echo "nds-saves: $G: BananaDS's save couldn't be copied (card full?): DraStic's left as it is" >&2; exit 0; }
    mv -f "$DSV.new" "$DSV" && touch -r "$SAV" "$DSV"
    echo "nds-saves: $G: BananaDS's save is $WHY: DraStic takes it ($(wc -c < "$DSV") bytes)"
fi
exit 0
