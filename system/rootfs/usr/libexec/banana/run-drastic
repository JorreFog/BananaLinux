#!/bin/sh
# Nintendo DS: DraStic, through SuperDrastic straight onto both panels (each DS screen on its own panel, 2x
# internal resolution, its own CPU governor). DraStic and its settings live in /data/drastic so its saves, states
# and configuration survive updates; the first run copies the program there.
#   run-drastic <rom>
D=/data/drastic
SD=/usr/lib/superdrastic
if [ ! -x $D/drastic ]; then
    [ -d /usr/share/drastic ] || { echo "DraStic isn't installed" >&2; exit 1; }
    # each file and folder that isn't there yet (BusyBox's cp -rn <dir>/. copies nothing at all, even into an empty
    # folder; the settings screen may already have made config/drastic.cfg)
    mkdir -p $D/config
    for f in /usr/share/drastic/* /usr/share/drastic/config/*; do
        t=$D/${f#/usr/share/drastic/}
        [ -e "$t" ] || cp -a "$f" "$t"
    done
fi
cd $D
# DraStic writes beside $HOME (SDL's cache); / is read-only
export HOME=$D XDG_RUNTIME_DIR=/run
# banana-ui has let go of the panels completely (it closes its display while a game runs)
export DSFLIP_HANDOVER=none DSFLIP_DRASTIC_DIR=$D DSFLIP_TOP=${BANANA_TOP:-DSI-2}
# SuperDrastic's memory (per-game clocks, RetroAchievements login) and logs on the data partition, not beside it
export DSFLIP_DATA=/data/superdrastic DSFLIP_LOGDIR=/data/banana/logs/superdrastic
# ROCKNIXDS's defaults: the Gengis Engine renderer (DraStic's picture with ~12% less CPU work a frame) and
# SuperDrastic's own CPU governor (the lowest clock with no dropped frames, remembered per game)
export DSFLIP_RAST=${DSFLIP_RAST:-1} DSFLIP_CPUGOV=${DSFLIP_CPUGOV:-1}
# the RetroAchievements account from the setup (banana/accounts.conf), for SuperDrastic's achievements
A=/data/banana/accounts.conf
if [ -f $A ]; then
    u=$(sed -n 's/^ra_user=//p' $A | head -n 1); w=$(sed -n 's/^ra_password=//p' $A | head -n 1)
    [ -n "$u" ] && export DSFLIP_RA_USER="$u" DSFLIP_RA_PASSWORD="$w"
fi
# the in-game menu (L3) in BananaOS's colours and fonts
export DSFLIP_MENU_THEME=banana
# Quit game (the menu) and a shutdown while playing save the spot to a resume state, loaded once at the next start of
# the game. One older than the game's own save is dropped: loading it would put back an older in-game save too.
G=$(basename "$1"); G=${G%.*}
R=$D/savestates/$G.resume.dss
mkdir -p $D/savestates
RLOAD=0
if [ -f "$R" ]; then
    if [ -f "$D/backup/$G.dsv" ] && [ "$D/backup/$G.dsv" -nt "$R" ]; then rm -f "$R"; else RLOAD=1; fi
fi
export DSFLIP_RESUME_FILE="$R" DSFLIP_RESUME_LOAD=$RLOAD
# the settings screen's choices (KEY=value lines), exported to SuperDrastic
if [ -f /data/banana/superdrastic.conf ]; then set -a; . /data/banana/superdrastic.conf; set +a; fi
exec $SD/superdrastic-run $D/drastic "$1"
