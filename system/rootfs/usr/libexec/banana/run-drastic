#!/bin/sh
# Nintendo DS: DraStic, through SuperDrastic straight onto both panels (each DS screen on its own panel, 2x
# internal resolution, its own CPU governor). DraStic and its settings live in /data/drastic so its saves, states
# and configuration survive updates; the first run copies the program there.
#   run-drastic <rom>
D=/data/drastic
SD=/usr/lib/superdrastic
if [ ! -x $D/drastic ]; then
    [ -d /usr/share/drastic ] || { echo "DraStic isn't installed" >&2; exit 1; }
    # each file and folder that isn't there yet (BusyBox's cp -rn <dir>/. copies nothing at all, even into an empty
    # folder; the settings screen may already have made config/drastic.cfg)
    mkdir -p $D/config
    for f in /usr/share/drastic/* /usr/share/drastic/config/*; do
        t=$D/${f#/usr/share/drastic/}
        [ -e "$t" ] || cp -a "$f" "$t"
    done
fi
cd $D
# DraStic writes beside $HOME (SDL's cache); / is read-only
export HOME=$D XDG_RUNTIME_DIR=/run
# banana-ui has let go of the panels completely (it closes its display while a game runs)
export DSFLIP_HANDOVER=none DSFLIP_DRASTIC_DIR=$D DSFLIP_TOP=${BANANA_TOP:-DSI-2}
# SuperDrastic's memory (per-game clocks, RetroAchievements login) and logs on the data partition, not beside it
export DSFLIP_DATA=/data/superdrastic DSFLIP_LOGDIR=/data/banana/logs/superdrastic
# ROCKNIXDS's defaults: the Gengis Engine renderer (DraStic's picture with ~12% less CPU work a frame) and
# SuperDrastic's own CPU governor (the lowest clock with no dropped frames, remembered per game)
export DSFLIP_CPUGOV=${DSFLIP_CPUGOV:-1}
# the RetroAchievements account from the setup (banana/accounts.conf), for SuperDrastic's achievements
A=/data/banana/accounts.conf
if [ -f $A ]; then
    u=$(sed -n 's/^ra_user=//p' $A | head -n 1); w=$(sed -n 's/^ra_password=//p' $A | head -n 1)
    [ -n "$u" ] && export DSFLIP_RA_USER="$u" DSFLIP_RA_PASSWORD="$w"
fi
# the in-game menu (L3) in BananaOS's colours and fonts
export DSFLIP_MENU_THEME=banana
# Settings > Nintendo DS > Frame pacing (superdrastic.conf DSFLIP_PACE): Panels (the default) runs DraStic at the
# panels' refresh instead of the DS's 59.83 Hz, which against a 60 Hz panel showed a frame twice every ~6 s (a
# hitch when the picture scrolls; BananaDS's kms.pace=display): SuperDrastic takes its sound as 44100 * refresh /
# 59.83 Hz (DSFLIP_AUDIO_LOCK), 0.3% fast. The refresh from the panels' real pixel clock and timing (59.999 Hz on the
# RG DS Plus after banana-panel-tune). And SuperDrastic resamples to 48 kHz itself, the RG DS Plus amplifiers' rate.
refresh() {
    local D=/sys/kernel/debug
    [ -f $D/dri/0/state ] || mount -t debugfs none $D 2>/dev/null
    set -- $(sed -n 's/.*mode: "[^"]*": [0-9]* \([0-9]*\) [0-9]* [0-9]* [0-9]* \([0-9]*\) [0-9]* [0-9]* [0-9]* \([0-9]*\).*/\1 \2 \3/p' $D/dri/0/state 2>/dev/null | head -n 1)
    [ -n "$3" ] || { echo 60; return; }
    local clk=$(awk '$1 == "dclk_vop1" || $1 == "dclk_vop0" { print $5; exit }' $D/clk/clk_summary 2>/dev/null)
    awk -v k=$1 -v h=$2 -v v=$3 -v c=${clk:-0} 'BEGIN { if (c < 1000000) c = k * 1000; printf "%.4f\n", c / (h * v) }'
}
pace=$(sed -n 's/^ *DSFLIP_PACE *= *//p' /data/banana/superdrastic.conf 2>/dev/null | tail -n 1)
# DraStic makes 44100 samples a second here whatever the panels' rate (it runs its own 60 frames a second: present/s
# 60.0 on a 60.17 Hz panel too), so its sound is taken at exactly that: DSFLIP_AUDIO_LOCK_PER = the refresh rate. Taken
# at the DS's rate it was drained faster than it was made, and DraStic filled the gaps with zeros (Mario Kart DS: 40-66
# clicks every 10 s; 0 at 44100, measured at 59.9986 and at 60.17 Hz, the stock timing before panel-tune's next boot)
if [ "$pace" != ds ]; then
    export DSFLIP_AUDIO_LOCK=${DSFLIP_AUDIO_LOCK:-$(refresh)}
    export DSFLIP_AUDIO_LOCK_PER=${DSFLIP_AUDIO_LOCK_PER:-$DSFLIP_AUDIO_LOCK}
fi
export DSFLIP_AUDIO_DEVICE_RATE=${DSFLIP_AUDIO_DEVICE_RATE:-48000}
# two finished frames may wait for the panels, not one: DraStic's frames come unevenly (two in one refresh, then
# none), and with one a frame was dropped and the next refresh repeated the last (HeartGold, 65 s: 12 drops and 8
# repeats with one, 4 and 3 with two), at one more refresh of latency, as BananaDS's kms.queue
export DSFLIP_QUEUE=${DSFLIP_QUEUE:-2}
# the in-game save as BananaDS left it, when it played the game last (nds-saves: the two emulators share saves)
/usr/libexec/banana/nds-saves "$1"
# Quit game (the menu) and a shutdown while playing save the spot to a resume state, loaded once at the next start of
# the game. One older than the game's own save is dropped: loading it would put back an older in-game save too.
# Only with Settings > Nintendo DS > Quick resume on (settings.conf's quick_resume); off, a quit ends the game.
if grep -q '^ *quick_resume *= *on' /data/banana/settings.conf 2>/dev/null; then
    G=$(basename "$1"); G=${G%.*}
    R=$D/savestates/$G.resume.dss
    mkdir -p $D/savestates
    RLOAD=0
    if [ -f "$R" ]; then
        if [ -f "$D/backup/$G.dsv" ] && [ "$D/backup/$G.dsv" -nt "$R" ]; then rm -f "$R"; else RLOAD=1; fi
    fi
    export DSFLIP_RESUME_FILE="$R" DSFLIP_RESUME_LOAD=$RLOAD
fi
# the settings screen's choices (KEY=value lines), exported to SuperDrastic
if [ -f /data/banana/superdrastic.conf ]; then set -a; . /data/banana/superdrastic.conf; set +a; fi
# the 3D always through the Gengis Engine (no longer a setting; a DSFLIP_RAST=0 left in the file from before is overruled)
export DSFLIP_RAST=1
exec $SD/superdrastic-run $D/drastic "$1"
