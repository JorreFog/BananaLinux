#!/bin/sh
# Once per card: both panels' refresh as close to 60 Hz as their real pixel clock allows (banana-panel-tune reads
# the clock from the kernel and rewrites the timing in the boot DTB; from the next boot). The RG DS's DTB already
# has ROCKNIXDS's measured timing (60.0013 Hz) and is left alone; the RG DS Plus's is tuned here. The report is in
# /data/banana/panel-tune.txt; delete that file to tune again.
REPORT=/data/banana/panel-tune.txt
[ -f $REPORT ] && exit 0
sleep 5     # the panels lit and the menu up first
grep -qs ' /sys/kernel/debug ' /proc/mounts || mount -t debugfs debugfs /sys/kernel/debug
S=$(cat /run/banana/slot 2>/dev/null || echo a)     # the slot that booted
# this handheld's DTB: U-Boot names the board (a universal card has both DTBs, and the RG DS Plus's sorts first: an
# RG DS tuned it with its own clocks), else the slot's only one
case $(sed -n 's/.*banana\.board=\([^ ]*\).*/\1/p' /proc/cmdline) in
rgds-plus) DTB=/boot/$S/rk3568-anbernic-rg-ds-plus.dtb ;;
rgds) DTB=/boot/$S/rk3568-anbernic-rg-ds.dtb ;;
*) DTB= ;;
esac
[ -f "$DTB" ] || DTB=$(ls /boot/$S/rk3568-anbernic-*.dtb 2>/dev/null | head -n 1)
# Only the Rockchip boards have a panel this can tune: their DTBs carry the generic DSI driver's timing as text
# ("M clock=... horizontal=..."), which is what banana-panel-tune rewrites in place. The Retroid Pocket Classic's
# panel is a DRM driver with the timings in dtb properties (chipwealth,ch13726a), so there is nothing here for it
# to find -- and /boot has no business being remounted read-write for a board that cannot be tuned. Say so once (the
# report is also the marker: delete it to try again) and leave the card alone.
if [ ! -f "$DTB" ]; then
	{ date; echo "nothing to tune on this board: no rk3568-anbernic DTB in /boot/$S"; } > $REPORT
	rm -f $REPORT.new
	exit 0
fi
mount -o remount,rw /boot || { { date; echo "/boot can't be written"; } > $REPORT; exit 1; }
{ date; banana-panel-tune "$DTB"; } > $REPORT.new 2>&1 && mv $REPORT.new $REPORT
sync
mount -o remount,ro /boot
