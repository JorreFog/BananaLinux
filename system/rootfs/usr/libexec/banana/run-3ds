#!/bin/bash
# run-3ds <rom>: a Nintendo 3DS game through pocket-native -- the game's code
# recompiled for the handheld by a PC, run by the parts of an emulator it still
# needs. See docs/3DS.md.
#
#   the code:  the library a PC built, /data/pocket-native/games/<title id>/title.so
#   the game:  the ROM itself, under /data/roms/3ds (this gets it from the menu)
#
# The panels come to the game the way they do for Banana's other emulators
# (docs/EMULATORS.md): banana-ui closes its display before a launcher runs, so
# both are free and the game takes DRM master itself and gives them back on
# exit.
#
# Set BANANA_3DS_DEBUG=1 (or touch /data/pocket-native/debug) to also keep the
# kernel log and a memory trace while it runs, for a game that crashes or drags:
# /data/banana/logs/pocket-native.{kmsg,mem,smaps}.
dir="$(cd "$(dirname "$0")" && pwd)"
rom="$1"
[ -f "$rom" ] || { echo "run-3ds: no such game: $rom" >&2; exit 2; }
# the title id sits at offset 264 of the NCSD header
id=$(od -An -tx8 -j 264 -N 8 "$rom" | tr -d ' ' | tr 'a-f' 'A-F')
game="/data/pocket-native/games/$id"
data="$game/data"
if [ ! -f "$game/title.so" ]; then
    echo "run-3ds: $id has no recompiled library." >&2
    echo "run-3ds: build it on a PC and put it at /data/pocket-native/games/$id/ (docs/3DS.md)." >&2
    exit 1
fi
mkdir -p "$data" /data/pocket-native/config /data/banana/logs

# the first run writes the settings that work: the renderer's whole-surface GPU
# clears, GPU vertex arrays and cached meshes are off, which is what keeps this
# game's textures from flickering and the driver from faulting on the RG DS
# Plus. The in-game menu's Advanced settings own the file from then on.
if [ ! -f "$data/settings.toml" ]; then
    cat > "$data/settings.toml" <<'CONF'
[advanced]
gpu_clears = false
gpu_arrays = false
trust_meshes = false
CONF
fi

export ZAKURO_FAST=1 ZAKURO_KMS=1
export ZAKURO_DATA="$data"
export ZAKURO_RECOMPILED="$game/title.so"
export ZAKURO_SHADER_MANIFEST="$data/shaders.txt"
# the top panel's connector (DSI-2 on the RG DS Plus); the other is the bottom
export BANANA_TOP="${BANANA_TOP:-DSI-2}"
# Mesa's shader cache needs somewhere writable, the root being read-only
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/data/banana/cache}"
# the per-game tuning: the card's, else the profiles the image ships
if [ -d /data/pocket-native/titles ]; then
    export POCKET_NATIVE_TITLES=/data/pocket-native/titles
else
    export POCKET_NATIVE_TITLES=/usr/share/banana/pocket-native/titles
fi
export POCKET_NATIVE_CONFIG=/data/pocket-native/config

# the clock profile: a game gets the hardware, as the DS emulators do
[ -x /usr/bin/banana-perf ] && /usr/bin/banana-perf performance 2>/dev/null

# a game that crashes or drags leaves nothing behind otherwise: banana's own
# dmesg is taken at boot. Off unless asked for.
if [ -n "$BANANA_3DS_DEBUG" ] || [ -e /data/pocket-native/debug ]; then
    ( cat /dev/kmsg > /data/banana/logs/pocket-native.kmsg 2>/dev/null ) &
    KMESG=$!
    ( while :; do
        printf '%s ' "$(date +%s)"
        grep -E "^MemTotal|^MemAvailable|^Cached|^SwapFree" /proc/meminfo | tr '\n' ' '
        rss=0
        for d in /proc/[0-9]*; do
            [ "$(cat "$d/comm" 2>/dev/null)" = pocket-native ] || continue
            r="$(awk '/^VmRSS:/{print $2}' "$d/status" 2>/dev/null)"
            [ -n "$r" ] && rss=$((rss + r))
            awk '/^[0-9a-f]+-/ { name = ""; for (i = 6; i <= NF; i++) name = name (i > 6 ? " " : "") $i; if (name == "") name = "[anon]" }
                 /^Rss:/ { if ($2 + 0 > 0) printf "%d %s\n", $2, name }' "$d/smaps" 2>/dev/null | sort -rn | head -8 | tr '\n' '|' > /data/banana/logs/pocket-native.smaps
        done
        printf 'game_rss %s kB load %s\n' "$rss" "$(cut -d' ' -f1-3 /proc/loadavg)"
        sleep 3
      done ) > /data/banana/logs/pocket-native.mem 2>/dev/null &
    MEM=$!
fi

cd "$game"
# 3 is the menu's Reset: start the game again
while true; do
    /usr/bin/pocket-native "$rom" > "$data/log.txt" 2>&1
    status=$?
    [ "$status" -eq 3 ] || break
done
[ -n "$KMESG" ] && kill "$KMESG" "$MEM" 2>/dev/null
[ "$status" -ne 0 ] && echo "exit status $status" >> "$data/log.txt"

[ -x /usr/bin/banana-perf ] && /usr/bin/banana-perf balanced 2>/dev/null
exit 0
