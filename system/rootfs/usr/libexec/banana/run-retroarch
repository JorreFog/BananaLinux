#!/bin/sh
# The other systems: RetroArch with one libretro core, as a Wayland client in cage (a kiosk compositor: one
# application, fullscreen, and it turns the output with the panel's "panel orientation"), configuration and saves
# on the data partition.
#   run-retroarch <core> <rom>       e.g. run-retroarch gpsp /data/roms/gba/game.gba
CORE=/usr/lib/libretro/$1_libretro.so
# setting <key>: the card's value, else the image's template (a card from an older Banana, or a line taken out)
setting() {
    v=$(sed -n "s/^ *$1 *= *//p" /data/banana/settings.conf 2>/dev/null | tail -n 1)
    [ -n "$v" ] || v=$(sed -n "s/^ *$1 *= *//p" /etc/banana/settings.conf 2>/dev/null | tail -n 1)
    printf '%s' "$v"
}
# Settings > Other systems > the system's core (settings.conf's core.<system>, BANANA_SYSTEM from banana-ui): another
# installed core instead of systems.conf's, e.g. mGBA for the Game Boy Advance (RetroAchievements); one not installed is ignored
if [ -n "$BANANA_SYSTEM" ]; then
    c=$(setting "core.$BANANA_SYSTEM")
    [ -n "$c" ] && [ -f /usr/lib/libretro/${c}_libretro.so ] && CORE=/usr/lib/libretro/${c}_libretro.so
fi
[ -f "$CORE" ] || { echo "no core $1" >&2; exit 1; }
# the core that really runs, in banana-ui's log (its "starting" line names systems.conf's)
c=${CORE##*/}; c=${c%_libretro.so}
[ "$c" != "$1" ] && echo "run-retroarch: core $c (Settings > Other systems), not $1" >&2 || echo "run-retroarch: core $c" >&2
# The RPC's DSP: the frontend RetroArch opens has to be routed to the speaker I2S before the open, and the menu has
# just let go of that frontend (banana-ui closes its stream when a game starts). Setting it here as well as in rcS
# covers a library that was built without the rcS step, and a route the DSP dropped when the menu's stream closed.
if [ -d /proc/asound/card0 ]; then
    # the menu closed its stream a moment ago (its click sounds); the DSP tears that frontend's graph down
    # asynchronously, and an open in the middle of it leaves RetroArch with no device (its ALSA driver then aborts in
    # snd_pcm_avail, exit 134). Wait for the frontends to say they are free rather than guess a delay: how long the
    # DSP takes depends on what the menu was playing. Up to 1.2 s, then take the device anyway (the 134 retry below
    # still covers a graph that outlasts the wait).
    i=0
    while [ $i -lt 12 ]; do
        busy=
        for st in /proc/asound/card0/pcm*p/sub0/status; do
            [ -r "$st" ] || continue
            case "$(cat $st 2>/dev/null)" in
                RUNNING|SETUP|PREPARING|PREPARED|DRAINING|PAUSED) busy=1 ;;
            esac
        done
        [ -n "$busy" ] || break
        slept=1
        sleep 0.1; i=$((i + 1))
    done
    # A substream reads "closed" the moment banana-ui lets go of the frontend (its Sound::release() when a game
    # starts), but the DSP finishes tearing the graph down a beat later; an open inside that beat leaves the speaker
    # amplifiers answering "start failure (-1)" and the game silent -- measured on the RPC, and the reason it is not
    # enough to wait only while a substream still reads busy. So wait out the teardown every time.
    sleep 0.8
    # Write the route and, more to the point, make sure it *took*: the DSP refuses a mixer write until it is
    # ready, so amixer returning 0 is not proof, and an open while the mixer still reads off latches an unrouted
    # graph ("no backend DAIs enabled for MultiMedia1 Playback") that is silent for the game's whole life. The
    # value is bananad's published route, so headphones still route to the codec.
    routectl="SENARY_MI2S_RX Audio Mixer MultiMedia1"
    want=$(sed -n "s/^${routectl}=//p" /run/banana/audio-route 2>/dev/null | tail -n 1)
    [ -n "$want" ] || want=on,on
    i=0
    while [ $i -lt 25 ]; do
        amixer -q -c 0 cset "name=${routectl}" "$want" 2>/dev/null
        # The values are on the line starting with ": " -- the one above says ",values=2" (how many there are). A
        # pattern of "values=" alone takes both, so the read-back is "2 on" and never equals "on": every launch then
        # waits out the whole loop (15 s of black screen) before the game is even started.
        cur=$(amixer -c 0 cset "name=${routectl}" 2>/dev/null | sed -n 's/.*: *values=//p' | cut -d, -f1)
        [ "$cur" = "$(printf '%s' "$want" | cut -d, -f1)" ] && break
        sleep 0.2; i=$((i + 1))
    done
    amixer -q -c 0 sset "Left PCM" 90% 2>/dev/null
    amixer -q -c 0 sset "Right PCM" 90% 2>/dev/null
fi
CFG=/data/retroarch/retroarch.cfg
[ -f $CFG ] || { mkdir -p /data/retroarch; cp /etc/banana/retroarch.cfg $CFG; }
mkdir -p /data/saves /data/states /data/screenshots
# set_cfg <key> <value>: the file left alone when it has the line already (no rewrite of the card's file on every
# launch), else the key's lines dropped and the line added. The value never goes into a sed expression: a password
# with & | or \ in it grew or broke the line
set_cfg() {
    grep -qxF "$1 = \"$2\"" $CFG && return
    sed -i "/^$1 = /d" $CFG
    printf '%s = "%s"\n' "$1" "$2" >> $CFG
}
# The keys a game needs to be seen and heard at all, forced every start (not once): RetroArch writes this file back
# when it quits, so one trip through its own menus -- Video > Output > Video Driver, Audio > Output Device -- leaves a
# value the handheld cannot use, and the game then runs with no picture: a black panel over sound, with the menu gone
# behind it and nothing on screen to fix it with. A card written by another build drifts the same way. None of these
# are settings Banana shows (the screen, the shader, the latency and VSync come from settings.conf below); they are
# the frame the whole product is built on.
# The video driver follows the core: a libretro core's hardware context comes from RetroArch's video driver, so
# SwanStation's Vulkan renderer needs the Vulkan driver. Every other core keeps GL. The *context* driver and
# video_rotation follow the compositor: the game runs under cage (below), so RetroArch is a Wayland client
# (vk_wayland -- the Wayland surface, Turnip's VK_KHR_wayland_surface -- or wayland) and cage turns the output
# with the panel's "panel orientation", which leaves video_rotation at 0. A card with no cage falls back to
# RetroArch taking the panel itself: the khr_display/kms pair, and the RPC's 270 degrees, the turn the menu
# rotation patches (buildroot/patches/retroarch) are there to cover.
if [ -x /usr/bin/cage ]; then
	# glcore (GL3), not gl (GL2): under a Wayland compositor the GL2 driver dies with SIGSEGV and a corrupted
	# stack the moment it comes up (measured on the unit, every non-SwanStation core; the endpoint of the log is
	# the Wayland interface list, so it never gets as far as a frame). GL3 is the pairing the wayland context
	# driver is written for, and it comes up with GLES 3.2 on the Adreno through Mesa.
	vk_ctx=vk_wayland; gl_ctx=wayland; gl_drv=glcore; rot=0
else
	vk_ctx=khr_display; gl_ctx=kms; gl_drv=gl; rot=3
fi
if [ "$1" = swanstation ] && grep -q '^swanstation_GPU_Renderer = "Vulkan"' /data/retroarch/config/SwanStation/SwanStation.opt 2>/dev/null; then
	set_cfg video_driver vulkan
	set_cfg video_context_driver $vk_ctx
else
	set_cfg video_driver $gl_drv
	set_cfg video_context_driver $gl_ctx
fi
set_cfg video_rotation $rot
# the display server's own turn (Android, KMS): the same value, so a card left on the other path is consistent
set_cfg screen_orientation $rot
set_cfg video_fullscreen true
set_cfg input_driver udev
set_cfg audio_driver alsa
set_cfg audio_device default
# the ALSA sequencer: no /dev/snd/seq on this image (no sequencer built), and RetroArch's MIDI driver failing is two
# error lines in the log on every start and one more driver to go wrong
set_cfg midi_driver null
# A handheld with one panel has exactly one connector, and RetroArch numbers it 1 -- a card that still says 2 (a
# two-panel handheld's number, or from the Screen row this build doesn't show) sends RetroArch looking for a
# connector that isn't there,
# which is the black panel with the game running under it all over again.
n=0
for s in /sys/class/drm/card*-*/status; do
    [ -f "$s" ] || continue
    [ "$(cat $s 2>/dev/null)" = connected ] && n=$((n + 1))
done
[ "$n" -le 1 ] && set_cfg video_monitor_index 1
# Banana's choices over what RetroArch wrote on a card before they were in retroarch.cfg, once (a change made in
# RetroArch's menu afterwards is kept): A confirms and B goes back in its menu, F + Start quits with one press, and
# the N64 core's GLideN64 on its own thread (a few frames a second on a heavy N64 title, frame-buffer copies kept)
M=/data/retroarch/.banana-defaults-1
if [ ! -f $M ]; then
    set_cfg menu_swap_ok_cancel_buttons false
    set_cfg quit_press_twice false
    O=/data/retroarch/config/Mupen64Plus-Next/Mupen64Plus-Next.opt
    mkdir -p ${O%/*}
    grep -q '^mupen64plus-ThreadedRenderer = ' $O 2>/dev/null && sed -i 's|^mupen64plus-ThreadedRenderer = .*|mupen64plus-ThreadedRenderer = "True"|' $O || echo 'mupen64plus-ThreadedRenderer = "True"' >> $O
    touch $M
fi
# Shaders: Shaders > Load Preset opens the image's libretro GLSL presets (/usr/share/libretro/shaders/glsl), read
# where they are: copied to the card they took 238 MB (a few thousand small files in exFAT's large clusters) and a long
# first start. The Online Updater is shown (the core downloader not: cores come with the image).
S=/data/retroarch/.banana-shaders-1
if [ ! -f $S ]; then
    set_cfg video_shader_dir /usr/share/libretro/shaders/glsl
    set_cfg menu_show_online_updater true
    set_cfg menu_show_core_updater false
    touch $S
fi
# Settings > Other systems > Shader: RetroArch's global preset, a reference to one of the image's presets. Only a
# global.glslp Banana wrote (its first line) is changed or removed: one saved from RetroArch's own menu stays.
GP=/data/retroarch/config/global.glslp
look=$(setting ra_shader)
case $look in
lcd) SP=handheld/zfast-lcd.glslp ;;
crt) SP=crt/zfast-crt.glslp ;;
sharp) SP=interpolation/sharp-bilinear-simple.glslp ;;
*) SP= ;;
esac
ours() { head -n 1 $GP 2>/dev/null | grep -q '^# Banana'; }
if [ -n "$SP" ]; then
    if [ ! -f $GP ] || ours; then
        mkdir -p ${GP%/*}
        printf '# Banana: Settings > Other systems > Shader (%s)\n#reference "/usr/share/libretro/shaders/glsl/%s"\n' "$look" "$SP" > $GP
        set_cfg video_shader_enable true
    fi
elif ours; then
    rm -f $GP
    set_cfg video_shader_enable false
fi
# Settings > Other systems > Audio latency and VSync: Banana's values written into RetroArch's config before it starts
# (a change made in RetroArch's own menu afterwards is kept until the setting is changed here again)
lat=$(setting ra_audio_latency)
case $lat in 32|64) set_cfg audio_latency $lat ;; *) set_cfg audio_latency 64 ;; esac
vs=$(setting ra_vsync)
case $vs in on) set_cfg video_vsync true ;; off) set_cfg video_vsync false ;; esac
sc=$(setting ra_scale)
case $sc in on) set_cfg video_scale_integer true ;; off) set_cfg video_scale_integer false ;; esac
# Quick resume: the setting writes savestate_auto_save; loading the state at the start follows it
q=$(sed -n 's/^savestate_auto_save = "\(.*\)"/\1/p' $CFG | tail -n 1)
set_cfg savestate_auto_load ${q:-false}
# the RetroAchievements account from the setup (banana/accounts.conf) for RetroArch: its name in retroarch.cfg, but its
# password, and the token RetroArch gets with it, only in a config appended from /run, never in retroarch.cfg, which
# file sharing shows (it hides accounts.conf). What RetroArch saves of them on exit (a login in its own menu too) goes
# to accounts.conf instead, now and after the game.
A=/data/banana/accounts.conf
RA=/run/banana/retroarch-account.cfg
acct() { sed -n "s/^$1=//p" $A 2>/dev/null | head -n 1; }
/usr/libexec/banana/ra-secrets scrub    # (a card from before this, or a game cut short, kept them in retroarch.cfg)
u=$(acct ra_user)
(umask 077; : > $RA)
if [ -n "$u" ]; then
    set_cfg cheevos_enable true; set_cfg cheevos_username "$u"
    printf 'cheevos_password = "%s"\ncheevos_token = "%s"\n' "$(acct ra_password)" "$(acct ra_retroarch_token)" > $RA
elif [ -f $A ]; then
    set_cfg cheevos_enable false
fi
# anything RetroArch keeps that retroarch.cfg doesn't place (remaps, core options, playlists...) under the card's
# retroarch folder, not ~/.config on the read-only root
export HOME=/data/retroarch XDG_CONFIG_HOME=/data/retroarch
# cage (the kiosk compositor the game runs in) puts its socket here: a private, 0700 runtime dir on tmpfs.
export XDG_RUNTIME_DIR=/run/banana/wayland
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null; chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
# cage's seat (libseat's builtin backend: seatd, in this process) must not be VT-bound. This kernel has no virtual
# terminals at all (no fbcon, no /dev/tty1...), and a VT-bound seat opens one, puts it in VT_PROCESS mode and
# activates it. The kernel's own VT switch on suspend then waits for the VT's owner -- cage -- to release it, and
# bananad has the game's whole process group (cage included) SIGSTOPped by then, so nothing can answer and the
# suspend never returns. SEATD_VTBOUND=0 makes it a plain seat: the devices are opened, nothing is done to a VT
# that does not exist.
export SEATD_VTBOUND=0
# commands on its stdin (bananad's AUDIO_REINIT when the headphone jack changes), through a pipe held open here
# (fd 3) so RetroArch never reads an end
FIFO=/run/banana/retroarch.cmd
rm -f $FIFO; mkfifo -m 600 $FIFO && exec 3<>$FIFO
L=/run/banana/retroarch-stdin.cfg
printf 'stdin_cmd_enable = "true"\n' > $L
# RetroArch's ALSA driver aborts (SIGABRT, 134) when the DSP hasn't finished letting go of the frontend the menu
# had; a second start half a second later takes it. Two extra tries cover a slow teardown, and nothing else.
# Its own log goes on the card: the one thing worth having after a game that would not start is what RetroArch said
# last (RPC-TEST.md asks for logs/).
RL=/data/banana/logs/retroarch.log
mkdir -p /data/banana/logs 2>/dev/null
# The one before this launch stays, as $RL.1: a core that crashes takes its log with it (the file is reopened and
# truncated by the next launch), and the previous run's is what says what the last thing before the fault was.
[ -s $RL ] && mv -f $RL $RL.1
rm -f $RL
# A core that dies by signal is worth a core dump: the log stops where the log stops, while a dump says where. The
# kernel's pattern is "core", so this is RetroArch's own directory on the card (the root is read-only).
ulimit -c unlimited 2>/dev/null; cd /data 2>/dev/null
tries=0
while :; do
    # cage is a kiosk compositor: one application, fullscreen, and it turns the output with the panel (the
    # connector's "panel orientation" property, which wlroots reads) so RetroArch's menu, its OSD and the game
    # are all upright -- the per-driver rotation patches are not needed under it. Fall back to RetroArch on KMS
    # if cage is not there, so a card without it still runs.
    if [ -x /usr/bin/cage ]; then
        cage -- retroarch -v --config $CFG --appendconfig "$L|$RA" -L "$CORE" "$2" < $FIFO --log-file $RL &
    else
        retroarch -v --config $CFG --appendconfig "$L|$RA" -L "$CORE" "$2" < $FIFO --log-file $RL &
    fi
    P=$!
    # bananad's SIGUSR1 on the way out of a sleep goes here: cage re-modesets its output, because a panel its
    # driver turned off on the way down comes back dark and only a modeset clears it (Banana has no session
    # manager to hear about a resume). With no cage there is nothing to re-modeset, and the file goes away.
    if [ -x /usr/bin/cage ]; then echo $P > /run/banana/cage.pid; else rm -f /run/banana/cage.pid; fi
    trap 'kill -TERM $P 2>/dev/null' TERM INT HUP
    wait $P; S=$?
    while kill -0 $P 2>/dev/null; do wait $P; S=$?; done	# a trap interrupted the wait: until RetroArch has quit
    tries=$((tries + 1))
    [ $S -eq 134 ] && [ $tries -lt 3 ] || break
    echo "run-retroarch: RetroArch could not take the audio device, starting it again ($tries)" >&2
    sleep 0.5
done
/usr/libexec/banana/ra-secrets scrub; rm -f $RA
exec 3>&-; rm -f $FIFO
set_cfg stdin_cmd_enable false
exit $S
