#!/bin/sh
# The other systems: RetroArch with one libretro core, on its KMS driver (no compositor), configuration and saves
# on the data partition.
#   run-retroarch <core> <rom>       e.g. run-retroarch gpsp /data/roms/gba/game.gba
CORE=/usr/lib/libretro/$1_libretro.so
# setting <key>: the card's value, else the image's template (a card from an older Banana, or a line taken out)
setting() {
    v=$(sed -n "s/^ *$1 *= *//p" /data/banana/settings.conf 2>/dev/null | tail -n 1)
    [ -n "$v" ] || v=$(sed -n "s/^ *$1 *= *//p" /etc/banana/settings.conf 2>/dev/null | tail -n 1)
    printf '%s' "$v"
}
# Settings > Other systems > the system's core (settings.conf's core.<system>, BANANA_SYSTEM from banana-ui): another
# installed core instead of systems.conf's, e.g. mGBA for the Game Boy Advance (RetroAchievements); one not installed is ignored
if [ -n "$BANANA_SYSTEM" ]; then
    c=$(setting "core.$BANANA_SYSTEM")
    [ -n "$c" ] && [ -f /usr/lib/libretro/${c}_libretro.so ] && CORE=/usr/lib/libretro/${c}_libretro.so
fi
[ -f "$CORE" ] || { echo "no core $1" >&2; exit 1; }
# the core that really runs, in banana-ui's log (its "starting" line names systems.conf's)
c=${CORE##*/}; c=${c%_libretro.so}
[ "$c" != "$1" ] && echo "run-retroarch: core $c (Settings > Other systems), not $1" >&2 || echo "run-retroarch: core $c" >&2
CFG=/data/retroarch/retroarch.cfg
[ -f $CFG ] || { mkdir -p /data/retroarch; cp /etc/banana/retroarch.cfg $CFG; }
mkdir -p /data/saves /data/states /data/screenshots
# set_cfg <key> <value>: the file left alone when it has the line already (no rewrite of the card's file on every
# launch), else the key's lines dropped and the line added. The value never goes into a sed expression: a password
# with & | or \ in it grew or broke the line
set_cfg() {
    grep -qxF "$1 = \"$2\"" $CFG && return
    sed -i "/^$1 = /d" $CFG
    printf '%s = "%s"\n' "$1" "$2" >> $CFG
}
# Banana's choices over what RetroArch wrote on a card before they were in retroarch.cfg, once (a change made in
# RetroArch's menu afterwards is kept): A confirms and B goes back in its menu, F + Start quits with one press, and
# the N64 core's GLideN64 on its own thread (Super Mario 64 on an RG DS Plus: 40-50 frames a second, 55-60 with it,
# frame-buffer copies kept)
M=/data/retroarch/.banana-defaults-1
if [ ! -f $M ]; then
    set_cfg menu_swap_ok_cancel_buttons false
    set_cfg quit_press_twice false
    O=/data/retroarch/config/Mupen64Plus-Next/Mupen64Plus-Next.opt
    mkdir -p ${O%/*}
    grep -q '^mupen64plus-ThreadedRenderer = ' $O 2>/dev/null && sed -i 's|^mupen64plus-ThreadedRenderer = .*|mupen64plus-ThreadedRenderer = "True"|' $O || echo 'mupen64plus-ThreadedRenderer = "True"' >> $O
    touch $M
fi
# The N64 core's frame buffers at the N64's own resolution (GLideN64 "Native res. factor" 1x, the output still
# 640x480), once (a change in RetroArch's Core Options afterwards is kept). The Plus' Mali-G52 has one shader core and
# at 640x480 it is the limit: Banjo-Kazooie unthrottled made 64 VIs a second (68 in a cutscene), 50 with the
# synchronous colour copy Paper Mario's GLideN64 settings force; at 1x 126 (102 in the cutscene, 89 with that copy).
# NTSC games need 60. (Its own marker: .banana-defaults-2 is used by another branch.)
M=/data/retroarch/.banana-defaults-n64-1
if [ ! -f $M ]; then
    O=/data/retroarch/config/Mupen64Plus-Next/Mupen64Plus-Next.opt
    mkdir -p ${O%/*}
    sed -i '/^mupen64plus-EnableNativeResFactor = /d' $O 2>/dev/null
    echo 'mupen64plus-EnableNativeResFactor = "1"' >> $O
    touch $M
fi
# Shaders: Shaders > Load Preset opens the image's libretro GLSL presets (/usr/share/libretro/shaders/glsl), read
# where they are: copied to the card they took 238 MB (a few thousand small files in exFAT's large clusters) and a long
# first start. The Online Updater is shown (the core downloader not: cores come with the image).
S=/data/retroarch/.banana-shaders-1
if [ ! -f $S ]; then
    set_cfg video_shader_dir /usr/share/libretro/shaders/glsl
    set_cfg menu_show_online_updater true
    set_cfg menu_show_core_updater false
    touch $S
fi
# Settings > Other systems > Shader: RetroArch's global preset, a reference to one of the image's presets. Only a
# global.glslp Banana wrote (its first line) is changed or removed: one saved from RetroArch's own menu stays.
GP=/data/retroarch/config/global.glslp
look=$(setting ra_shader)
case $look in
lcd) SP=handheld/zfast-lcd.glslp ;;
crt) SP=crt/zfast-crt.glslp ;;
sharp) SP=interpolation/sharp-bilinear-simple.glslp ;;
*) SP= ;;
esac
ours() { head -n 1 $GP 2>/dev/null | grep -q '^# Banana'; }
if [ -n "$SP" ]; then
    if [ ! -f $GP ] || ours; then
        mkdir -p ${GP%/*}
        printf '# Banana: Settings > Other systems > Shader (%s)\n#reference "/usr/share/libretro/shaders/glsl/%s"\n' "$look" "$SP" > $GP
        set_cfg video_shader_enable true
    fi
elif ours; then
    rm -f $GP
    set_cfg video_shader_enable false
fi
# Settings > Other systems > Audio latency and VSync: Banana's values written into RetroArch's config at every start
# (so these two follow Settings: a change made to them in RetroArch's own menu lasts until the game quits)
lat=$(setting ra_audio_latency)
case $lat in 32|64|128) set_cfg audio_latency $lat ;; esac
vs=$(setting ra_vsync)
case $vs in on) set_cfg video_vsync true ;; off) set_cfg video_vsync false ;; esac
# Quick resume: the setting writes savestate_auto_save; loading the state at the start follows it
q=$(sed -n 's/^savestate_auto_save = "\(.*\)"/\1/p' $CFG | tail -n 1)
set_cfg savestate_auto_load ${q:-false}
# Settings > Sleep & power > Power off after sleeping: bananad saved this game in RetroArch's automatic slot (the state
# slot turned down to -1, SAVE_STATE, QUIT) and shut down, and banana-ui started it again at the next boot
# (/run/banana/resume-once names it): the automatic state loaded this once, Quick resume on or off
ONCE=0
[ "$(cat /run/banana/resume-once 2>/dev/null)" = "${BANANA_ROM:-$2}" ] && { ONCE=1; rm -f /run/banana/resume-once; echo "run-retroarch: resuming after Power off after sleeping" >&2; }
# (the slot as it was before the game: bananad's save leaves -1, the automatic one, and RetroArch writes it on exit)
SLOT=$(sed -n 's/^state_slot = "\(-*[0-9]*\)"/\1/p' $CFG | tail -n 1); SLOT=${SLOT:-0}
# the RetroAchievements account from the setup (banana/accounts.conf) for RetroArch: its name in retroarch.cfg, but its
# password, and the token RetroArch gets with it, only in a config appended from /run, never in retroarch.cfg, which
# file sharing shows (it hides accounts.conf). What RetroArch saves of them on exit (a login in its own menu too) goes
# to accounts.conf instead, now and after the game.
A=/data/banana/accounts.conf
RA=/run/banana/retroarch-account.cfg
acct() { sed -n "s/^$1=//p" $A 2>/dev/null | head -n 1; }
/usr/libexec/banana/ra-secrets scrub    # (a card from before this, or a game cut short, kept them in retroarch.cfg)
u=$(acct ra_user)
(umask 077; : > $RA)
if [ -n "$u" ]; then
    set_cfg cheevos_enable true; set_cfg cheevos_username "$u"
    printf 'cheevos_password = "%s"\ncheevos_token = "%s"\n' "$(acct ra_password)" "$(acct ra_retroarch_token)" > $RA
elif [ -f $A ]; then
    set_cfg cheevos_enable false
fi
# Settings > Other systems > RetroArch hotkeys, Off: no F + button shortcuts but the two needed to get out, F + X (the
# menu) and F + Start (quit). RetroArch's hotkeys come from the joypad's autoconfig profile, and a hotkey "unbound" in
# its menu (nul in retroarch.cfg) falls back to the profile's, which is why one can't be taken away there; so
# RetroArch gets a copy of the profiles with the other hotkeys left out, and every hotkey in retroarch.cfg as nul
# (one bound to a face button in its menu, the A that stopped working, goes too). What it saves of those on exit is
# put back below.
HOTKEYS="ai_service audio_mute cheat_index_minus cheat_index_plus cheat_toggle close_content desktop_menu_toggle
disk_eject_toggle disk_next disk_prev fps_toggle frame_advance game_focus_toggle grab_mouse_toggle halt_replay
hold_fast_forward hold_slowmotion load_state netplay_fade_chat_toggle netplay_game_watch netplay_host_toggle
netplay_ping_toggle netplay_player_chat next_replay_checkpoint osk_toggle overlay_next pause_toggle play_replay
preempt_toggle prev_replay_checkpoint record_replay recording_toggle replay_slot_decrease replay_slot_increase reset
rewind runahead_toggle save_replay_checkpoint save_state screenshot shader_hold shader_next shader_prev shader_toggle
state_slot_decrease state_slot_increase streaming_toggle toggle_fast_forward toggle_fullscreen toggle_slowmotion
toggle_statistics toggle_vrr_runloop turbo_fire_toggle volume_down volume_up"
HK=/run/banana/retroarch-hotkeys.cfg
HKA=
# the lines kept for putting back, on the card (synced) so that a run cut short (power lost, a hang after RetroArch
# saved its settings) is put right at the next start: else retroarch.cfg kept the autoconfig folder in /run, gone
# after a restart, and the pad had no profile and no way out but the touch tiles
KEEP=/data/retroarch/.banana-hotkeys.keep
names=$(echo $HOTKEYS | tr ' ' '|')
HKKEYS="^(joypad_autoconfig_dir|input_($names|enable_hotkey|menu_toggle|exit_emulator)_(btn|axis)) = "
if [ -f $KEEP ]; then
    sed -i -E "/$HKKEYS/d" $CFG && cat $KEEP >> $CFG && rm -f $KEEP && sync
    echo "run-retroarch: the hotkey lines of a run cut short put back" >&2
fi
grep -q '^joypad_autoconfig_dir = "/run/' $CFG && set_cfg joypad_autoconfig_dir /usr/share/libretro/autoconfig
rm -f $HK
if [ "$(sed -n 's/^ra_hotkeys *= *//p' /data/banana/settings.conf 2>/dev/null | tail -n 1)" = off ]; then
    AC=/run/banana/ra-autoconfig
    rm -rf $AC; mkdir -p $AC/udev
    for f in /usr/share/libretro/autoconfig/udev/*.cfg; do
        grep -vE "^input_($names)_(btn|axis) *=" "$f" > $AC/udev/${f##*/}
    done
    {
        echo "joypad_autoconfig_dir = \"$AC\""
        for h in $HOTKEYS enable_hotkey menu_toggle exit_emulator; do printf 'input_%s_btn = "nul"\ninput_%s_axis = "nul"\n' $h $h; done
    } > $HK
    grep -E "$HKKEYS" $CFG > $KEEP.new && mv $KEEP.new $KEEP && sync
    HKA="|$HK"
fi
# anything RetroArch keeps that retroarch.cfg doesn't place (remaps, core options, playlists...) under the card's
# retroarch folder, not ~/.config on the read-only root
export HOME=/data/retroarch XDG_CONFIG_HOME=/data/retroarch
MON=$(sed -n 's/^video_monitor_index = "\([0-9]\)"/\1/p' $CFG | tail -n 1)
if [ -n "$BANANA_DRM_LEASE_FD" ]; then
    # the game panel (banana-ui keeps the other panel): RetroArch draws on the panel it was lent (a DRM lease, its
    # only connector, so monitor 1, through banana-leaseshim.so), takes banana-ui's tiles as commands on its stdin,
    # and logs what its RetroAchievements client does for the panel to show. What RetroArch saves of these on exit is
    # put back below.
    L=/run/banana/retroarch-panel.cfg
    printf 'video_monitor_index = "1"\nstdin_cmd_enable = "true"\n' > $L
    [ $ONCE = 1 ] && echo 'savestate_auto_load = "true"' >> $L
    rm -f /run/banana/retroarch.log
    # the Pokemon companion (Settings > Other systems): RetroArch's stdout, where it answers the panel's
    # READ_CORE_MEMORY commands, into the pipe banana-ui reads (its log goes to the file above, not there)
    if [ -n "$BANANA_RA_OUT" ] && [ -p "$BANANA_RA_OUT" ]; then exec 4>"$BANANA_RA_OUT"; else exec 4>&1; fi
    LD_PRELOAD=/usr/lib/banana/banana-leaseshim.so retroarch --config $CFG --appendconfig "$L|$RA$HKA" --verbose \
        --log-file /run/banana/retroarch.log -L "$CORE" "$2" < "${BANANA_RA_CMD:-/dev/null}" >&4 &
    P=$!
    exec 4>&-
else
    # the panel RetroArch doesn't use (video_monitor_index: 2 the top, 1 the bottom) stays dark while the game runs
    . /usr/libexec/banana/one-panel
    case ${MON:-2} in 2) one_panel_dark top ;; *) one_panel_dark bottom ;; esac
    # commands on its stdin here too (bananad's AUDIO_REINIT when the headphone jack changes), through the pipe the
    # game panel uses; held open here (fd 3) so RetroArch never reads an end
    FIFO=/run/banana/retroarch.cmd
    rm -f $FIFO; mkfifo -m 600 $FIFO && exec 3<>$FIFO
    L=/run/banana/retroarch-stdin.cfg
    printf 'stdin_cmd_enable = "true"\n' > $L
    [ $ONCE = 1 ] && echo 'savestate_auto_load = "true"' >> $L
    retroarch --config $CFG --appendconfig "$L|$RA$HKA" -L "$CORE" "$2" < $FIFO &
    P=$!
fi
trap 'kill -TERM $P 2>/dev/null' TERM INT HUP
wait $P; S=$?
while kill -0 $P 2>/dev/null; do wait $P; S=$?; done	# a trap interrupted the wait: until RetroArch has quit
/usr/libexec/banana/ra-secrets scrub; rm -f $RA
[ -n "$SLOT" ] && [ "$SLOT" != -1 ] && grep -qx 'state_slot = "-1"' $CFG && set_cfg state_slot "$SLOT"
[ $ONCE = 1 ] && set_cfg savestate_auto_load ${q:-false}
if [ -n "$HKA" ]; then
    # the hotkey lines as they were before the game (RetroArch wrote the Off ones into retroarch.cfg on exit)
    sed -i -E "/$HKKEYS/d" $CFG
    cat $KEEP >> $CFG
    rm -f $HK $KEEP
fi
if [ -n "$BANANA_DRM_LEASE_FD" ]; then
    set_cfg video_monitor_index ${MON:-2}
    set_cfg stdin_cmd_enable false
else
    exec 3>&-; rm -f $FIFO
    set_cfg stdin_cmd_enable false
    one_panel_restore
fi
exit $S
