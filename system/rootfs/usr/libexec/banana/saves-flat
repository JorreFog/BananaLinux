#!/bin/sh
# One flat save folder for RetroArch and BananaFront: /data/saves (and /data/saves/gba for every GBA
# core, /data/saves/nds for the DS). Before 0.5.3 RetroArch's sort_savefiles_enable left each core's saves in
# /data/saves/<core>/; Home server sync writes and reads the flat paths, so those saves were invisible to it.
# Run by the launchers before they start a core, and by the Home server's sync (under save.lock) before it decides
# anything: a core folder's save moves (newest wins) to the flat path, and the old file goes to
# /data/banana/saves-legacy/<core>/ as a backup. A run that moved everything writes a marker in /run/banana, so it
# is once per boot; a failure, or two saves it can't give to one game, leaves the old file and writes no marker, so
# the next start or sync of the same boot tries again, and the next boot's.
# The flat saves are written beside their names (save-put.sh's names), the card synced, then renamed over and the card
# synced again, so a power cut leaves no half-written save under the name the cores read, and only then do the core
# folder's own files leave it. A core folder's saves go together: the card is synced twice for the folder, not twice
# for each save, which on a card with a few hundred of them kept the first game after the update, or the first sync,
# waiting on hundreds of whole-card syncs. Folder by folder and not all at once, since a save a later folder has too
# is weighed against the flat one the earlier folder left.
#
# (BANANA_DATA / BANANA_RUN / BANANA_SYSTEMS: the tests' made-up card.)
DATA=${BANANA_DATA:-/data}
RUN=${BANANA_RUN:-/run/banana}
SYSTEMS=${BANANA_SYSTEMS:-/etc/banana/systems.conf}
MARK=$RUN/saves-flat
case $0 in */*) . "${0%/*}/save-put.sh" ;; *) . /usr/libexec/banana/save-put.sh ;; esac
[ -f "$MARK" ] && exit 0
[ -d "$DATA/saves" ] || exit 0
IDS=$(sed -n 's/^\[\(.*\)\]$/\1/p' "$SYSTEMS" 2>/dev/null)
FAIL=0
# blank <file> <folder>: no save in it, as the save sync tells one (banana-sync blank, as gba-seed asks it: only 0xff or
# only 0x00 bytes, or nothing at all, and what that core writes fresh, Snes9x's 0x60 fill, PCSX-ReARMed's formatted
# card, Mupen64Plus-Next's new save; folder: the core's, or none for a flat save, which may be any core's). The sync
# counts such a file as no save, so one weighed here as a save would go over the real one by its time alone. Without
# banana-sync to ask (it answers 0 or 1), the bytes alone: only 0xff or only 0x00 (counted, not compared: the shell
# drops a NUL from $(...))
blank() {
    banana-sync blank "$1" "$2" 2>/dev/null; _b=$?
    case $_b in 0|1) return $_b ;; esac
    [ "$(tr -d '\377' < "$1" | head -c 1 | wc -c)" = 0 ] || [ "$(tr -d '\000' < "$1" | head -c 1 | wc -c)" = 0 ]
}
# where each system's games are (its "folder", or its id: "<id> <folder>" lines), on this card and on the second one
# (sd2 names its roms folder in $RUN/sd2/roms while it is in)
FOLDERS=$(awk '/^\[/{if(id!="")print id "\t" (f!=""?f:id); id=substr($0,2,length($0)-2); f=""} /^folder *=/{sub(/^folder *= */,""); f=$0}
    END{if(id!="")print id "\t" (f!=""?f:id)}' "$SYSTEMS" 2>/dev/null)
ROOTS=$DATA/roms
r=$(cat "$RUN/sd2/roms" 2>/dev/null); [ -n "$r" ] && [ -d "$r" ] && ROOTS="$ROOTS
$r"
# systems_of <name>: the systems that have a game called <name> (any extension: a .zip too), in their folder or one
# folder down, a line each (the name quoted: brackets and the like in it are the name's, not a pattern)
systems_of() {
    printf '%s\n' "$FOLDERS" | while IFS='	' read -r _id _fo; do
        case $_fo in ''|/*) continue ;; esac
        printf '%s\n' "$ROOTS" | while read -r _r; do
            for _g in "$_r/$_fo/$1".* "$_r/$_fo"/*/"$1".*; do [ -e "$_g" ] && { echo "$_id"; exit; }; done
        done
    done
}
# dest_of <core folder> <save>: the folder the save belongs in. Every GBA core's save is in the one GBA folder, anything
# else is a RetroArch system save, flat. A core that runs more than one system (mGBA and VBA-M: the GBA, Game Boy and
# Game Boy Color) has each system's saves in its one folder, so the game's own folder decides: a Game Boy (Color) game's
# save is flat. With no game found it goes where it always did, the GBA's: a GB save and a GBA save can't be told apart
# by their bytes or size (both 8, 32 or 128 KB), and the game can be put back in its folder to find it again.
dest_of() {
    case $1 in
    mGBA|"VBA-M")
        _s=$(systems_of "${2%.*}")
        if echo "$_s" | grep -qx gba; then echo "$DATA/saves/gba"
        elif echo "$_s" | grep -qxE 'gbc?'; then echo "$DATA/saves"
        else echo "$DATA/saves/gba"; fi ;;
    gpSP|"VBA Next"|Meteor) echo "$DATA/saves/gba" ;;
    *) echo "$DATA/saves" ;;
    esac
}
# core <folder name>: whether saves/<folder> is a core's save folder
core() {
    echo "$IDS" | grep -Fxq "$1" && return 1	# (gba, nds, psx... are systems, not cores)
    # (not a core's save folder: cdata is PICO-8's cart data, which BananaFront and fake-08 read from saves/cdata -
    # moved flat, a PICO-8 game would start without it)
    case $1 in cdata) return 1 ;; esac
    return 0
}
# legacy <file>: a core folder's file, done with, to the backup of its folder ($d) (one already there from an earlier
# move is never overwritten: the new one gets the time in its name)
legacy() {
    _b="$DATA/banana/saves-legacy/$d/${1##*/}"
    [ -e "$_b" ] && _b="$_b.$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$DATA/banana/saves-legacy/$d" 2>/dev/null && mv -f "$1" "$_b" || FAIL=1
}
# flush <written beside> <flat name> <core folder's file>...: a core folder's saves, each written beside its flat name,
# put under those names: the card synced, each renamed over, the card synced again, then the core folder's files to
# the backup. One that can't be renamed stays in its core folder, as do all of them when the card can't be synced
flush() {
    [ $# -gt 0 ] || return 0
    if ! sync; then
        while [ $# -gt 0 ]; do rm -f "$1"; shift 3; done
        FAIL=1; return
    fi
    _n=$(($# / 3))
    while [ "$_n" -gt 0 ]; do
        if mv -f "$1" "$2"; then set -- "$@" "$3"; else rm -f "$1"; FAIL=1; fi
        shift 3; _n=$((_n - 1))
    done
    sync || { FAIL=1; return; }
    for _f; do legacy "$_f"; done
}
SEEN=	# the core folders done, a line each
for dir in "$DATA"/saves/*/; do
    [ -d "$dir" ] || continue
    d=${dir%/}; d=${d##*/}
    core "$d" || continue
    set --	# (the folder's saves written beside their flat names, for flush)
    for f in "$dir"*; do
        [ -f "$f" ] || continue
        n=${f##*/}
        dest=$(dest_of "$d" "$n")
        # another core folder with a save of this name for the same flat folder: one game played in two cores (a
        # system that has a game of that name, and only one: the newer save is taken, as below), or two games of
        # different systems (FCEUmm's NES Pac-Man and Gambatte's Game Boy one) that a flat folder can't keep apart, or
        # no game found to tell. Those stay in their core folders, as RetroArch had them, said once in banana-ui's log;
        # no marker, so a later boot tries again (the game put back, or one of the saves taken away). (Not for
        # saves/gba: its cores are all one system's.)
        if [ "$dest" = "$DATA/saves" ]; then
            others= first=1
            for o in "$DATA"/saves/*/; do
                o=${o%/}; o=${o##*/}
                [ "$o" != "$d" ] && [ -f "$DATA/saves/$o/$n" ] && core "$o" && [ "$(dest_of "$o" "$n")" = "$dest" ] || continue
                others="$others, $o"
                printf '%s\n' "$SEEN" | grep -Fxq "$o" && first=
            done
            if [ -n "$others" ] && [ "$(systems_of "${n%.*}" | wc -l)" != 1 ]; then
                [ -n "$first" ] && echo "saves-flat: $n is in saves/$d$others: not one game's (two systems have a game of that name, or none does), so they stay where they are" >&2
                FAIL=1
                continue
            fi
        fi
        mkdir -p "$dest" 2>/dev/null || { FAIL=1; continue; }
        # the core's save goes flat when there is none there, when it is newer, and always over a blank one; never a
        # blank one over a save with data in it (gpSP's real save, then mGBA's empty file of it a day later)
        take=
        # (the flat folder's save may be any core's; saves/gba's is a GBA core's)
        df=; [ "$dest" = "$DATA/saves" ] || df=${dest##*/}
        if [ ! -e "$dest/$n" ]; then take=1
        elif blank "$f" "$d"; then blank "$dest/$n" "$df" && [ "$f" -nt "$dest/$n" ] && take=1
        elif blank "$dest/$n" "$df" || [ "$f" -nt "$dest/$n" ]; then take=1
        fi
        if [ -n "$take" ]; then
            # (the flat save it replaces is kept too: saves-legacy/replaced/, never overwritten)
            if [ -e "$dest/$n" ]; then
                r="$DATA/banana/saves-legacy/replaced/${dest#$DATA/saves}/$n"
                [ -e "$r" ] && r="$r.$(date +%Y%m%d-%H%M%S)"
                mkdir -p "${r%/*}" 2>/dev/null && cp -p "$dest/$n" "$r" || { FAIL=1; continue; }
            fi
            stale_tmps saves-flat "$dest/$n.saves-flat."*.tmp
            t="$dest/$n.saves-flat.$$.tmp"
            if cp -p "$f" "$t"; then
                set -- "$@" "$t" "$dest/$n" "$f"
            else
                rm -f "$t"
                FAIL=1
            fi
            continue
        fi
        legacy "$f"
    done
    flush "$@"
    SEEN="$SEEN
$d"
done
if [ $FAIL = 0 ]; then
    touch "$MARK"
    sync
fi
exit 0
