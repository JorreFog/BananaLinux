#!/bin/sh
# Nintendo DS: the emulator chosen in Settings > Nintendo DS > Emulator (banana/settings.conf nds_emulator:
# superdrastic or bananads). Each emulator has its own launcher with the same contract (docs/EMULATORS.md):
# run-drastic (DraStic through SuperDrastic) and run-bananads (BananaDS).
#   run-nds <rom>
# A game can have its own (the library's X on a DS game): /data/banana/nds-per-game.conf, "<rom file name> = <emulator>"
# per line, the name as on the card (a zipped game's is the .zip's), without its folder; the last line for it counts.
want=$(awk -v k="${1##*/}" '/^#/ { next } match($0, / *= *[a-z]+[ \t\r]*$/) {
	v = substr($0, RSTART); gsub(/[ =\t\r]/, "", v); if (substr($0, 1, RSTART - 1) == k) w = v } END { print w }' \
	/data/banana/nds-per-game.conf 2>/dev/null)
[ -n "$want" ] && echo "run-nds: ${1##*/} has its own emulator: $want" >&2
[ -n "$want" ] || want=$(sed -n '/^ *nds_emulator *= */{s///p;q}' /data/banana/settings.conf 2>/dev/null)
# A DSi game (DSiWare as .dsi, or as the 3DS eShop's .cia; a DSi-only cartridge's .nds, unit code 3 at 0x12): only
# BananaDS runs them (DraStic is a DS only), whatever the setting says
dsi=0
case $1 in
*.dsi|*.DSI|*.cia|*.CIA) dsi=1 ;;
*.nds|*.NDS) [ "$(od -An -tu1 -j18 -N1 "$1" 2>/dev/null | tr -d ' ')" = 3 ] && dsi=1 ;;
# a zipped one (run-bananads unpacks it): a .dsi or .cia in the zip, or its first .nds's unit code, read from the zip
# (BusyBox's unzip: only that .nds's first bytes are unpacked, od stops it there)
*.zip|*.ZIP)
    if unzip -l "$1" 2>/dev/null | grep -qiE '\.(dsi|cia)$'; then dsi=1
    elif [ "$(unzip -p "$1" '*.nds' '*.NDS' 2>/dev/null | od -An -tu1 -j18 -N1 2>/dev/null | tr -d ' ')" = 3 ]; then dsi=1; fi ;;
esac
if [ $dsi = 1 ] && [ "$want" != bananads ]; then
    echo "run-nds: ${1##*/} is a DSi game: BananaDS" >&2; want=bananads
fi
case $want in
bananads|superdrastic) ;;
*) want=superdrastic ;;
esac
case $want in
bananads) exec /usr/libexec/banana/run-bananads "$1" ;;
*) exec /usr/libexec/banana/run-drastic "$1" ;;
esac
