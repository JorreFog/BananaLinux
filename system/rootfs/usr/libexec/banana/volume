#!/bin/sh
# The volume of the card that plays now, in percent: the volume keys (bananad) and Settings > Volume both use this.
#   volume get              the level, 0-100
#   volume set <0-100>
#   volume up|down <n>      n percent louder or quieter, then the new level (as get prints it)
# bananad writes which card plays and its control to /run/banana/mixer ("<card> <control>"). The RPC's speakers are
# the two AW88166 amplifiers, whose controls the kernel exposes as "Left PCM" and "Right PCM" (a *gain*: 0 is mute,
# 511 is 0 dB, the loudest) rather than as one control named "PCM". bananad publishes them as "PCM"; a card that is
# the amplifier itself (id aw88166) answers to a single "PCM". Either way the level is amixer's own percent, so the
# same 0-100 the settings screen shows is what the keys set -- no private scale to get inverted.
read -r CARD CONTROL < /run/banana/mixer 2>/dev/null || exit 1
# the controls to drive, one per channel, separated by "|" (a control's name has spaces of its own)
CH=
case "$CONTROL" in
PCM)
    CH="Left PCM|Right PCM"
    ;;
*)
    if [ "$(cat /proc/asound/card$CARD/id 2>/dev/null)" = aw88166 ]; then
        if amixer -c $CARD sget "$CONTROL" >/dev/null 2>&1; then CH="$CONTROL"; else CH="Left PCM|Right PCM"; fi
    fi
    ;;
esac

# the level amixer reports for a control, in percent
percent() {
    amixer -c $CARD sget "$1" 2>/dev/null | sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -n 1
}

get() {
    if [ -n "$CH" ]; then
        IFS='|'; for c in $CH; do p=$(percent "$c"); [ -n "$p" ] && { echo "$p"; unset IFS; return; }; done
        unset IFS; exit 1
    fi
    percent "$CONTROL"
}
set_to() {
    p=$1; [ $p -lt 0 ] && p=0; [ $p -gt 100 ] && p=100
    if [ -n "$CH" ]; then
        IFS='|'; for c in $CH; do amixer -q -c $CARD sset "$c" $p% || { unset IFS; exit 1; }; done
        unset IFS
    else
        amixer -q -c $CARD sset "$CONTROL" $p% || exit 1
    fi
}

case $1 in
get) get ;;
set) set_to "${2:-0}" ;;
up|down)
    p=$(get); [ -n "$p" ] || exit 1
    n=${2:-5}; [ $1 = down ] && n=-$n
    set_to $((p + n))
    get   # (bananad's level card: no second run of this script for it)
    ;;
*) echo "volume get | set <0-100> | up <n> | down <n>" >&2; exit 2 ;;
esac
