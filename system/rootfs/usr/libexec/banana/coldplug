#!/bin/sh
# Every device the kernel found at boot gets its driver, as udev's coldplug would: the module each one's modalias
# names. The RG DS needs none of this (its drivers are built in, rcS loads the two modules it has); a board whose
# drivers are mostly modules (the AYN Thor: the haptics, the sensors, USB-C, the DSPs' clients) sets HW_COLDPLUG=1
# in its profile and rcS runs this after the menu is up. Devices that come later (USB pads) are bananad's.
#
#   coldplug            (quiet; the modules it loaded: /run/banana/coldplug.txt)
L=/run/banana/coldplug.txt
find /sys/devices -name modalias -type f 2>/dev/null | while read -r f; do cat "$f" 2>/dev/null; done | sort -u |
    while read -r a; do
        [ -n "$a" ] || continue
        modprobe -q "$a" 2>/dev/null && echo "$a"
    done > $L
exit 0
