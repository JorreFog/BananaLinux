#!/usr/bin/env python3
# bt-pair-bredr <MAC> [timeout s] [store dir] [adapter MAC]: pairs over classic Bluetooth (BR/EDR) through the kernel's management interface
# (Pair Device, address type BR/EDR, NoInputNoOutput), whatever bearer BlueZ found the device on. Headphones that
# advertise only over LE while in pairing mode get an LE pairing from bluetoothctl, with no link key for A2DP.
# bluetoothd sees the kernel's New Link Key event on its own control socket, but stores the key only when the kernel
# says to (store hint): headphones asking for "no bonding" get a key that is gone at the next start (the tester's
# AirPods: AuthenticationRejected after a reboot). So the key goes into bluetoothd's own store here too
# (<store>/<adapter>/<device>/info, [LinkKey]); bluetoothd reads it at its next start.
# Prints the events seen; last line "OK" or "ERROR <status>".
import ctypes, os, select, struct, sys, time

AF_BLUETOOTH, BTPROTO_HCI, HCI_CHANNEL_CONTROL, HCI_DEV_NONE = 31, 1, 3, 0xFFFF
STATUS = {0x00: "success", 0x03: "failed", 0x04: "connect failed", 0x08: "timeout",
          0x09: "already paired", 0x0a: "busy", 0x0b: "rejected", 0x0c: "not supported", 0x0d: "invalid params",
          0x0e: "disconnected", 0x0f: "not powered", 0x10: "cancelled", 0x05: "authentication failed"}
EVENTS = {0x0001: "cmd-complete", 0x0002: "cmd-status", 0x0009: "new-link-key", 0x000b: "connected",
          0x000c: "disconnected", 0x000d: "connect-failed", 0x000e: "pin-request", 0x000f: "user-confirm",
          0x0010: "user-passkey", 0x0011: "auth-failed"}

def store_key(mac, ktype, kval, pin):
    root = sys.argv[3] if len(sys.argv) > 3 else "/var/lib/bluetooth"
    ad = sys.argv[4] if len(sys.argv) > 4 else ""
    if not ad:
        ads = [d for d in os.listdir(root) if len(d) == 17 and d.count(":") == 5] if os.path.isdir(root) else []
        if len(ads) != 1: print("key not stored: adapter folder unknown", ads); return
        ad = ads[0]
    d = os.path.join(root, ad, mac)
    os.makedirs(d, mode=0o700, exist_ok=True)
    path = os.path.join(d, "info")
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    # the file without an older [LinkKey] section, then the new one
    out, skip = [], False
    for ln in lines:
        if ln.startswith("["): skip = ln.strip() == "[LinkKey]"
        if not skip: out.append(ln)
    while out and not out[-1].strip(): out.pop()
    if not any(ln.strip() == "[General]" for ln in out): out = ["[General]", "Trusted=true"] + ([""] + out if out else [])
    out += ["", "[LinkKey]", "Key=" + kval.hex().upper(), "Type=%d" % ktype, "PINLength=%d" % pin, ""]
    with open(path + ".new", "w") as f: f.write("\n".join(out))
    os.chmod(path + ".new", 0o600)
    os.rename(path + ".new", path)
    print("key stored in", path, flush=True)

def main():
    mac = sys.argv[1].upper()
    wait = float(sys.argv[2]) if len(sys.argv) > 2 else 40
    addr = bytes(int(x, 16) for x in reversed(mac.split(":")))
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.socket(AF_BLUETOOTH, 3 | 0o2000000, BTPROTO_HCI)	# SOCK_RAW | SOCK_CLOEXEC
    if fd < 0: print("ERROR socket:", os.strerror(ctypes.get_errno())); return 1
    sa = struct.pack("<HHH", AF_BLUETOOTH, HCI_DEV_NONE, HCI_CHANNEL_CONTROL)
    if libc.bind(fd, sa, len(sa)) < 0: print("ERROR bind:", os.strerror(ctypes.get_errno())); return 1
    # Pair Device (0x0019) on controller 0: address, type 0 (BR/EDR), IO capability 3 (NoInputNoOutput)
    os.write(fd, struct.pack("<HHH", 0x0019, 0, 8) + addr + bytes([0, 3]))
    end = time.time() + wait
    key = False
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], max(0, end - time.time()))
        if not r: break
        pkt = os.read(fd, 1024)
        ev, idx, ln = struct.unpack_from("<HHH", pkt)
        p = pkt[6:6 + ln]
        name = EVENTS.get(ev, "0x%04x" % ev)
        if ev in (0x0001, 0x0002):
            op, st = struct.unpack_from("<HB", p)
            print(name, "op 0x%04x" % op, "status", STATUS.get(st, hex(st)), flush=True)
            if op == 0x0019 and ev == 0x0001:
                print("OK" if st == 0 or (st == 0x09 and key) else "ERROR %s" % STATUS.get(st, hex(st)))
                return 0 if st == 0 else 1
            if op == 0x0019 and ev == 0x0002 and st != 0:
                print("ERROR %s" % STATUS.get(st, hex(st))); return 1
        else:
            if ev == 0x0009:
                key = True
                hint, kaddr, ktype, kval, pin = p[0], p[1:7], p[8], p[9:25], p[25]
                print(name, "store hint", hint, "type", ktype, flush=True)
                if kaddr == addr: store_key(mac, ktype, kval, pin)
            else: print(name, p[:16].hex(), flush=True)
    print("ERROR no answer in %.0f s" % wait)
    return 1

sys.exit(main())
