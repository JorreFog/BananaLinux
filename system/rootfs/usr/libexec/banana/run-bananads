#!/bin/sh
# Nintendo DS: BananaDS (docs/EMULATORS.md is the contract this launcher keeps). BananaDS takes every setting from
# the environment as BANANADS_<KEY> (its docs/SETTINGS.md: render.scale is BANANADS_RENDER_SCALE), over its own
# file /data/bananads/bananads.conf, so the places and the menu's choices are passed that way.
#   run-bananads <rom>
[ -x /usr/bin/bananads ] || { echo "BananaDS isn't installed" >&2; exit 1; }
D=/data/bananads                       # its settings (bananads.conf) and memory (cpugov/: per-game clocks)
L=/data/banana/logs/bananads           # its logs, readable on a computer
mkdir -p $D $L /data/saves/nds /data/states/nds
# what Banana gives every DS emulator, under the contract's names
export BANANADS_TOP=${BANANA_TOP:-DSI-2}         # the top panel's connector (the other connected panel is the bottom)
export BANANADS_TOUCH=${BANANA_TOUCH:-fe5e0000.i2c}  # the bottom panel's touchscreen (part of its sysfs path)
export BANANADS_DATA=$D BANANADS_LOGDIR=$L
# Mesa's shader cache on the data partition: started with HOME=/ (read-only) it had nowhere to keep it and compiled the
# shaders again at every start (QA-1); SuperDrastic's DraStic has HOME=/data/drastic
mkdir -p $D/shader-cache 2>/dev/null
export MESA_SHADER_CACHE_DIR=$D/shader-cache
export BANANADS_SAVES=/data/saves/nds BANANADS_STATES=/data/states/nds BANANADS_BIOS=/data/bios
# ...and as BananaDS's settings: the panels (frontend=kms: both screens straight onto them, its own CPU governor
# under banana-perf's "performance"), the saves and states, the log (the last session's kept as .1)
export BANANADS_FRONTEND=kms BANANADS_SAVE_DIR=/data/saves/nds BANANADS_STATE_DIR=/data/states/nds
[ -f $L/bananads.log ] && mv -f $L/bananads.log $L/bananads.1.log
export BANANADS_LOG_FILE=$L/bananads.log
# Settings > Nintendo DS with BananaDS chosen: its own settings, kept in its own file (bananads.conf, which BananaDS
# reads itself): the shader (kms.shader, SuperDrastic's shader pass on SuperDrastic's shader files), the 3D resolution
# (render.scale) and the rest. A card from before they were BananaDS's own gets DraStic's choices copied over once.
C=$D/bananads.conf
has() { grep -q "^ *$1 *=" $C 2>/dev/null; }
if ! has kms.shader; then
    shader=$(sed -n 's/^ *DSFLIP_SHADER *= *//p' /data/banana/superdrastic.conf 2>/dev/null | head -n 1)
    [ -n "$shader" ] && echo "kms.shader = $shader" >> $C
fi
if ! has render.scale; then
    dcfg=/data/drastic/config/drastic.cfg; [ -f $dcfg ] || dcfg=/usr/share/drastic/config/drastic.cfg
    hires=$(sed -n 's/^ *hires_3d *= *//p' $dcfg 2>/dev/null | head -n 1)
    [ "$hires" = 0 ] && echo "render.scale = 1" >> $C || echo "render.scale = 2" >> $C
fi
# Timing's Fast (core.slice = auto, the 2x default before 0.4.0) broke games (Golden Sun: Dark Dawn drew no 3D world):
# a card that has it gets Accurate once; choosing Fast again afterwards is kept
M=$D/.banana-slice-64
if [ ! -f $M ]; then
    grep -q '^ *core.slice *= *auto' $C 2>/dev/null && sed -i 's/^ *core.slice *= *auto.*/core.slice = 64/' $C
    touch $M
fi
# Microphone's values moved down in 0.4.0 (Medium's 0.15 stood far above a quiet room): a card that has an old one keeps
# its label once (Medium 0.15 -> 0.05, High 0.03 -> 0.02, Low 0.3 -> 0.15)
M=$D/.banana-mic-v2
if [ ! -f $M ]; then
    sed -i -e 's/^ *mic.threshold *= *0\.15 *$/mic.threshold = 0.05/' -e 's/^ *mic.threshold *= *0\.03 *$/mic.threshold = 0.02/' \
        -e 's/^ *mic.threshold *= *0\.3 *$/mic.threshold = 0.15/' $C 2>/dev/null
    touch $M
fi
# The microphone: BananaDS reads mic.source, mic.device and mic.threshold from bananads.conf (or the environment,
# which wins). A card with no mic keys gets source and threshold here once, so Settings owns them: source=device
# records the real microphone through ALSA's "default" (bananad points it at the rk817 in /run/banana/asound.conf),
# and threshold=0.05 is Settings' "Medium". Written to the file, never exported: an exported BANANADS_MIC_SOURCE or
# BANANADS_MIC_THRESHOLD would win over the file and freeze the settings screen's choices. A card that already
# names them (including source=none, Settings > Nintendo DS > Microphone Off) is left as it is. Before 0.4.3 the one
# Microphone row's Off wrote mic.threshold = 0, which BananaDS reads as "gate off" (every sound through): such a card
# gets source=none (what Off meant) and Medium's threshold instead.
M=$D/.banana-mic-src
if [ ! -f $M ]; then
    if ! has mic.source && grep -q '^ *mic\.threshold *= *0*\.\?0* *$' $C 2>/dev/null; then
        sed -i 's/^ *mic\.threshold *=.*/mic.threshold = 0.05/' $C
        echo "mic.source = none" >> $C
    fi
    has mic.source    || echo "mic.source = device"  >> $C
    has mic.threshold || echo "mic.threshold = 0.05" >> $C
    touch $M
fi
# mic.device is not a Settings choice, so it is enforced on every launch, not written once (a card left with
# another value kept it forever, which is how a mic stayed silent after the route was fixed). Only ALSA's "default"
# alias reaches bananad's capture plug (S16_LE stereo 48000): the plug resamples the 44.1 kHz mono both DS
# emulators open (BananaDS's in_thread, SuperDrastic's mic_thread), so the hardware stream runs at the playback's
# rate. A raw node (hw:0, plughw:0, hw:CARD=rk817hp) has no resampler: ALSA hands the card 44.1 kHz and the
# rk817's symmetric_rate I2S DAI refuses the second stream's hw_params, so in_thread finds no PCM, logs "no
# microphone" and exits. Anything but the alias (another firmware, an edit over file sharing) is rewritten here.
if has mic.device; then
    grep -q '^ *mic\.device *= *default *$' $C || sed -i 's|^ *mic\.device *=.*|mic.device = default|' $C
else
    echo "mic.device = default" >> $C
fi
# The route bananad writes is what makes "default" that plug. Verify the capture side is the 48 kHz plug, not the
# bare card: a missing file, or a capture.pcm that isn't the plug (the pre-fix "plughw:%d"), silently sends the
# mic past ALSA's resampler, the same failure this stanza exists to prevent.
if [ ! -e /run/banana/asound.conf ]; then
    echo "run-bananads: no /run/banana/asound.conf: bananad hasn't set the sound route" >&2
elif ! grep -q 'capture\.pcm *{ *type plug' /run/banana/asound.conf; then
    echo "run-bananads: /run/banana/asound.conf has a capture.pcm without the 48 kHz plug: the mic may not start" >&2
fi
# Settings > Nintendo DS > Low latency (experimental): bananads.conf's kms.lowlat (off, on, runahead1, runahead2),
# which BananaDS reads itself (its docs/SETTINGS.md): no frame queue, each frame aimed at the panels' refresh, and
# run-ahead. Said in the log, for a report that comes with one
ll=$(sed -n 's/^ *kms\.lowlat *= *//p' $C 2>/dev/null | tail -n 1)
[ -n "$ll" ] && [ "$ll" != off ] && echo "run-bananads: low latency (experimental): $ll" >&2
export DSFLIP_SHADER_DIR=/usr/lib/superdrastic/shaders
# the game's own microphone (its page, #27), for this run: off is mic.source = none (BananaDS's threshold 0 is "gate
# off", every sound through), the others the microphone on at that threshold
# (BananaDS's scale, as Settings' Mic sensitivity: low 0.15, medium 0.05, high 0.02)
m=$(/usr/libexec/banana/nds-game-option nds-per-game-mic.conf "$1")
case $m in low) t=0.15 ;; medium) t=0.05 ;; high) t=0.02 ;; off) t=off ;; *) t= ;; esac
if [ "$t" = off ]; then
    echo "run-bananads: ${1##*/} has its own microphone: off" >&2; export BANANADS_MIC_SOURCE=none
elif [ -n "$t" ]; then
    echo "run-bananads: ${1##*/} has its own microphone: $m ($t)" >&2; export BANANADS_MIC_SOURCE=device BANANADS_MIC_THRESHOLD=$t
fi
# the game's own shader (its page, X in the library: nds-game-shader), for this run only (the environment wins over
# bananads.conf)
s=$(/usr/libexec/banana/nds-game-shader "$1")
if [ -n "$s" ]; then echo "run-bananads: ${1##*/} has its own shader: $s" >&2; export BANANADS_KMS_SHADER=$s
else s=$(sed -n 's/^ *kms.shader *= *//p' $C 2>/dev/null | tail -n 1); fi
# a shader of your own (banana/shaders/<name>.frag, listed in Settings as "<name> (card)"): its folder instead
[ -n "$s" ] && [ -f "/data/banana/shaders/$s.frag" ] && export DSFLIP_SHADER_DIR=/data/banana/shaders
# the 3D always through the Gengis Engine (SuperDrastic's rasterizer), as SuperDrastic does
export BANANADS_RENDER_RENDERER=gengis
# Settings > Nintendo DS > Quick resume (settings.conf's quick_resume): off, a quit ends the game and the next start
# is from its title (no resume state written or loaded); bananad's SIGUSR1 (Power off after sleeping) still writes one,
# loaded at the boot after it
# Settings > Sleep & power > Power off after sleeping: bananad saved this game's resume state and shut down, and
# banana-ui started it again at the next boot (/run/banana/resume-once names it): the state loaded this once, Quick
# resume on or off
ONCE=0
[ "$(cat /run/banana/resume-once 2>/dev/null)" = "${BANANA_ROM:-$1}" ] && { ONCE=1; rm -f /run/banana/resume-once; echo "run-bananads: resuming after Power off after sleeping" >&2; }
if ! grep -q '^ *quick_resume *= *on' /data/banana/settings.conf 2>/dev/null; then
    export BANANADS_RESUME_ON_QUIT=off
    [ $ONCE = 1 ] || export BANANADS_RESUME_ON_START=off
fi
# the RetroAchievements account from the setup (banana/accounts.conf), for BananaDS's achievements (as run-drastic
# gives SuperDrastic's)
A=/data/banana/accounts.conf
if [ -f $A ]; then
    u=$(sed -n 's/^ra_user=//p' $A | head -n 1); w=$(sed -n 's/^ra_password=//p' $A | head -n 1)
    [ -n "$u" ] && export BANANADS_RA_USER="$u" BANANADS_RA_PASSWORD="$w"
fi
# the DS's user name: Settings > Nintendo DS > DS name's (bananads.conf's firmware.nickname, #30), else the handheld's
grep -q '^ *firmware\.nickname *= *[^ ]' $D/bananads.conf 2>/dev/null || export BANANADS_FIRMWARE_NICKNAME=${BANANADS_FIRMWARE_NICKNAME:-Banana}
# anything else for one run: /data/banana/bananads.env (KEY=value lines, BANANADS_* and MELONDS_*, exported; read,
# never run: kv-env), e.g. BANANADS_KMS_STATS=600
. /usr/libexec/banana/kv-env
kv_export /data/banana/bananads.env BANANADS_ MELONDS_
# an explicit BANANADS_MIC_DEVICE (bananads.env, or the environment a test set) wins over bananads.conf, so the
# enforced "mic.device = default" above does not reach it: a raw node here bypasses the plug the same way, made loud
case ${BANANADS_MIC_DEVICE:-} in
    ''|default) ;;
    *) echo "run-bananads: BANANADS_MIC_DEVICE=$BANANADS_MIC_DEVICE bypasses ALSA's 48 kHz plug: the mic may not start" >&2 ;;
esac
# the in-game save as DraStic left it, when it played the game last (nds-saves: the two emulators share saves); a
# quick resume state older than the save is dropped, as run-drastic does: loading it would put an older save back
/usr/libexec/banana/nds-saves "$1"
G=$(basename "$1"); G=${G%.*}
[ -f "/data/states/nds/$G.resume.mst" ] && [ -f "/data/saves/nds/$G.sav" ] && [ "/data/saves/nds/$G.sav" -nt "/data/states/nds/$G.resume.mst" ] &&
    rm -f "/data/states/nds/$G.resume.mst"
# a zipped game (the library lists .zip for the DS, DraStic opens them): BananaDS opens .nds only, so the zip's game is
# unpacked once into the card's cache, named after the zip (its saves and states then go by the name the menu shows),
# and unpacked again only when the zip is newer
ROM=$1
case "$ROM" in
*.zip|*.ZIP)
    C=/data/bananads/unzipped; mkdir -p $C
    N=$(basename "$ROM"); N=$C/${N%.*}.nds
    if [ ! -f "$N" ] || [ "$ROM" -nt "$N" ]; then
        rm -rf $C/*.nds $C/.unzip    # one game unpacked at a time: they are large
        mkdir -p $C/.unzip && unzip -q -o "$ROM" -d $C/.unzip
        E=$(find $C/.unzip -type f -iname '*.nds' | head -n 1)
        [ -n "$E" ] && mv -f "$E" "$N"; rm -rf $C/.unzip
        [ -f "$N" ] || { echo "no .nds in $ROM" >&2; exit 1; }
    fi
    ROM=$N ;;
esac
cd $D
exec /usr/bin/bananads "$ROM"
