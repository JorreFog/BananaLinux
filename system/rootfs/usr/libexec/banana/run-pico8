
#!/bin/sh

DIR=/data/roms/pico-8
WRAPPER_DIR="$DIR/bin"

# Create a wget-compatible wrapper using curl for HTTPS downloads.
mkdir -p "$WRAPPER_DIR"

cat > "$WRAPPER_DIR/wget" <<'EOF'
#!/bin/sh

out=""
url=""
postfile=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -q|--quiet)
            shift
            ;;
        -O|--output-document)
            out="$2"
            shift 2
            ;;
        --post-file)
            postfile="$2"
            shift 2
            ;;
        --post-file=*)
            postfile="${1#*=}"
            shift
            ;;
        -*)
            shift
            ;;
        *)
            url="$1"
            shift
            ;;
    esac
done

if [ -z "$url" ]; then
    exit 1
fi

if [ -n "$postfile" ]; then
    exec /usr/bin/curl -L -sS -o "$out" \
        --data-binary "@$postfile" "$url"
else
    exec /usr/bin/curl -L -sS -o "$out" "$url"
fi
EOF

chmod +x "$WRAPPER_DIR/wget"

# Make PICO-8 use our wrapper instead of BusyBox wget.
export PATH="$WRAPPER_DIR:$PATH"

# Original BananaOS PICO-8 environment.
export HOME="$DIR"
export SDL_VIDEODRIVER=kmsdrm
export SDL_AUDIODRIVER=alsa

# Launch PICO-8 in Splore.
exec "$DIR/pico8_64" \
    -home "$DIR" \
    -root_path "$DIR" \
    -joystick 0 \
    -splore
