#!/bin/sh
# Clock profiles. The menu draws a frame in a few milliseconds and sleeps in between, so it runs on the lowest
# clocks while it sits still; schedutil raises them only while an animation draws, up to the top clock (1992 MHz: the
# layout themes' home rows on the RG DS, frames over 16.7 ms of 300, Neon 51 -> 15, Comic 24 -> 0, Vinyl 26 -> 12;
# capped at 1416 before 0.5.0-beta.11, and at 1104 the transitions missed refreshes); a game gets the profile its
# system asks for (systems.conf's perf).
#   banana-perf ui | powersave | balanced | steady | performance | superdrastic
# steady: balanced's schedutil with a 1104 MHz floor, for an emulator that sleeps on every page flip (RetroArch with
# two swapchain images): between flips schedutil let the cores fall to 408-600 MHz and the next frame started slow;
# PlayStation's Silent Hill on an RG DS Plus missed 20-41 refreshes and the sound ran dry 3-6 times in 30 s, none
# with the floor (the average clock about the same, ~1.5 GHz).
# superdrastic: the "performance" governor, which the DS emulator's own governor takes over (SuperDrastic's, and
# BananaDS's port of it: the lowest clock at which the game drops no frames, per game, through scaling_max_freq,
# put back when the game ends); the GPU stays on demand.
# (no programs run, only the shell's builtins: it runs at every game's start and end, and each fork cost ~5 ms)
CPU=/sys/devices/system/cpu/cpufreq/policy0
GPU=
for g in /sys/class/devfreq/*.gpu; do [ -e "$g" ] && { GPU=$g; break; }; done
[ -d $CPU ] || exit 0
read -r freqs < $CPU/scaling_available_frequencies 2>/dev/null
read -r lo < $CPU/cpuinfo_min_freq; read -r hi < $CPU/cpuinfo_max_freq
# the highest available frequency at or under $1 kHz
cap() { best=$lo; for f in $freqs; do [ $f -le $1 ] && [ $f -gt $best ] && best=$f; done; }
cpu() {   # cpu <governor> <max kHz> [min kHz]
    echo ${3:-$lo} > $CPU/scaling_min_freq
    echo $2 > $CPU/scaling_max_freq
    echo $1 > $CPU/scaling_governor
}
gpu() { [ -n "$GPU" ] && echo $1 > $GPU/governor 2>/dev/null; }
case $1 in
ui)           cpu schedutil $hi; gpu powersave ;;   # (schedutil: the top clock only while an animation draws)
powersave)    cap 1416000; cpu schedutil $best; gpu simple_ondemand ;;
balanced)     cpu schedutil $hi; gpu simple_ondemand ;;
steady)       cap 1104000; cpu schedutil $hi $best; gpu simple_ondemand ;;
performance)  cpu performance $hi; gpu performance ;;
superdrastic) cpu performance $hi; gpu simple_ondemand ;;
*) echo "usage: banana-perf ui|powersave|balanced|steady|performance|superdrastic" >&2; exit 1 ;;
esac
exit 0
