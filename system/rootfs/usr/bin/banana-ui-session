#!/bin/sh
# The menu, with its log on the data partition (the last two runs) so a problem can be read on a computer.
# Kernel parameters (extlinux.conf's APPEND, or tools/qemu-boot.sh): banana.console=1 sends the log to the console
# (the RG DS's UART, QEMU's serial) instead; banana.top=<connector> names the top panel's connector (DSI-2) and
# banana.touch=<device> the bottom panel's touchscreen (part of its sysfs path), for a display other than the RG DS's.
LOG=/data/banana/logs/banana-ui.log
mkdir -p /data/banana/logs 2>/dev/null && touch $LOG.w 2>/dev/null && rm -f $LOG.w || LOG=/run/banana/banana-ui.log
for a in $(cat /proc/cmdline); do
    case $a in
    banana.console=1) LOG=/dev/console ;;
    banana.top=*) export BANANA_TOP=${a#*=} ;;
    banana.touch=*) export BANANA_TOUCH=${a#*=} ;;
    esac
done
[ "$LOG" != /dev/console ] && [ -f $LOG ] && mv -f $LOG $LOG.1
# the systems list: the built-in one with the card's banana/systems.conf merged over it per system (systems-merge;
# a card file it can't read is left out, and said so in this log)
/usr/libexec/banana/systems-merge 2>> $LOG
[ -s /run/banana/systems.conf ] && export BANANA_SYSTEMS=/run/banana/systems.conf
# the Game & Watch games' names and covers, from MAME and the card's artwork (gw-meta: in the background, only what's
# missing, waiting while a game plays; in a subshell, so the menu exec'd below isn't its parent and it leaves no zombie)
if [ -x /usr/libexec/banana/gw-meta ]; then
    ( /usr/libexec/banana/gw-meta </dev/null >/dev/null 2>&1 & )
fi
exec /usr/bin/banana-ui >> $LOG 2>&1
