"text","label":"Hero","value":"char","enum":"chars"},{"type":"number","label":"Level","value":"lv"},{"type":"bar","label":"HP","value":"hp","max":"hpmax","color":"#d04040"},{"type":"bar","label":"MP","value":"mp","max":"mpmax","color":"#4060d0"},{"type":"number","label":"EXP","value":"exp","format":"thousands"},{"type":"number","label":"Gold","value":"gold","format":"thousands"},{"type":"flags","label":"Ailments","value":"ail","items":["Poison","Curse","Stone"]},{"type":"number","label":"Play time","value":"igt","format":"time60"}]},{"id":"detail","title":"Stats & gear","widgets":[{"type":"number","label":"STR","value":"str"},{"type":"number","label":"CON","value":"con"},{"type":"number","label":"INT","value":"int"},{"type":"number","label":"LCK","value":"lck"},{"type":"number","label":"Weapon id","value":"wpn"},{"type":"number","label":"Bullet soul id","value":"bullet"},{"type":"number","label":"Guardian soul id","value":"guardian"},{"type":"number","label":"Enchant soul id","value":"enchant"},{"type":"number","label":"Armor id","value":"body"},{"type":"number","label":"Accessory id","value":"acc"},{"type":"static","text":"Souls come in three equip slots: Bullet (red, uses MP per shot, fired with Up+B), Guardian (blue, toggled with R, drains MP while active) and Enchanted (yellow, always on). Ability souls (grey) are permanent movement upgrades."}]},{"id":"battle","title":"Bosses","widgets":[{"type":"static","text":"Creaking Skull: stay low, hit its head when it swings, then back off from the bone throw.\nFlying Armor: aim upward (axe or Skeleton soul); it only hurts on contact and with fireballs.\nBalore: crouch and hit the eyes; jump the sweeping arms. Grants the slide-breaking Balore soul.\nGolem / Great Armor: stay just out of reach and punish after each attack ends.\nManticore: kill the tail first. Death: phase one drops sickles, phase two charges; holy and Valmanway-class weapons help.\nGraham: dodge the lightning circles; the true ending needs the Flame Demon, Giant Bat and Death souls equipped together when you fight him.","title":"Tips"}]},{"id":"map","title":"Castle","widgets":[{"type":"text","label":"Area","value":"area","enum":"areas"},{"type":"number","label":"Room","value":"room"},{"type":"text","label":"Mode","value":"state","enum":"states"},{"type":"static","text":"Rough order: Castle Corridor -> Chapel -> Study -> Dance Hall -> Inner Quarters -> Floating Garden -> Clock Tower -> Underground Reservoir -> Arena (optional) -> Top Floor -> Forbidden Area -> Chaotic Realm (only on the good-ending route)."}]},{"id":"bag","title":"Gold & items","widgets":[{"type":"number","label":"Gold","value":"gold","format":"thousands"},{"type":"list","title":"Usable items (count per slot)","base":"0x02013294","stride":1,"n":32,"fields":[{"name":"n","label":"Count","off":0,"type":"u8"}],"rowWhen":"n > 0"},{"type":"static","text":"Potions heal HP, Mind Up restores MP, Uncurse and Antidote cure the matching ailment. The shop in the Castle Corridor sells most consumables; Hammer restocks as the story goes on."}]},{"id":"collection","title":"Souls","widgets":[{"type":"flags","label":"Event souls","value":"souls","items":["","Grave Keeper","Flying Armor","Malphas","Skeleton Blaze","Hippogryph","","Skula","","Galamoth","Black Panther"]},{"type":"count","label":"Ability soul flags","value":"ability","total":24,"bits":true},{"type":"static","text":"Every enemy carries a soul with its own drop rate (LCK raises it). Ability souls: Balore (break ice blocks), Malphas (double jump), Doppelganger (gear sets), Rahab (swim), Hippogryph (high jump), Skula (walk underwater), Undine (walk on water), Black Panther (dash)."}]},{"id":"progress","title":"Bosses beaten","widgets":[{"type":"flags","label":"Bosses","value":"bosses","items":["Graham","Death","Julius","","Headhunter","Legion","Balore","Chaos","","","Manticore","Creaking Skull","Big Golem","","","Great Armor"]},{"type":"count","label":"Bosses beaten","value":"band(bosses, 0x9CF7)","total":11