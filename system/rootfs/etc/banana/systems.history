# The values earlier BananaOS systems.conf files shipped and this one doesn't (tools/systems-history.sh, from git):
# systems-merge takes such a value on the card for the old default it is, so this image's value is used.
# id<TAB>key<TAB>value
nds	ext	nds zip
nds	run	/usr/libexec/banana/run-drastic %ROM%
ports	always	yes
ports	maker	PC
ports	run	/bin/sh %ROM%
psx	ext	chd cue bin iso img mdf pbp m3u
psx	perf	balanced
psx	run	/usr/libexec/banana/run-retroarch pcsx_rearmed %ROM%
rocknixdsbank	name	Bank & Trade
snes	perf	balanced
