#!/bin/sh
# Banana's whole boot. Everything the menu needs is built into the kernel (panels, buttons, touch, sound), so
# there is nothing to wait for here but the data partition; Wi-Fi and the clock come up in the background.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
# the handheld's hardware profile (/etc/banana/hw.conf: the panels' connectors, the touchscreen, the modules) for
# everything started from here
. /usr/libexec/banana/hw-env
# both panels powered up now, beside the rest of the boot: the menu waited for that at its start (the RG DS Plus's
# panels ~1.2 s, the RG DS's ~0.3 s); its own start then finds them lit. Only the display, nothing on the card
banana-ui --panels-on </dev/null >/dev/null 2>&1 &
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
# what udev would make: bash's <(...) needs /dev/fd (PortMaster's scripts use it), and some programs open /dev/stdin
ln -sfn /proc/self/fd /dev/fd
ln -sfn /proc/self/fd/0 /dev/stdin
ln -sfn /proc/self/fd/1 /dev/stdout
ln -sfn /proc/self/fd/2 /dev/stderr
# ...and what it would answer: a firmware the kernel asked for before this root was mounted (cfg80211, built in, asks
# for regulatory.db at 0.6 s) waits 60 s in /sys/class/firmware for someone to load it, and a sleep begun in that
# minute stalled until it ran out, the panels lit (up to 52 s with the lid shut, then the sleep failed on the USB
# controller anyway). Loaded from /lib/firmware, or refused when it isn't there
for f in /sys/class/firmware/*/loading; do
    [ -f "$f" ] || continue
    d=${f%/loading}; n=/lib/firmware/${d##*/}
    if [ -f "$n" ]; then echo 1 > "$f"; cat "$n" > "$d/data"; echo 0 > "$f"; else echo -1 > "$f"; fi
done 2>/dev/null
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mkdir -p /run/banana /var/log
# the second SD card's folder before the menu starts: banana-ui watches it for the card's games, and bananad's first
# "sd2 scan" runs in the background, so the menu could start first and miss the card for the whole boot (#65)
mkdir -p /run/banana/sd2
# boot milestones, seconds since the kernel started (logs/boot.txt)
mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" >> /run/banana/boot-times; }
# banana.console=1 on the kernel's command line: the boot's progress on the console (the UART, QEMU's serial)
grep -q 'banana\.console=1' /proc/cmdline && mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" | tee -a /run/banana/boot-times > /dev/console; }
mark "rcS: started"
# the boot at full speed: the CPU's top clock until the menu is up (banana-ui sets its own profile then), and RCU grace
# periods expedited for good: every input device's close waited one (7-27 ms on the RG DS, ~120 ms each time the menu
# handed the buttons and screens to a game and back), as do module loads and network set-ups; expedited, ~0.1 ms
echo 1 > /sys/kernel/rcu_expedited 2>/dev/null
banana-perf performance
[ -f /etc/sysctl.d/banana.conf ] && sysctl -q -p /etc/sysctl.d/banana.conf
# the board's own kernel tunables (hw.conf's HW_SYSCTL, HW_IO...: the AYN Thor's memory, idle and card settings,
# docs/THOR-TUNING.md); a board with none doesn't run it
[ -n "$HW_SYSCTL$HW_IO$HW_CPUIDLE_OFF$HW_MGLRU_TTL_MS$HW_THP_DEFRAG" ] && /usr/libexec/banana/tune boot
# the loopback up (127.0.0.1): nothing brought it up, so a program that talks to itself on localhost (a port, a tool,
# a helper's local server) couldn't even bind there
ip link set lo up 2>/dev/null
hostname banana	# (before syslogd: it takes the name once, and the kernel's default is ROCKNIX's unfilled @DEVICENAME@)
syslogd -O /run/banana/messages -s 256 -b 1
# a board on udev (hw.conf's HW_DEVMGR=udev: the AYN Thor, whose drivers are mostly modules): udevd loads each device's
# module and its firmware and runs the rules (a sound card's SOUND_INITIALIZED, the input devices' properties) as on
# any Linux, devices found at boot ("trigger") and later alike. The boot doesn't wait for it. (The RG DS's drivers are
# built in and it has none: devtmpfs alone.)
if [ "$HW_DEVMGR" = udev ] && command -v udevd >/dev/null; then
    udevd --daemon
    udevadm trigger --type=subsystems --action=add
    udevadm trigger --type=devices --action=add
    mark "rcS: udev started"
fi

# the card we booted from: the system is one of its two root slots (partitions 2 and 3, banana-root-a and -b; the
# kernel's root= says which one booted), the games and settings its fourth partition
for u in /sys/class/block/*p2/uevent; do
    grep -q '^PARTNAME=banana-root-a$' "$u" 2>/dev/null || continue
    p=${u%/uevent}; DISK=/dev/${p##*/}; DISK=${DISK%p2}
done
[ -n "$DISK" ] || DISK=/dev/mmcblk0
echo "$DISK" > /run/banana/disk
SLOT=a; grep -q 'root=PARTLABEL=banana-root-b' /proc/cmdline && SLOT=b
echo "$SLOT" > /run/banana/slot
mark "rcS: slot $SLOT booted"
if [ ! -b ${DISK}p4 ]; then
    /usr/libexec/banana/firstboot "$DISK"
elif grep -q '^PARTNAME=banana-new$' /sys/class/block/${DISK##*/}p4/uevent 2>/dev/null; then
    # a first boot cut off before the partition was formatted (it is still named banana-new): format it now
    /usr/libexec/banana/firstboot --format "$DISK"
fi
# exFAT, so the card can be read and filled on any computer
data() { mount -t exfat -o noatime,uid=0,gid=0,fmask=0000,dmask=0000,iocharset=utf8,errors=remount-ro ${DISK}p4 /data 2>/dev/null; }
data || {
    fsck.exfat -y ${DISK}p4 >/dev/null 2>&1
    data
} ||
    # formatted another way on a computer (FAT32...): whatever the kernel can mount
    mount -o noatime ${DISK}p4 /data 2>/dev/null || {
    # nothing readable: the menu still comes up (and says so), with nothing kept until the next boot
    mount -t tmpfs -o mode=0755 tmpfs /data
    echo "${DISK}p4 could not be mounted" > /run/banana/data-failed
}
/usr/libexec/banana/data-layout
mark "rcS: data partition ready"
# the boot partition, read-only (the panel tuner writes the DTB there once)
mount -t vfat -o ro,noatime ${DISK}p1 /boot 2>/dev/null
# a board whose sound is a server (hw.conf's HW_SOUND=pipewire: the AYN Thor): D-Bus's system bus (PipeWire's
# Bluetooth audio talks to bluetoothd over it), then PipeWire and WirePlumber, which bring the card up from its UCM
# profile when udev has it; bananad points "default" at the server and doesn't wait for the card
if [ "$HW_SOUND" = pipewire ]; then
    mkdir -p /run/dbus /tmp/dbus
    dbus-uuidgen --ensure 2>/dev/null
    dbus-daemon --system 2>/dev/null
    /usr/libexec/banana/sound-server up &
fi

bananad &
# the power and volume keys live before the menu's boot animation (#87): bananad creates bananad-ready once its loop
# hears them (a few ms: the sound's slow setup runs beside it, a volume step waits for it); at most 1 s, so a bananad
# that can't start doesn't hold the menu back
i=0
while [ ! -e /run/banana/bananad-ready ] && [ $i -lt 20 ]; do sleep 0.05; i=$((i + 1)); done
mark "rcS: bananad ready"

# not needed for the menu's first frame
(
    hwclock -s 2>/dev/null
    # compressed swap in memory (hw.conf's HW_ZRAM, MB or a share of the RAM; the AYN Thor: the big emulators and Wine
    # beside their shader caches get room past the RAM without touching the card): one zram device, LZ4, swapped to
    # eagerly as zram is meant to be, one page read at a time (it is memory, not a disk), idle pages recompressed
    [ -n "$HW_ZRAM" ] && /usr/libexec/banana/tune zram
    # the daemons the handheld can't lose (hw.conf's HW_OOM_PROTECT) last in the OOM killer's choice
    [ -n "$HW_OOM_PROTECT" ] && /usr/libexec/banana/tune protect
    # the GPU (SuperDrastic's shaders, RetroArch's GLES) and the Wi-Fi: modules, and with no udev nothing loads a
    # module by itself (bananad loads USB devices' drivers as they come)
    modprobe -a ${HW_MODULES-panfrost rtw88_8821cs} 2>/dev/null
    # a handheld with a fan, lights round its sticks or a GPU boost (the AYN Thor): as Settings keeps them
    [ "$HW_HANDHELD" = yes ] && /usr/libexec/banana/handheld boot &
    # Wi-Fi when there is a network to join and the settings screen didn't switch it off (Settings > Network
    # starts it to search when there is none yet)
    if [ -f /data/banana/wifi.conf ] && ! grep -q '^ *wifi *= *off' /data/banana/settings.conf 2>/dev/null; then
        /usr/libexec/banana/wifi up &     # (its wait for wlan0 doesn't hold up sharing and SSH)
    fi
    # Bluetooth when it was switched on in the settings (off at first: the chip's Bluetooth stays unpowered)
    grep -q '^ *bluetooth *= *on' /data/banana/settings.conf 2>/dev/null && /usr/libexec/banana/bluetooth up >/dev/null 2>&1 &
    # a wired network when there is one (a USB Ethernet adapter; QEMU's virtio): an address by DHCP
    for e in /sys/class/net/eth*; do
        [ -d "$e" ] || continue
        n=${e##*/}
        ip link set $n up && udhcpc -b -q -t 5 -i $n -p /run/banana/udhcpc-$n.pid -s /usr/share/udhcpc/default.script >/dev/null 2>&1
    done
    # file sharing, when switched on in the settings
    grep -q '^ *share *= *on' /data/banana/settings.conf 2>/dev/null && /usr/libexec/banana/share up
    grep -q '^ *ssh *= *on' /data/banana/settings.conf 2>/dev/null && /usr/libexec/banana/ssh up
    /usr/libexec/banana/panel-tune
) &
# the boot, to read on a computer (logs/boot.txt, logs/dmesg.txt), once it has settled; rcK writes it again at shutdown
( sleep 20; /usr/libexec/banana/boot-log ) &
exit 0
