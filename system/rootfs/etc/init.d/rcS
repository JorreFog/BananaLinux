#!/bin/sh
# Banana's whole boot. Everything the menu needs is built into the kernel (panel, buttons, touch, sound), so
# there is nothing to wait for here but the data partition; Wi-Fi and the clock come up in the background.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
# what udev would make: bash's <(...) needs /dev/fd (PortMaster's scripts use it), and some programs open /dev/stdin
ln -sfn /proc/self/fd /dev/fd
ln -sfn /proc/self/fd/0 /dev/stdin
ln -sfn /proc/self/fd/1 /dev/stdout
ln -sfn /proc/self/fd/2 /dev/stderr
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mkdir -p /run/banana /var/log
# boot milestones, seconds since the kernel started (logs/boot.txt)
mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" >> /run/banana/boot-times; }
# banana.console=1 on the kernel's command line: the boot's progress on the console (the UART, QEMU's serial)
grep -q 'banana\.console=1' /proc/cmdline && mark() { read up rest < /proc/uptime; printf '%-28s %6.2f s\n' "$1" "$up" | tee -a /run/banana/boot-times > /dev/console; }
mark "rcS: started"
[ -f /etc/sysctl.d/banana.conf ] && sysctl -q -p /etc/sysctl.d/banana.conf
hostname banana	# (before syslogd: it takes the name once, and the kernel's default is ROCKNIX's unfilled @DEVICENAME@)
syslogd -O /run/banana/messages -s 256 -b 1

# the card we booted from: the system is one of its two root slots (partitions 2 and 3, banana-root-a and -b; the
# kernel's root= says which one booted), the games and settings its fourth partition
for u in /sys/class/block/*p2/uevent; do
    grep -q '^PARTNAME=banana-root-a$' "$u" 2>/dev/null || continue
    p=${u%/uevent}; DISK=/dev/${p##*/}; DISK=${DISK%p2}
done
[ -n "$DISK" ] || DISK=/dev/mmcblk0
echo "$DISK" > /run/banana/disk
SLOT=a; grep -q 'root=PARTLABEL=banana-root-b' /proc/cmdline && SLOT=b
echo "$SLOT" > /run/banana/slot
mark "rcS: slot $SLOT booted"
if [ ! -b ${DISK}p4 ]; then
    /usr/libexec/banana/firstboot "$DISK"
elif grep -q '^PARTNAME=banana-new$' /sys/class/block/${DISK##*/}p4/uevent 2>/dev/null; then
    # a first boot cut off before the partition was formatted (it is still named banana-new): format it now
    /usr/libexec/banana/firstboot --format "$DISK"
fi
# exFAT, so the card can be read and filled on any computer
data() { mount -t exfat -o noatime,uid=0,gid=0,fmask=0000,dmask=0000,iocharset=utf8,errors=remount-ro ${DISK}p4 /data 2>/dev/null; }
data || {
    fsck.exfat -y ${DISK}p4 >/dev/null 2>&1
    data
} ||
    # formatted another way on a computer (FAT32...): whatever the kernel can mount
    mount -o noatime ${DISK}p4 /data 2>/dev/null || {
    # nothing readable: the menu still comes up (and says so), with nothing kept until the next boot
    mount -t tmpfs -o mode=0755 tmpfs /data
    echo "${DISK}p4 could not be mounted" > /run/banana/data-failed
}
/usr/libexec/banana/data-layout
mark "rcS: data partition ready"
# the boot partition, read-only
mount -t vfat -o ro,noatime ${DISK}p1 /boot 2>/dev/null

# The sound, before the menu opens it. The RPC's audio is all modules and nothing loads them without udev, and the
# order matters, because each step needs the one before it to have probed:
#   1. the ADSP's remoteproc (qcom_q6v5_pas). Its GPR services take a second or two to answer: a q6apm loaded
#      before that logs "CMD timeout for [10001021]" (APM_CMD_GET_SPF_STATE) and never retries, so wait for it.
#   2. the LPASS macros: the SoundWire controllers take their "iface" clock from the RX macro.
#   3. the SoundWire bus: it enumerates the WCD937x (two SDW slaves) that the machine driver wants as "WCD Playback".
#   4. the q6 DSP's services, q6prm's LPASS clocks, the codecs.
#   5. the machine driver (sc8280xp -- the card is "qcom,sm4450-sndcard", "qcom,sm8450-sndcard"), which also loads
#      the audioreach topology the DSP runs the graph from (firmware qcom/sm8450/RetroidPocketClassic-tplg.bin).
modprobe -a qcom_q6v5_pas qcom_q6v5 qcom_sysmon qcom_common 2>/dev/null
# the remoteproc says "running" before the DSP is answering, so give it a couple of seconds before the stack loads
i=0
while [ $i -lt 40 ] && ! grep -q running /sys/class/remoteproc/remoteproc*/state 2>/dev/null; do sleep 0.2; i=$((i+1)); done
sleep 2
modprobe -a snd-soc-lpass-macro-common snd-soc-lpass-rx-macro snd-soc-lpass-tx-macro snd-soc-lpass-va-macro soundwire-qcom 2>/dev/null
modprobe -a snd-soc-wcd-common snd-soc-wcd-mbhc snd-soc-wcd-classh snd-soc-wcd937x snd-soc-aw88261 2>/dev/null
modprobe -a snd-soc-qcom-common snd-q6dsp-common snd-q6apm q6apm-dai q6apm-lpass-dais q6prm q6prm-clocks 2>/dev/null
modprobe snd-soc-sc8280xp 2>/dev/null
# the card's probe loads the DSP graph, which takes a moment after modprobe returns; bananad reads
# /proc/asound/cards once, at startup, and writes the "default" PCM from what it finds, so wait for the card here
# (up to 4 s) or the menu's sounds go to a null device
i=0
while [ $i -lt 40 ] && ! grep -q '\[' /proc/asound/cards 2>/dev/null; do sleep 0.1; i=$((i+1)); done
# the board's own modules: the cooling fan (pwm-fan) and the charger/battery gauge (qcom_battmgr, which bananad reads
# the level and the charging state from)
modprobe -a pwm-fan qcom_battmgr 2>/dev/null
mark "rcS: sound"

bananad &

# The RPC's DSP graph has to be routed from a frontend to the speaker I2S before that frontend is opened -- once a
# stream is open, its mixer is the DSP's and a change to it doesn't take. So the routes go in here, before the menu
# starts (it keeps its playback stream open for its cues) and before any game. Both frontends are routed to the same
# speakers (MultiMedia1 and MultiMedia2, whichever an app ends up on), and they do not fight over the amps: banana-ui
# releases its stream when a game starts (Sound::release(), called by runGame() for every launch) and run-retroarch puts the
# route back before RetroArch opens its own. No UCM profile does any of this on this image.
# read the route back, not just trust the write: the card is there before its mixer is, and a stream opened with
# the route off stays unrouted for its life
i=0
while [ $i -lt 60 ]; do
    amixer -q -c 0 cset "name=SENARY_MI2S_RX Audio Mixer MultiMedia1" on,on 2>/dev/null
    amixer -c 0 sget "SENARY_MI2S_RX Audio Mixer MultiMedia1" 2>/dev/null | grep -q '\[on\]' && break
    sleep 0.1; i=$((i+1))
done
amixer -q -c 0 cset "name=SENARY_MI2S_RX Audio Mixer MultiMedia2" on,on 2>/dev/null
amixer -q -c 0 sset "Left PCM" 90% 2>/dev/null
amixer -q -c 0 sset "Right PCM" 90% 2>/dev/null
amixer -q -c 0 sset "Left PCM Playback Volume" 460 2>/dev/null
amixer -q -c 0 sset "Right PCM Playback Volume" 460 2>/dev/null
# The rest of ROCKNIX's UCM2 BootSequence for this card (alsa-ucm-conf,
# Retroid/PocketClassic): the codec's and the RX macro's own levels. Without UCM on this image
# the routing above is not enough -- the headphone and speaker output and the mic capture come
# up at their reset levels (silent or very quiet) unless they are set here too.
amixer -q -c 0 cset "name=RX_RX0 Digital Volume" 84 2>/dev/null
amixer -q -c 0 cset "name=RX_RX1 Digital Volume" 84 2>/dev/null
amixer -q -c 0 cset "name=HPHL Volume" 20 2>/dev/null
amixer -q -c 0 cset "name=HPHR Volume" 20 2>/dev/null
amixer -q -c 0 cset "name=ADC2 Volume" 10 2>/dev/null
# The headphone path (ROCKNIX's wcd937x / rx-macro HeadphoneEnableSeq, using this kernel's own control names --
# 'HPHL', not 'HPHL Switch'): the HP output switches and the LPASS RX macro's muxes to AIF1. Without them the jack
# has no signal; the speaker path (SENARY MI2S -> AW88166) is separate and does not need them.
amixer -q -c 0 sset "HPHL" on 2>/dev/null
amixer -q -c 0 sset "HPHR" on 2>/dev/null
amixer -q -c 0 sset "HPHL_RDAC" on 2>/dev/null
amixer -q -c 0 sset "HPHR_RDAC" on 2>/dev/null
amixer -q -c 0 sset "HPHL_COMP" on 2>/dev/null
amixer -q -c 0 sset "HPHR_COMP" on 2>/dev/null
amixer -q -c 0 cset "name=RX HPH Mode" CLS_H_LOHIFI 2>/dev/null
amixer -q -c 0 cset "name=RX_HPH PWR Mode" LOHIFI 2>/dev/null
amixer -q -c 0 cset "name=RX_MACRO RX0 MUX" AIF1_PB 2>/dev/null
amixer -q -c 0 cset "name=RX_MACRO RX1 MUX" AIF1_PB 2>/dev/null
amixer -q -c 0 cset "name=RX INT0_1 MIX1 INP0" RX0 2>/dev/null
amixer -q -c 0 cset "name=RX INT1_1 MIX1 INP0" RX1 2>/dev/null
amixer -q -c 0 cset "name=RX INT0 DEM MUX" CLSH_DSM_OUT 2>/dev/null
amixer -q -c 0 cset "name=RX INT1 DEM MUX" CLSH_DSM_OUT 2>/dev/null
# the capture frontend (RFC's UCM SectionVerb: MultiMedia3 -> TX_CODEC_DMA_TX_3): the mic the WCD937x
# records through. Without it capture is unrouted however the gains are set.
amixer -q -c 0 cset "name=MultiMedia3 Mixer TX_CODEC_DMA_TX_3" 1 2>/dev/null
mark "rcS: sound routed ($i tries)"

# The sound server: PipeWire, with WirePlumber as its session manager (ROCKNIX has the same, and it is the
# difference heard on this card: a buffer above the DSP, and one owner of the card's single frontend, where before
# the menu and a game took turns at it). It starts *after* the route and the levels above, because the DSP takes the
# mixer values it finds when a frontend's graph is instantiated -- and the frontend is PipeWire's now, not the
# menu's. The Wayland runtime dir is the same one (cage, the games' compositor, puts its socket there too).
mkdir -p /run/banana/rt && chmod 700 /run/banana/rt
if [ -x /usr/bin/pipewire ]; then
    XDG_RUNTIME_DIR=/run/banana/rt PIPEWIRE_RUNTIME_DIR=/run/banana/rt pipewire >/run/banana/pipewire.log 2>&1 &
    i=0
    while [ $i -lt 50 ] && [ ! -S /run/banana/rt/pipewire-0 ]; do sleep 0.1; i=$((i+1)); done
    # HOME on tmpfs: the root is read-only and WirePlumber keeps its state in $HOME/.local/state
    [ -x /usr/bin/wireplumber ] && HOME=/run/banana XDG_RUNTIME_DIR=/run/banana/rt wireplumber >/run/banana/wireplumber.log 2>&1 &
    mark "rcS: sound server"
fi

banana-perf ui

# not needed for the menu's first frame
(
    hwclock -s 2>/dev/null
    # the GPU (RetroArch's GLES, Turnip/Freedreno on the Adreno) and the Wi-Fi: modules, and with no udev nothing
    # loads a module by itself (bananad loads USB devices' drivers as they come). The WLAN driver is ath10k_snoc on
    # the RPC's WCN3950 (a qcom,wcn3990-wifi node), whose firmware is in ath10k/WCN3990/hw1.0 with the wpss one.
    modprobe -a ath10k_snoc 2>/dev/null
    # Wi-Fi when there is a network to join and the settings screen didn't switch it off (Settings > Network
    # starts it to search when there is none yet)
    if [ -f /data/banana/wifi.conf ] && ! grep -q '^ *wifi *= *off' /data/banana/settings.conf 2>/dev/null; then
        /usr/libexec/banana/wifi up &     # (its wait for wlan0 doesn't hold up sharing and SSH)
    fi
    # a wired network when there is one (a USB Ethernet adapter; QEMU's virtio): an address by DHCP
    for e in /sys/class/net/eth*; do
        [ -d "$e" ] || continue
        n=${e##*/}
        ip link set $n up && udhcpc -b -q -t 5 -i $n -p /run/banana/udhcpc-$n.pid -s /usr/share/udhcpc/default.script >/dev/null 2>&1
    done
    # file sharing, when switched on in the settings
    grep -q '^ *share *= *on' /data/banana/settings.conf 2>/dev/null && /usr/libexec/banana/share up
    grep -q '^ *ssh *= *on' /data/banana/settings.conf 2>/dev/null && /usr/libexec/banana/ssh up
) &
# the boot, to read on a computer (logs/boot.txt, logs/dmesg.txt), once it has settled; rcK writes it again at shutdown
( sleep 20; /usr/libexec/banana/boot-log ) &
exit 0
