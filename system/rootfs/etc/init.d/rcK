#!/bin/sh
# Shutdown: stop what writes to the card, then unmount it cleanly
killall -TERM banana-ui retroarch drastic 2>/dev/null
sleep 1
/usr/libexec/banana/share down 2>/dev/null     # a computer's open files on the card
/usr/libexec/banana/ssh down 2>/dev/null
/usr/libexec/banana/wifi down 2>/dev/null
hwclock -w 2>/dev/null
/usr/libexec/banana/boot-log       # the boot's log, complete, whenever the handheld is turned off
sync
umount /data 2>/dev/null || mount -o remount,ro /data
sync
