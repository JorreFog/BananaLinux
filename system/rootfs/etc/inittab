# Banana: busybox init. rcS mounts and starts what the menu needs, in parallel where it can; the menu then runs
# for as long as the handheld is on (started again if it ever stops).
::sysinit:/etc/init.d/rcS
::respawn:/usr/bin/banana-ui-session
# a shell on the board's UART when it has one (a Qualcomm geni console: ttyMSM0; QEMU's virt: ttyAMA0), else a
# wait: the script picks the one that exists (inittab can't hold the colons it would need)
::respawn:/usr/libexec/banana/console-shell
::shutdown:/etc/init.d/rcK
::ctrlaltdel:/sbin/reboot
