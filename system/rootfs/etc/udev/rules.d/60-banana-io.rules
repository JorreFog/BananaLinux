# A card's I/O scheduler and read-ahead as the hardware profile says (hw.conf's HW_IO, usr/libexec/banana/tune io),
# for the boot card and for one put in later (the second card). Only a board on udev reads this (the AYN Thor).
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="mmcblk[0-9]", RUN+="/usr/libexec/banana/tune io %k"
