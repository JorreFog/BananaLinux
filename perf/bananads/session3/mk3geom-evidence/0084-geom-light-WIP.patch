+                while ((s32)(jb.LightEnd - lt) > 0) { // (the worker may have lit ahead of it)
+                     GeomLightJob(GeomLRing[lt & (GeomLightRing - 1)], lt); GeomLTail.store(++lt, std::memory_order_release); }
+                if (jb.NeedColors) GeomColors(jb);
