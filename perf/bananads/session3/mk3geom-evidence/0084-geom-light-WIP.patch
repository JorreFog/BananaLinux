diff --git a/src/GPU3D.h b/src/GPU3D.h
index 67a4d8a..4450a18 100644
--- a/src/GPU3D.h
+++ b/src/GPU3D.h
@@ -91,8 +91,35 @@ class NDS;
 
 // render.geom_thread: a stored polygon handed to the worker (GPU3D::GeomBuild): its clipped vertices (with their
 // screen positions) and reciprocals, its place, the shared vertices' places, and the state the build reads
+struct GeomLightState
+{
+    s16 LightDirection[4][3];
