 {
     u32 t = GeomTail.load(std::memory_order_relaxed);
+    u32 lt = GeomLTail.load(std::memory_order_relaxed);
     for (;;)
     {
         if (t != GeomHead.load(std::memory_order_acquire))
         {
-            GeomBuild(GeomRing[t & (GeomRingSize - 1)]);
+            GeomJob& jb = GeomRing[t & (GeomRingSize - 1)];
