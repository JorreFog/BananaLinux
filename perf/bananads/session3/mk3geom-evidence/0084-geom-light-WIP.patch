+                    GeomTempEnc[k] = jb.TC[k];
+                    if (jb.TC[k] & 0x80000000u) memcpy(GeomTempRes[k], GeomLightRes[jb.TC[k] & (GeomLightResults - 1)], 3);
+                }
+            }
             GeomTail.store(++t, std::memory_order_release);
