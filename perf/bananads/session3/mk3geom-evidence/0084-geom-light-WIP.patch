+           GeomLTail.load(std::memory_order_acquire) != GeomLHead.load(std::memory_order_relaxed))
     {
         GeomWake();
         std::this_thread::yield();
@@ -3324,14 +3521,33 @@ void GPU3D::GeomStart() noexcept
