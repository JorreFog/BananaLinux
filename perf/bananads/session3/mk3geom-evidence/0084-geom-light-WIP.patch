+// render.geom_light: the normal command's lighting on the worker. Here: the texcoords it makes (TexParam mode 2),
+// the transformed normal, its timing (one cycle per enabled light, at least one: the light loop's count) and a light
+// job; the worker computes the colour (GeomLightJob) and the vertices submitted until the next colour change carry
+// the job's number
+void GPU3D::GeomLightCmd() noexcept
+{
+    if ((TexParam >> 30) == 2)
+    {
+        TexCoords[0] = RawTexCoords[0] + (((s64)Normal[0]*TexMatrix[0] + (s64)Normal[1]*TexMatrix[4] + (s64)Normal[2]*TexMatrix[8]) >> 21);
+        TexCoords[1] = RawTexCoords[1] + (((s64)Normal[0]*TexMatrix[1] + (s64)Normal[1]*TexMatrix[5] + (s64)Normal[2]*TexMatrix[9]) >> 21);
+    }
+    if (!GeomRing) [[unlikely]] GeomStart();
+    const u32 h = GeomLHead.load(std::memory_order_relaxed);
+    if (h - GeomLTail.load(std::memory_order_acquire) >= GeomLightRing) [[unlikely]]
+    {
+        while (h - GeomLTail.load(std::memory_order_acquire) >= GeomLightRing) { GeomWake(); std::this_thread::yield(); }
+    }
+    GeomLightEntry& e = GeomLRing[h & (GeomLightRing - 1)];
+    e.NT[0] = ((Normal[0]*VecMatrix[0] + Normal[1]*VecMatrix[4] + Normal[2]*VecMatrix[8]) << 9) >> 21;
+    e.NT[1] = ((Normal[0]*VecMatrix[1] + Normal[1]*VecMatrix[5] + Normal[2]*VecMatrix[9]) << 9) >> 21;
+    e.NT[2] = ((Normal[0]*VecMatrix[2] + Normal[1]*VecMatrix[6] + Normal[2]*VecMatrix[10]) << 9) >> 21;
+    const u32 lights = CurPolygonAttr & 0xF;
+    e.Lights = lights;
+    e.State = 0;
+    if (LightStateDirty) [[unlikely]]
+    {
+        // a new light state, in the states' ring (64; waits while the worker hasn't taken the oldest)
+        const u32 sh = GeomSHead;
+        while (sh - GeomSTail.load(std::memory_order_acquire) >= 64) { GeomWake(); std::this_thread::yield(); }
+        GeomLightState& ls = GeomSRing[sh & 63];
+        memcpy(ls.LightDirection, LightDirection, sizeof(LightDirection));
+        memcpy(ls.SpecRecip, SpecRecip, sizeof(SpecRecip));
+        memcpy(ls.LightColor, LightColor, sizeof(LightColor));
+        memcpy(ls.MatDiffuse, MatDiffuse, 3); memcpy(ls.MatAmbient, MatAmbient, 3);
+        memcpy(ls.MatSpecular, MatSpecular, 3); memcpy(ls.MatEmission, MatEmission, 3);
+        ls.UseShininessTable = UseShininessTable;
+        memcpy(ls.ShininessTable, ShininessTable, sizeof(ShininessTable));
+        GeomSHead = sh + 1;
+        e.State = 0x80000000u | sh;
+        LightStateDirty = false;
+    }
+    GeomLHead.store(h + 1, std::memory_order_release);
+    if (((h & 255) == 255) && GeomSleeping.load(std::memory_order_relaxed)) GeomWake();
+    GeomLightSeq = h + 1;
+    VertexColorSeq = h & (GeomLightResults - 1);
+    VertexColorLit = true;
+    const s32 c = lights ? __builtin_popcount(lights) : 1;
+    NormalPipeline = 7;
+    AddCyclesT<true>(c);
+}
+
+// the worker: CalculateLightingBody<true>'s colour for a light job, from its transformed normal and the light state
+void GPU3D::GeomLightJob(const GeomLightEntry& jb, u32 seq) noexcept
+{
+    if (jb.State) { GeomLS = GeomSRing[jb.State & 63]; GeomSTail.store((jb.State & 0x7FFFFFFFu) + 1, std::memory_order_release); }
+    const GeomLightState& ls = GeomLS;
+    const s32* normaltrans = jb.NT;
+    u32 vtxbuff[3] = {(u32)ls.MatEmission[0] << 14, (u32)ls.MatEmission[1] << 14, (u32)ls.MatEmission[2] << 14};
+    for (u32 lights = jb.Lights; lights; lights &= lights - 1)
+    {
+        const int i = __builtin_ctz(lights);
+        s32 dot = ((ls.LightDirection[i][0]*normaltrans[0]) >> 9) +
+                  ((ls.LightDirection[i][1]*normaltrans[1]) >> 9) +
+                  ((ls.LightDirection[i][2]*normaltrans[2]) >> 9);
+        s32 shinelevel;
+        if (dot > 0)
+        {
+            s32 diffdot = (dot << 21) >> 21;
+            vtxbuff[0] += (ls.MatDiffuse[0] * ls.LightColor[i][0] * diffdot) & 0xFFFFF;
+            vtxbuff[1] += (ls.MatDiffuse[1] * ls.LightColor[i][1] * diffdot) & 0xFFFFF;
+            vtxbuff[2] += (ls.MatDiffuse[2] * ls.LightColor[i][2] * diffdot) & 0xFFFFF;
+            dot += normaltrans[2];
+            dot = (dot << 21) >> 21;
+            dot = ((dot * dot) >> 10) & 0x3FF;
+            shinelevel = ((dot * ls.SpecRecip[i]) >> 8) - (1<<9);
+            if (shinelevel < 0) shinelevel = 0;
+            else
+            {
+                shinelevel = (shinelevel << 18) >> 18;
+                if (shinelevel < 0) shinelevel = 0;
+                else if (shinelevel > 0x1FF) shinelevel = 0x1FF;
+            }
+        }
+        else shinelevel = 0;
+        if (ls.UseShininessTable)
+        {
+            shinelevel >>= 2;
+            shinelevel = ls.ShininessTable[shinelevel];
+            shinelevel <<= 1;
+        }
+        vtxbuff[0] += ((ls.MatSpecular[0] * shinelevel) + (ls.MatAmbient[0] << 9)) * ls.LightColor[i][0];
+        vtxbuff[1] += ((ls.MatSpecular[1] * shinelevel) + (ls.MatAmbient[1] << 9)) * ls.LightColor[i][1];
+        vtxbuff[2] += ((ls.MatSpecular[2] * shinelevel) + (ls.MatAmbient[2] << 9)) * ls.LightColor[i][2];
+    }
+    u8* r = GeomLightRes[seq & (GeomLightResults - 1)];
+    r[0] = (vtxbuff[0] >> 14 > 31) ? 31 : (vtxbuff[0] >> 14);
+    r[1] = (vtxbuff[1] >> 14 > 31) ? 31 : (vtxbuff[1] >> 14);
+    r[2] = (vtxbuff[2] >> 14 > 31) ? 31 : (vtxbuff[2] >> 14);
+}
+
+// a colour as SubmitVertex makes it, from a literal one or a light job's number
+static inline void GeomResolve(Vertex& v, const u8 (*res)[3], u32 mask) noexcept
+{
+    if (!((u32)v.Color[0] & 0x80000000u)) return;
+    const u8* c = res[(u32)v.Color[0] & mask];
+    v.Color[0] = (c[0] << 12) + 0xFFF;
+    v.Color[1] = (c[1] << 12) + 0xFFF;
+    v.Color[2] = (c[2] << 12) + 0xFFF;
+}
+
+// the worker: the stored polygon's vertex colours for a polygon with lit vertices, by the emulator thread's steps:
+// the inputs' colours, then the same clipping passes (they depend on the positions only) with the attributes
+void GPU3D::GeomColors(GeomJob& jb) noexcept
+{
+    Vertex v[10];
+    const int clipstart = jb.ClipStart;
+    if (clipstart == 2) { v[0] = *jb.Reuse[0]; v[1] = *jb.Reuse[1]; }
+    for (int i = clipstart; i < jb.NIn; i++) { v[i] = jb.In[i]; GeomResolve(v[i], GeomLightRes, GeomLightResults - 1); }
+    int nverts = jb.NIn;
+    const u32 outside = jb.Outside;
+    if (outside)
+    {
+        if (outside & 4)
+            nverts = ClipAgainstPlane<2, true, 1>(jb.Attr, v, nverts, clipstart);
+        if (nverts == 0 || ClipPlaneOutside<1>(v, nverts, clipstart))
+            nverts = ClipAgainstPlane<1, true, 1>(jb.Attr, v, nverts, clipstart);
+        if (nverts == 0 || ClipPlaneOutside<0>(v, nverts, clipstart))
+            nverts = ClipAgainstPlane<0, true, 1>(jb.Attr, v, nverts, clipstart);
+    }
+    for (int i = clipstart; i < jb.NVerts; i++)
+        for (int k = 0; k < 3; k++) jb.V[i].Color[k] = v[i].Color[k];
+}
+
+// at a savestate (drained): the lit colours made literal again, as the plain path has them
+void GPU3D::GeomResolveState() noexcept
+{
+    if (VertexColorLit)
+    {
+        const u8* c = GeomLightRes[VertexColorSeq];
+        VertexColor[0] = c[0]; VertexColor[1] = c[1]; VertexColor[2] = c[2];
+        VertexColorLit = false;
+    }
+    // a temp vertex the last stored polygon's job saw resolves as the worker saw it then (its light result may
+    // have been reused since); a later one from the results
+    for (Vertex& v : TempVertexBuffer)
+    {
+        const u32 enc = (u32)v.Color[0];
+        if (!(enc & 0x80000000u)) continue;
+        const u8* c = GeomLightRes[enc & (GeomLightResults - 1)];
+        for (int k = 0; k < 4; k++) if (GeomTempEnc[k] == enc) { c = GeomTempRes[k]; break; }
+        v.Color[0] = (c[0] << 12) + 0xFFF; v.Color[1] = (c[1] << 12) + 0xFFF; v.Color[2] = (c[2] << 12) + 0xFFF;
+    }
+    LightStateDirty = true;
+}
+
 // render.geom_thread: the ring of polygon jobs (one producer: the emulator thread; one consumer: the worker)
 GeomJob* GPU3D::GeomSlot() noexcept
 {
@@ -3295,7 +3490,9 @@ void GPU3D::GeomWake() noexcept
 void GPU3D::GeomDrain() noexcept
 {
     if (!GeomRing || GeomSab == 2) return;
-    while (GeomTail.load(std::memory_order_acquire) != GeomHead.load(std::memory_order_relaxed))
