+// TRACE (test build only): every Run call's resulting geometry state and ARM9 timestamp folded into a hash
+static u64 GXTraceHash = 0, GXTraceCalls = 0;
+static void GXTracePrint() { fprintf(stderr, "GXTRACE calls %llu hash %016llx\n", (unsigned long long)GXTraceCalls, (unsigned long long)GXTraceHash); }
+static inline void GXTraceMix(u64 v) { GXTraceHash = (GXTraceHash ^ v) * 0x100000001B3ull; }
 void GPU3D::Run() noexcept
 {
     if (GeomFast)
     {
         RunFast();
+        if (GXTraceCalls++ == 0) atexit(GXTracePrint);
+        GXTraceMix(NDS.ARM9Timestamp); GXTraceMix(Timestamp); GXTraceMix((u32)CycleCount); GXTraceMix(GXStat);
+        GXTraceMix(CmdPIPE.Level() | (CmdPIPE.RawReadPos() << 8) | (CmdPIPE.RawWritePos() << 16));
+        GXTraceMix(CmdFIFO.Level() | (CmdFIFO.RawReadPos() << 12) | ((u64)CmdFIFO.RawWritePos() << 24));
+        GXTraceMix(NumPushPopCommands | ((u64)NumTestCommands << 32));
+        GXTraceMix((u32)VertexPipeline | ((u64)(u32)NormalPipeline << 32)); GXTraceMix((u32)PolygonPipeline | ((u64)(u32)VertexSlotCounter << 32));
+        GXTraceMix(VertexSlotsFree | ((u64)NumPolygons << 16) | ((u64)NumVertices << 32) | ((u64)ExecParamCount << 48));
+        GXTraceMix(NDS.IF[0]); GXTraceMix(FlushRequest);
+        for (int i = 0; i < 4; i++) GXTraceMix(ExecParams[i]);
+        const CmdFIFOEntry* pe = CmdPIPE.RawEntries();
+        for (int i = 0; i < 4; i++) GXTraceMix(pe[i].Param | ((u64)pe[i].Command << 32));
         return;
     }
 
