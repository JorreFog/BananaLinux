diff --git a/bananads/docs/SETTINGS.md b/bananads/docs/SETTINGS.md
index a04af44..125526c 100644
--- a/bananads/docs/SETTINGS.md
+++ b/bananads/docs/SETTINGS.md
@@ -12,6 +12,7 @@ key can also come from the environment as `BANANADS_<KEY>` (dots become undersco
 | `jit.timing` | `block` | BananaJIT's timing: `block` (melonDS's JIT's level: fast memory, cycles counted per block) or `exact` (the interpreter's, cycle for cycle; slower) |
 | `jit.codegen` | `new` | melonDS's JIT's code generation (patches/melonds/0007): `new` (fewer host instructions per block and per exit: cheaper exit stubs, linkable exits both ways of a block-ending branch, self loops checked inline, host flags kept in NZCV, a per-site cache for returns) or `old` (the code before 0007, byte for byte). Exact either way. Sets `MELONDS_JIT_OLDCODEGEN`; each part is also off alone with its `MELONDS_JIT_NO<name>=1` (docs/PERF.md lists them). `MELONDS_JIT_NOFASTLDM=1` keeps block loads (LDM, POP) off the fastmem path (0008). `MELONDS_JIT_LOOPREGS=1` turns on loops that keep their guest registers in host registers (off: HeartGold hangs with it, docs/PERF.md) |
 | `jit.hugepages` | `on` | the JIT's 32 MB code memory aligned to 2 MB and `madvise(MADV_HUGEPAGE)`'d before its first use, so a kernel with transparent huge pages in `madvise` mode (BananaLinux) maps it with 2 MB pages: fewer iTLB misses and page walks on the A55 (patches/melonds/0021). Emulation doesn't change. Sets `MELONDS_JIT_HUGEPAGE`, read as the first JIT starts; the log line `[jit] code memory at ..., N kB on huge pages` says what the kernel gave |
+| `jit.irqchain` | `on` | a chain of linked JIT blocks goes on past an IRQ that CPSR.I masks, instead of going back to the loop at every block exit while one is pending (melonDS sets its IRQ flag whatever CPSR.I is; the loop's TriggerIRQ would do nothing with it) (patches/melonds/0023). Exact. `off` sets `MELONDS_JIT_NOIRQCHAIN=1`; `jit.codegen=old` turns it off too. `MELONDS_JIT_EXITSTATS=n` (0022) prints at exit, per frame from frame n on, why chains came back to the loop: compiles, region setups, IRQs taken, IRQs masked, halts and idle loops |
 | `jit.iofast` | `on` | direct routes for the JIT's slow memory paths: main RAM block transfers, VRAM, the GX FIFO and command ports, IE/IF/IME/DISPSTAT/VCOUNT/KEYINPUT reads (patches/melonds/0005). Exact. Sets `MELONDS_IOFAST`; `MELONDS_IOFAST_ROUTES` picks single routes, `MELONDS_IOSTATS=n` prints the slow accesses by address from frame n |
 | `jit.vramfast` | `on` | VRAM with one bank at a 16 KB page written and read straight to the bank (with the dirty bit and the capture check), OAM and palette straight to the GPU (patches/melonds/0010). Exact. Bit 1 of `MELONDS_MEMFAST` |
 | `jit.iodirect` | `on` | the divider, square root, IPCSYNC/IPCFIFOCNT, the IPC FIFOs and IME/IE/IF read and written straight to their state, other IO registers without the ARM9Read*/ARM7Read* dispatch, one function per hot register for the JIT's static-address calls (patches/melonds/0010). Exact. Bit 2 of `MELONDS_MEMFAST` |
diff --git a/bananads/patches/melonds/0022-NDS-MELONDS_JIT_EXITSTATS-counts-why-JIT-block-chain.patch b/bananads/patches/melonds/0022-NDS-MELONDS_JIT_EXITSTATS-counts-why-JIT-block-chain.patch
new file mode 100644
index 0000000..3d9820f
--- /dev/null
+++ b/bananads/patches/melonds/0022-NDS-MELONDS_JIT_EXITSTATS-counts-why-JIT-block-chain.patch
@@ -0,0 +1,105 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: BananaDS <bananads@localhost>
+Date: Sun, 18 Oct 2026 15:34:55 +0000
+Subject: [PATCH] NDS: MELONDS_JIT_EXITSTATS counts why JIT block chains come
+ back to the loop
+
+With MELONDS_JIT_EXITSTATS=n, FastLoop's block loop (ExecuteJITInline) counts, per CPU and from frame n on,
+the lookups that had to compile a block, the region setups, and the returns from JIT code with StopExecution
+set, split into an IRQ taken (CPSR.I clear), an IRQ that CPSR.I masks, and a halt or idle loop; printed at
+exit as per-frame rates. The counts sit on the loop's cold paths only: a dispatch that ends at the slice's end
+(most of them) runs the same code as without the variable. Dispatches themselves are ARM_Dispatch's calls in
+a profiler.
+---
+ src/NDS.cpp | 57 +++++++++++++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 57 insertions(+)
+
+diff --git a/src/NDS.cpp b/src/NDS.cpp
+index 1991a5c..e3ac017 100644
+--- a/src/NDS.cpp
++++ b/src/NDS.cpp
+@@ -1218,6 +1218,55 @@ template <u32 num, typename CPU>
+     return false;
+ }
+ 
++// MELONDS_JIT_EXITSTATS=n (patch 0022): from frame n on, why the JIT's block chains came back to this loop, per
++// CPU, printed at exit. Counted only on the loop's cold paths (nothing added to a dispatch that ends at the slice's end).
++namespace
++{
++enum
++{
++    jx_Compile, jx_Region, jx_IrqTaken, jx_IrqMasked, jx_HaltIdle, jx_Count
++};
++struct JitExitStats
++{
++    u32 From = 0;
++    u32 First = ~0u, Last = 0;
++    u64 Count[2][jx_Count] = {};
++    JitExitStats()
++    {
++        const char* e = getenv("MELONDS_JIT_EXITSTATS");
++        From = e ? (u32)strtoul(e, nullptr, 0) : 0;
++    }
++    ~JitExitStats()
++    {
++        if (!From || First > Last)
++            return;
++        static const char* const names[jx_Count] = {
++            "lookup misses (blocks compiled)", "region setups (SetupExecutableRegion)",
++            "back for an IRQ taken (CPSR.I clear)", "back for an IRQ masked (CPSR.I set)", "back for a halt or idle loop" };
++        const u32 frames = Last - First + 1;
++        fprintf(stderr, "melonDS JIT exit stats: frames %u-%u (%u), per frame ARM9 / ARM7\n", First, Last, frames);
++        for (int k = 0; k < jx_Count; k++)
++            fprintf(stderr, "  %-48s %12.1f %12.1f\n", names[k], (double)Count[0][k] / frames, (double)Count[1][k] / frames);
++    }
++};
++JitExitStats JitExits;
++const bool JitExitStatsOn = JitExits.From != 0;
++}
++
++// (only on the loop's cold paths: a stop, a compile, a region change; the dispatches themselves, mostly at the
++// slice's end, are counted by a profiler: ARM_Dispatch's calls)
++template <u32 num, typename CPU>
++[[gnu::noinline, gnu::cold]] static void CountJitExit(NDS& nds, CPU& cpu, int kind)
++{
++    if (nds.NumFrames < JitExits.From)
++        return;
++    JitExits.First = std::min(JitExits.First, nds.NumFrames);
++    JitExits.Last = std::max(JitExits.Last, nds.NumFrames);
++    if (kind < 0)
++        kind = (cpu.Halted || cpu.IdleLoop) ? jx_HaltIdle : (cpu.CPSR & 0x80) ? jx_IrqMasked : jx_IrqTaken;
++    JitExits.Count[num][kind]++;
++}
++
+ // ARMv5/ARMv4::Execute<JIT>'s block loop and its end, for a CPU that isn't halted (FastLoop)
+ template <u32 num, typename CPU>
+ [[gnu::always_inline]] static inline void ExecuteJITInline(NDS& nds, CPU& cpu, u64& timestamp, u64& target, u8* const rxBase)
+@@ -1233,6 +1282,8 @@ template <u32 num, typename CPU>
+         u32 offset = instrAddr - cpu.FastBlockLookupStart;
+         if (offset >= cpu.FastBlockLookupSize) [[unlikely]]
+         {
++            if (JitExitStatsOn) [[unlikely]]
++                CountJitExit<num>(nds, cpu, jx_Region);
+             if (!SetupExecutableRegionFor<num>(nds, cpu, instrAddr))
+             {
+                 timestamp = target;
+@@ -1246,10 +1297,16 @@ template <u32 num, typename CPU>
+         if (entry >> 32 == (instrAddr | num)) [[likely]]
+             ARM_Dispatch(&cpu, (JitBlockEntry)(rxBase + (u32)entry));
+         else
++        {
+             nds.JIT.CompileBlock(&cpu);
++            if (JitExitStatsOn) [[unlikely]]
++                CountJitExit<num>(nds, cpu, jx_Compile);
++        }
+ 
+         if (cpu.StopExecution)
+         {
++            if (JitExitStatsOn) [[unlikely]]
++                CountJitExit<num>(nds, cpu, -1);
+             // this order is crucial otherwise idle loops waiting for an IRQ won't function
+             if (cpu.IRQ)
+                 cpu.TriggerIRQ();
+-- 
+2.43.0
+
diff --git a/bananads/patches/melonds/0023-ARMJIT_A64-an-IRQ-that-CPSR.I-masks-doesn-t-end-a-bl.patch b/bananads/patches/melonds/0023-ARMJIT_A64-an-IRQ-that-CPSR.I-masks-doesn-t-end-a-bl.patch
new file mode 100644
index 0000000..637f174
--- /dev/null
+++ b/bananads/patches/melonds/0023-ARMJIT_A64-an-IRQ-that-CPSR.I-masks-doesn-t-end-a-bl.patch
@@ -0,0 +1,131 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: BananaDS <bananads@localhost>
+Date: Sun, 18 Oct 2026 15:34:55 +0000
+Subject: [PATCH] ARMJIT_A64: an IRQ that CPSR.I masks doesn't end a block
+ chain (MELONDS_JIT_NOIRQCHAIN)
+
+melonDS sets ARM::IRQ whenever IME and IE & IF say so, whatever CPSR.I is, so while a game runs with
+interrupts disabled (an IRQ handler, an OS_DisableInterrupts section) and one is pending, StopExecution
+stays set and every block exit went back to the loop: ARM_Ret, TriggerIRQ (which returns at once with I set),
+Timestamp += Cycles, the lookup and ARM_Dispatch, to run the block the exit would have gone on to anyway.
+The exit stubs (ExitCheck, ExitCheckPC, DynExit, DynExitA) now look closer when StopExecution is set: with
+Halted and IdleLoop clear and CPSR.I set they go on with their checks and into the next block, as the loop
+would. Off the common path (StopExecution clear) nothing changes. Exact; part of 0007's code generation
+(jit.codegen=old turns it off with the rest), MELONDS_JIT_NOIRQCHAIN=1 alone.
+---
+ src/ARMJIT_A64/ARMJIT_Compiler.cpp | 39 ++++++++++++++++++++++++------
+ src/ARMJIT_A64/ARMJIT_Compiler.h   |  2 ++
+ 2 files changed, 34 insertions(+), 7 deletions(-)
+
+diff --git a/src/ARMJIT_A64/ARMJIT_Compiler.cpp b/src/ARMJIT_A64/ARMJIT_Compiler.cpp
+index 4b3859b..990fcb3 100644
+--- a/src/ARMJIT_A64/ARMJIT_Compiler.cpp
++++ b/src/ARMJIT_A64/ARMJIT_Compiler.cpp
+@@ -279,6 +279,7 @@ Compiler::Compiler(melonDS::NDS& nds) : Arm64Gen::ARM64XEmitter(), NDS(nds)
+         OptDynCache = OptDynAddr && !getenv("MELONDS_JIT_NODYNCACHE") && !getenv("MELONDS_JIT_NOLINK");
+         OptExitPC = OptExitStub && !getenv("MELONDS_JIT_NOEXITPC") && !getenv("MELONDS_JIT_NOLINK");   // (ExitCheckPC)
+         OptSelfLoop = OptExitPC && !getenv("MELONDS_JIT_NOSELFLOOP");
++        OptIrqChain = OptExitStub && !getenv("MELONDS_JIT_NOIRQCHAIN");
+         OptKeepFlags = !old && !getenv("MELONDS_JIT_NOKEEPFLAGS");
+         // LOOPREGS only with MELONDS_JIT_LOOPREGS=1: on an RG DS Plus, HeartGold (USA) goes to a black screen at its
+         // first overworld frame with it (frame 1200 of tools/device/hgquick.sh's walk), and fine with it off alone.
+@@ -1049,11 +1050,14 @@ void Compiler::Gen_ExitStubs(int num)
+     // to ARM_Ret, which keeps the return stack in step.
+     u64* ts = num ? &NDS.ARM7Timestamp : &NDS.ARM9Timestamp;   // its Target is the next u64
+ 
+-    // the shared part: Timestamp += Cycles, Cycles = 0, to *stop/*late when the loop has to take over
+-    auto checks = [&](FixupBranch& stop, FixupBranch& late)
++    // the shared part: Timestamp += Cycles, Cycles = 0, to *stop/*late when the loop has to take over (*cont: past
++    // the StopExecution check, for irqMasked)
++    const u8* contDummy;
++    auto checks = [&](FixupBranch& stop, FixupBranch& late, const u8*& cont)
+     {
+         LDR(INDEX_UNSIGNED, W0, RCPU, offsetof(ARM, StopExecution));
+         stop = CBNZ(W0);
++        cont = (const u8*)GetRXPtr();
+         MOVP2R(X16, ts);
+         LDP(INDEX_SIGNED, X17, X0, X16, 0);
+         if (OptExitStub)
+@@ -1081,12 +1085,28 @@ void Compiler::Gen_ExitStubs(int num)
+         Write32((u32)(ret >> 32));
+     };
+ 
++    // IRQCHAIN, at *stop's target (StopExecution set, in W0): an IRQ is the only reason (Halted and IdleLoop, bytes
++    // 0 and 2, clear) and CPSR.I masks it: the loop would call TriggerIRQ, which returns at once, then go on to the
++    // next block as the stub does, so back to *cont. NZCV untouched (as the rest of the checks)
++    auto irqMasked = [&](FixupBranch& stop, const u8* cont)
++    {
++        SetJumpTarget(stop);
++        if (!OptIrqChain)
++            return;
++        ANDI2R(W16, W0, 0x00FF00FF);
++        FixupBranch hard = CBNZ(W16);
++        FixupBranch taken = TBZ(RCPSR, 7);
++        B(cont);
++        SetJumpTarget(hard);
++        SetJumpTarget(taken);
++    };
++
+     StubsStart[num * 2] = GetRXPtr();
+     if (!OptExitStub)
+     {
+         ExitCheck[num][0] = ExitCheck[num][1] = GetRXPtr();
+         FixupBranch stop, late;
+-        checks(stop, late);
++        checks(stop, late, contDummy);
+         STR(INDEX_UNSIGNED, RCPSR, RCPU, offsetof(ARM, CPSR));   // (the next block reads it from memory)
+         RET();
+         SetJumpTarget(stop);
+@@ -1104,11 +1124,12 @@ void Compiler::Gen_ExitStubs(int num)
+             STR(INDEX_UNSIGNED, W0, RCPU, offsetof(ARM, R[15]));
+             ExitCheck[num][c] = GetRXPtr();
+             FixupBranch stop, late;
+-            checks(stop, late);
++            const u8* cont;
++            checks(stop, late, cont);
+             if (c)
+                 STR(INDEX_UNSIGNED, RCPSR, RCPU, offsetof(ARM, CPSR));   // (the next block reads it from memory)
+             RET();
+-            SetJumpTarget(stop);
++            irqMasked(stop, cont);
+             SetJumpTarget(late);
+             retToLoop();
+         }
+@@ -1126,7 +1147,8 @@ void Compiler::Gen_ExitStubs(int num)
+     {
+         (a ? DynExitA : DynExit)[num][c] = GetRXPtr();
+         FixupBranch stop, late;
+-        checks(stop, late);
++        const u8* cont;
++        checks(stop, late, cont);
+         if (c)
+             STR(INDEX_UNSIGNED, RCPSR, RCPU, offsetof(ARM, CPSR));
+ 
+@@ -1186,7 +1208,10 @@ void Compiler::Gen_ExitStubs(int num)
+         }
+         ADD(X16, X17, W16, ArithOption(W16));   // + the entry's offset (uxtw)
+         BR(X16);
+-        SetJumpTarget(stop);
++        if (OptExitStub)
++            irqMasked(stop, cont);
++        else
++            SetJumpTarget(stop);
+         SetJumpTarget(late);
+         SetJumpTarget(outside);
+         SetJumpTarget(miss);
+diff --git a/src/ARMJIT_A64/ARMJIT_Compiler.h b/src/ARMJIT_A64/ARMJIT_Compiler.h
+index 4827724..bfeb825 100644
+--- a/src/ARMJIT_A64/ARMJIT_Compiler.h
++++ b/src/ARMJIT_A64/ARMJIT_Compiler.h
+@@ -284,6 +284,8 @@ public:
+     bool OptExitStub = true;      // NOEXITSTUB: shorter exit stubs, and no CPSR store when RCPSR is unchanged
+     bool OptExitPC = true;        // NOEXITPC: a constant exit's R15 stored by the exit stub, from a literal
+     bool OptSelfLoop = true;      // NOSELFLOOP: an exit back to its own block's start does the checks inline
++    bool OptIrqChain = true;      // NOIRQCHAIN (patch 0022): the exit stubs go on into the next block when the only
++                                  // stop reason is an IRQ that CPSR.I masks (the loop's TriggerIRQ would do nothing)
+     bool OptLoopRegs = false;     // LOOPREGS=1 (off by default): a block that loops back to its own start keeps the guest registers
+                                   // it uses in host registers round the loop (LoopMode)
+     bool LoopNoTs = false, LoopNoSigned = false, LoopNoLazy = false, LoopNoXfer = false;   // (LOOPREGS's parts)
+-- 
+2.43.0
+
diff --git a/bananads/src/emu.cpp b/bananads/src/emu.cpp
index f8500ca..b310209 100644
--- a/bananads/src/emu.cpp
+++ b/bananads/src/emu.cpp
@@ -362,6 +362,14 @@ bool Emu::load_rom(const std::string& path) {
         if (v == "on") setenv("MELONDS_JIT_HUGEPAGE", "1", 1);
         else if (v == "off") setenv("MELONDS_JIT_HUGEPAGE", "0", 1);
     }
+    // jit.irqchain=on|off: off sets MELONDS_JIT_NOIRQCHAIN=1, on unsets it (melonDS patch 0022: a block chain goes
+    // on past an IRQ that CPSR.I masks instead of going back to the loop, which would do nothing with it; exact;
+    // read as the JIT compiler is created; default on). As with jit.iofast, a difftest sets it on both --a and --b
+    {
+        const std::string v = cfg_.str("jit.irqchain", "");
+        if (v == "on") unsetenv("MELONDS_JIT_NOIRQCHAIN");
+        else if (v == "off") setenv("MELONDS_JIT_NOIRQCHAIN", "1", 1);
+    }
     // jit.codegen=new|old sets MELONDS_JIT_OLDCODEGEN (melonDS patch 0007: the AArch64 JIT's code generation
     // improvements, each also off by its own MELONDS_JIT_NO* variable), read as the JIT compiler is created; unset,
     // the environment decides (default new). For A/B runs, bananads-difftest --a jit.codegen=old --b jit.codegen=new.
-- 
2.43.0

