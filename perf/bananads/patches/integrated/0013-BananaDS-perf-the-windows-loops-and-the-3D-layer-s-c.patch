+// wm: the window mask to apply to a raw 3D quarter (render.2d_win_neon), or null
+template<bool needSecond, bool raw>
+static void MergeQuarterN(bool hasAbove, int belowKind, const u32* c3line, const u8* wm, const u32* base, const u32* belowTop, const u32* belowSec, const u32* aboveTop, const u32* aboveSec, u32* outTop, u32* outSecond)
