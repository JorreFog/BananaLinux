+#!/usr/bin/env python3
+"""Build bigcode .nds ROMs: a game-sized ARM9 code footprint for measuring a JIT's instruction fetch (L1I, iTLB).
+
+    build.py [N] -> out/bigcode-thumb.nds (N generated functions, default 500, as Thumb with one in eight ARM: games'
+                    mix), out/bigcode-arm.nds (all ARM)
+cpubench (tests/cpubench) is a few hot loops: its JIT code is ~180 KB and the hot part a few KB, so it can't show what
+a game's spread of code does to the A55's 32 KB L1I and its TLBs. Here each pass calls every one of N distinct
+functions (loads, stores, branches, small loops, calls into shared helpers, halfword and byte accesses, the divider
+now and then) in an order shuffled every pass, so the JIT's blocks for all of them run every frame, about once
+each per pass. The top screen shows the pass count and the checksums (VRAM A as a bitmap). Generated with a fixed
+seed, so the ROM is the same on every build. Needs clang + ld.lld + llvm-objcopy; the header and startup are cpubench's.
+"""
+import os, random, struct, subprocess, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+OUT = os.path.join(HERE, "out"); os.makedirs(OUT, exist_ok=True)
+N = int(sys.argv[1]) if len(sys.argv) > 1 else 500
+LD = """ENTRY(%s)
+SECTIONS {
+  . = %s;
+  .text : { *(.text.start) *(.text*) *(.rodata*) }
+  . = ALIGN(0x10000);
+  .data : { *(.data*) }
+  . = ALIGN(4);
+  __bss_start = .;
+  .bss : { *(.bss*) *(COMMON) }
+  . = ALIGN(4);
+  __bss_end = .;
+  __itcm_start = .; __itcm_end = .;
+  /DISCARD/ : { *(.ARM.exidx*) *(.ARM.extab*) }
+}
+"""
+CF = ["-O2", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables", "-ffreestanding", "-fno-builtin", "-nostdlib",
+      "-Wall", "-Wno-unused-variable", "-Wno-unused-function"]
+
+def gen(seed=20261018):
+    r = random.Random(seed)
+    out = ["/* generated by build.py: do not edit */",
+           "typedef unsigned int u32; typedef unsigned short u16; typedef unsigned char u8; typedef int s32;",
+           "#define R32(a) (*(volatile u32 *)(a))", "#define R16(a) (*(volatile u16 *)(a))",
+           "#define NOINLINE __attribute__((noinline))", "#define ARMF __attribute__((target(\"arm\"), noinline))",
+           "struct S { u32 v[64]; u16 h[64]; u8 b[256]; u32 tab[64]; };",
+           "static NOINLINE s32 hwdiv(s32 n, s32 d) { R16(0x04000280) = 0; R32(0x04000290) = (u32)n; R32(0x04000294) = (u32)(n >> 31);",
+           "  R32(0x04000298) = (u32)d; R32(0x0400029C) = (u32)(d >> 31); while (R16(0x04000280) & 0x8000) ; return (s32)R32(0x040002A0); }"]
+    H = 24
+    for h in range(H):
+        a, b = r.randrange(1, 31), r.randrange(1, 1 << 16)
+        out.append(f"static NOINLINE u32 h{h}(u32 x) {{ return (x << {a}) ^ (x >> {32 - a}) ^ {b}u; }}")
+    def stmt(depth):
+        k = r.randrange(14)
+        c1, c2, c3 = r.randrange(64), r.randrange(64), r.randrange(1, 255)
+        if k == 0: return f"a += s->v[{c1}]; s->v[{c2}] = a ^ {c3}u;"
+        if k == 1: return f"b = s->h[(a >> {r.randrange(1, 9)}) & 63] + {c3}; s->h[{c1}] = (u16)(b ^ a);"
+        if k == 2: return f"a = (a * {2 * c3 + 1}u) + s->tab[b & 63];"
+        if k == 3: return f"if (a & {1 << r.randrange(8)}) {{ a ^= s->v[{c1}] << {r.randrange(1, 9)}; }} else {{ b += s->v[{c2}]; }}"
+        if k == 4: return f"s->b[(a + {c3}) & 255] = (u8)b; a += s->b[(b ^ {c1}) & 255];"
+        if k == 5 and depth == 0:
+            n = r.randrange(2, 6)
+            return f"for (int i = 0; i < {n}; i++) {{ a += s->tab[(a ^ i) & 63]; b ^= a >> {r.randrange(1, 9)}; }}"
+        if k == 6: return f"a = h{r.randrange(H)}(a + b);"
+        if k == 7: return f"b = (a > {c3 * 1000}u) ? b - a : b + {c3};"
+        if k == 8: return f"switch (a & 3) {{ case 0: a += {c1}; break; case 1: b ^= {c2}; break; case 2: a -= b; break; default: b += a; }}"
+        if k == 9 and r.randrange(6) == 0: return f"a += (u32)hwdiv((s32)(a & 0xFFFF), (s32)(b & 255) + 3);"
+        if k == 10: return f"s->v[{c1}] += a; s->v[{c2}] -= b;"
+        if k == 11: return f"a = (a >> {r.randrange(1, 31)}) | (b << {r.randrange(1, 31)});"
+        if k == 12: return f"if ((b & {c3}) == {c3 & r.randrange(256)}) return a ^ b;"
+        return f"b += a * {c3}u; a ^= b >> {r.randrange(1, 31)};"
+    for i in range(N):
+        attr = "ARMF" if r.randrange(8) == 0 else "NOINLINE"
+        body = " ".join(stmt(0) for _ in range(r.randrange(5, 14)))
+        out.append(f"static {attr} u32 f{i}(struct S *s, u32 x) {{ u32 a = x + {r.randrange(1 << 20)}u, b = s->v[{r.randrange(64)}]; {body} return a + b; }}")
+    out.append("typedef u32 (*fn)(struct S *, u32);")
+    out.append("const fn funcs[%d] = {%s};" % (N, ", ".join(f"f{i}" for i in range(N))))
+    out.append(f"const int nfuncs = {N};")
+    return "\n".join(out) + "\n"
+
+MAIN = r"""
+typedef unsigned int u32; typedef unsigned short u16; typedef unsigned char u8;
+#define R32(a) (*(volatile u32 *)(a))
+#define R8(a) (*(volatile u8 *)(a))
+struct S { u32 v[64]; u16 h[64]; u8 b[256]; u32 tab[64]; };
+typedef u32 (*fn)(struct S *, u32);
+extern const fn funcs[]; extern const int nfuncs;
+void *memset(void *d, int c, unsigned long n) { u8 *p = d; while (n--) *p++ = (u8)c; return d; }
+void *memcpy(void *d, const void *s, unsigned long n) { u8 *p = d; const u8 *q = s; while (n--) *p++ = *q++; return d; }
+static struct S st;
+static unsigned short order[8192];
+static void draw(const u32 *v, int n)
+{
+    volatile unsigned short *fb = (volatile unsigned short *)0x06800000;
+    for (int r = 0; r < n; r++)
+        for (int b = 0; b < 32; b++) {
+            unsigned short col = (v[r] >> b) & 1 ? 0x7FFF : (unsigned short)(0x0010 + r * 0x0C00);
+            for (int y = 0; y < 4; y++)
+                for (int x = 0; x < 4; x++) fb[(8 + r * 6 + y) * 256 + 8 + b * 7 + x] = col;
+        }
+}
+int main(void)
+{
+    R32(0x04000304) = 0x8003; R8(0x04000240) = 0x80; R32(0x04000000) = 0x00020000;
+    for (int i = 0; i < 64; i++) { st.v[i] = i * 0x9E3779B9u; st.tab[i] = (u32)i * 2654435761u; st.h[i] = (unsigned short)(i * 977); }
+    for (int i = 0; i < 256; i++) st.b[i] = (u8)(i * 31);
+    for (int i = 0; i < nfuncs; i++) order[i] = (unsigned short)i;
+    u32 seed = 12345, acc = 1, pass = 0, sums[4] = {0, 0, 0, 0};
+    for (;;) {
+        pass++;
+        for (int i = nfuncs - 1; i > 0; i--) {   /* this pass's order */
+            seed = seed * 1664525u + 1013904223u;
+            int j = (int)(((seed >> 16) * (u32)(i + 1)) >> 16);   /* (no divide: no libgcc) */
+            unsigned short t = order[i]; order[i] = order[j]; order[j] = t;
+        }
+        for (int i = 0; i < nfuncs; i++) acc = funcs[order[i]](&st, acc) + (acc << 1);
+        sums[0] = pass; sums[1] ^= acc; sums[2] += st.v[pass & 63]; sums[3] = sums[3] * 31 + st.h[pass & 63];
+        draw(sums, 4);
+    }
+}
+"""
+def run(cmd): subprocess.run(cmd, check=True, cwd=HERE)
+def link(name, objs, entry, base):
+    ld = os.path.join(OUT, name + ".ld")
+    open(ld, "w").write(LD % (entry, base))
+    run(["ld.lld", "-T", ld, *objs, "-o", f"out/{name}.elf"])
+    run(["llvm-objcopy", "-O", "binary", f"out/{name}.elf", f"out/{name}.bin"])
+    return open(os.path.join(OUT, name + ".bin"), "rb").read()
+def arm9(mode):
+    open(os.path.join(OUT, "funcs.c"), "w").write(gen() if mode == "thumb" else gen().replace("ARMF u32", "NOINLINE u32"))
+    open(os.path.join(OUT, "main9.c"), "w").write(MAIN)
+    for src in ("funcs", "main9"):
+        run(["clang", "--target=armv5te-none-eabi", "-m" + mode, "-mfloat-abi=soft", *CF, "-c", f"out/{src}.c", "-o", f"out/{src}-{mode}.o"])
+    run(["clang", "--target=armv5te-none-eabi", "-marm", "-c", "crt9.s", "-o", "out/crt9.o"])
+    return link("arm9-" + mode, ["out/crt9.o", f"out/main9-{mode}.o", f"out/funcs-{mode}.o"], "_start", "0x02000000")
+HALT7 = struct.pack("<5I", 0xE59F0008, 0xE3A01080, 0xE5C01001, 0xEAFFFFFB, 0x04000300)   # HALTCNT <- 0x80, loop
+def crc16(data, crc=0xFFFF):
+    for b in data:
+        crc ^= b
+        for _ in range(8): crc = (crc >> 1) ^ 0xA001 if crc & 1 else crc >> 1
+    return crc
+def rom(name, a9, a7):
+    a9 = bytearray(a9) + b"\0" * (-len(a9) % 0x200)
+    a9off = 0x8000; a7off = a9off + len(a9)
+    body = bytearray(0x8000) + a9 + a7
+    body += b"\0" * (-len(body) % 0x200)
+    h = bytearray(0x200)
+    h[0:12] = b"BIGCODE".ljust(12, b"\0"); h[12:16] = b"BIGC"; h[16:18] = b"00"
+    struct.pack_into("<8I", h, 0x20, a9off, 0x02000000, 0x02000000, len(a9), a7off, 0x02380000, 0x02380000, len(a7))
+    struct.pack_into("<2I", h, 0x60, 0x00586000, 0x001808F8)
+    struct.pack_into("<2I", h, 0x80, len(body), 0x200)
+    struct.pack_into("<H", h, 0x15E, crc16(h[:0x15E]))
+    body[0:0x200] = h
+    body += b"\xff" * (0x20000 - len(body)) if len(body) < 0x20000 else b""
+    open(os.path.join(OUT, name), "wb").write(body)
+    return name
+t, a = arm9("thumb"), arm9("arm")
+print("arm9", len(t), len(a), "->", rom("bigcode-thumb.nds", t, HALT7), rom("bigcode-arm.nds", a, HALT7))
