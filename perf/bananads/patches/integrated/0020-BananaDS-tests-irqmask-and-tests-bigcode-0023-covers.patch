diff --git a/bananads/tests/irqmask/irq.s b/bananads/tests/irqmask/irq.s
new file mode 100644
index 0000000..a2f7744
--- /dev/null
+++ b/bananads/tests/irqmask/irq.s
@@ -0,0 +1,101 @@
+@ irqmask: the ARM9's IRQ handler (the BIOS calls it in IRQ mode, CPSR.I set, at DTCM+0x3FFC). It acknowledges IF,
+@ counts each source, folds the interrupted code's progress counter into a hash (so the exact moment every IRQ is
+@ taken shows in RAM and on screen), and for VBlank runs a long loop in IRQ mode (other IRQs pend, masked, meanwhile).
+@ Timer 1's IRQ nests: the handler switches to system mode with IRQs on, runs nested_work (C), and comes back.
+    .arm
+    .global irq_handler
+    .type irq_handler, %function
+irq_handler:
+    ldr     r0, =0x04000000
+    ldr     r1, [r0, #0x214]        @ IF
+    ldr     r2, [r0, #0x210]        @ IE
+    and     r1, r1, r2
+    ldr     r2, =irq_state          @ [0] VBlank [1] HBlank [2] timer 0 [3] timer 1 [4] hash [5] nested depth
+    ldr     r3, =progress
+    ldr     r3, [r3]
+    ldr     r12, [r2, #16]
+    eor     r12, r3, r12, ror #27
+    add     r12, r12, r1
+    str     r12, [r2, #16]          @ hash = rol(hash, 5) ^ progress + sources
+    tst     r1, #1
+    ldrne   r3, [r2]
+    addne   r3, r3, #1
+    strne   r3, [r2]
+    tst     r1, #2
+    ldrne   r3, [r2, #4]
+    addne   r3, r3, #1
+    strne   r3, [r2, #4]
+    tst     r1, #8
+    ldrne   r3, [r2, #8]
+    addne   r3, r3, #1
+    strne   r3, [r2, #8]
+    bic     r3, r1, #0x10           @ acknowledge all but timer 1 now
+    str     r3, [r0, #0x214]
+    tst     r1, #1
+    beq     1f
+    mov     r3, #0                  @ VBlank: a long loop with I set
+    ldr     r12, [r2, #16]
+2:  add     r12, r12, r3
+    eor     r12, r12, r12, lsr #3
+    add     r3, r3, #1
+    cmp     r3, #3072
+    blt     2b
+    str     r12, [r2, #16]
+1:  tst     r1, #0x10
+    beq     3f
+    str     r1, [r0, #0x214]        @ timer 1: acknowledge, then nest
+    ldr     r3, [r2, #12]
+    add     r3, r3, #1
+    str     r3, [r2, #12]
+    mrs     r3, spsr
+    stmfd   sp!, {r3, lr}           @ (IRQ mode's own stack)
+    msr     cpsr_c, #0x1F           @ system mode, IRQs on: others may come in now
+    stmfd   sp!, {r0-r3, r12, lr}   @ (the interrupted code's lr_sys)
+    ldr     r3, =nested_work
+    blx     r3
+    ldmfd   sp!, {r0-r3, r12, lr}
+    msr     cpsr_c, #0x92           @ IRQ mode, I set
+    ldmfd   sp!, {r3, lr}
+    msr     spsr_cxsf, r3
+3:  mrc     p15, 0, r0, c9, c1, 0
+    bic     r0, r0, #0xFF
+    bic     r0, r0, #0xF00
+    add     r0, r0, #0x3F00
+    ldr     r2, [r0, #0xF8]         @ the BIOS's IRQ flags (IntrWait)
+    orr     r2, r2, r1
+    str     r2, [r0, #0xF8]
+    bx      lr
+    .pool
+
+@ ARM helpers the main code calls (Thumb or ARM) for CPSR changes
+    .global irq_off
+    .type irq_off, %function
+irq_off:                            @ returns the old CPSR
+    mrs     r0, cpsr
+    orr     r1, r0, #0x80
+    msr     cpsr_c, r1
+    bx      lr
+    .global irq_restore
+    .type irq_restore, %function
+irq_restore:
+    msr     cpsr_c, r0
+    bx      lr
+    .global svc_spin                @ r0 iterations in supervisor mode (I and F set), registers only
+    .type svc_spin, %function
+svc_spin:
+    mrs     r2, cpsr
+    msr     cpsr_c, #0xD3
+    mov     r1, #0
+1:  add     r1, r1, r0, lsl #1
+    eor     r1, r1, r1, lsr #5
+    subs    r0, r0, #1
+    bne     1b
+    msr     cpsr_c, r2
+    mov     r0, r1
+    bx      lr
+    .global halt_cp15               @ the ARM9's wait-for-interrupt (CP15 c7,c0,4)
+    .type halt_cp15, %function
+halt_cp15:
+    mov     r0, #0
+    mcr     p15, 0, r0, c7, c0, 4
+    bx      lr
diff --git a/bananads/tests/irqmask/main7.c b/bananads/tests/irqmask/main7.c
new file mode 100644
index 0000000..1713c4b
--- /dev/null
+++ b/bananads/tests/irqmask/main7.c
@@ -0,0 +1,35 @@
+/* irqmask ARM7: masked stretches with timer 2's IRQ (fast) pending, unmasked ones, and a handler that hashes the
+   progress counter (so when each IRQ is taken shows in RAM: main RAM 0x02300000) */
+typedef unsigned int u32; typedef unsigned short u16; typedef unsigned char u8;
+#define R32(a) (*(volatile u32 *)(a))
+#define R16(a) (*(volatile u16 *)(a))
+#define ARM __attribute__((target("arm"), noinline))
+#define NOINLINE __attribute__((noinline))
+volatile u32 progress7, hash7, ticks7;
+static u32 tab[64];
+static volatile u32 *const box = (volatile u32 *)0x02300000;
+ARM void irq7(void)
+{
+    u32 f = R32(0x04000214) & R32(0x04000210);
+    R32(0x04000214) = f;
+    hash7 = ((hash7 << 5) | (hash7 >> 27)) ^ progress7;
+    ticks7++;
+    *(volatile u32 *)0x0380FFF8 |= f;
+}
+ARM u32 off7(void) { u32 c; __asm__ volatile("mrs %0, cpsr\n orr r1, %0, #0x80\n msr cpsr_c, r1" : "=r"(c) : : "r1"); return c; }
+ARM void restore7(u32 c) { __asm__ volatile("msr cpsr_c, %0" : : "r"(c)); }
+static NOINLINE u32 step(u32 x) { progress7++; return x * 31 + tab[x & 63]; }
+static NOINLINE u32 work7(u32 s, int n) { for (int i = 0; i < n; i++) { s = step(s + i); if (s & 4) s ^= step(s); } return s; }
+int main7(void)
+{
+    for (int i = 0; i < 64; i++) tab[i] = i * 0x9E3779B9u;
+    *(volatile u32 *)0x0380FFFC = (u32)irq7;
+    R16(0x04000108) = 0xF800; R16(0x0400010A) = 0x00C0;      /* timer 2: /1, reload 0xF800, IRQ */
+    R32(0x04000210) = 0x20; R32(0x04000208) = 1; restore7(off7() & ~0x80u);
+    u32 acc = 0;
+    for (;;) {
+        u32 c = off7(); acc = work7(acc, 200); restore7(c);
+        acc = work7(acc, 100);
+        box[0] = progress7; box[1] = hash7; box[2] = ticks7; box[3] = acc;
+    }
+}
diff --git a/bananads/tests/irqmask/main9.c b/bananads/tests/irqmask/main9.c
new file mode 100644
index 0000000..e55c3ec
--- /dev/null
+++ b/bananads/tests/irqmask/main9.c
@@ -0,0 +1,107 @@
+/* irqmask ARM9: long stretches of work with CPSR.I set while IRQs are pending, for the JIT's exit stubs (BananaDS's
+   melonDS patch 0023, jit.irqchain: a chain of blocks goes on past an IRQ that CPSR.I masks). HBlank (every line),
+   VBlank and two fast timers keep IRQs pending; the main loop runs masked sections (calls, returns, function
+   pointers, loops, memory, IME and IE changes, a supervisor-mode stretch, a CP15 halt with an IRQ pending) and
+   unmasked ones; the handler (irq.s) hashes a progress counter the code bumps everywhere, so when each IRQ is taken
+   shows in RAM and on the top screen, and VBlank's handler loops for a while in IRQ mode, timer 1's nests.
+   Written for this test. */
+typedef unsigned int u32; typedef unsigned short u16; typedef unsigned char u8; typedef int s32;
+#define R32(a) (*(volatile u32 *)(a))
+#define R16(a) (*(volatile u16 *)(a))
+#define R8(a) (*(volatile u8 *)(a))
+#define ARM __attribute__((target("arm"), noinline))
+#define NOINLINE __attribute__((noinline))
+volatile u32 irq_state[8];
+volatile u32 progress;
+extern void irq_handler(void);
+extern u32 irq_off(void);
+extern void irq_restore(u32);
+extern u32 svc_spin(u32);
+extern void halt_cp15(void);
+static u32 tab[256];
+static u16 half[256];
+#define STEP() (progress++)
+
+static NOINLINE u32 leaf_a(u32 x) { STEP(); return x * 2654435761u + tab[x & 255]; }
+static NOINLINE u32 leaf_b(u32 x) { STEP(); half[x & 255] = (u16)x; return (x >> 3) ^ half[(x >> 8) & 255]; }
+ARM u32 leaf_arm(u32 x) { STEP(); u32 s = x; for (int i = 0; i < 4; i++) s = s * 33 + tab[(s >> 4) & 255]; return s; }
+static NOINLINE u32 mid(u32 x, int d) { STEP(); if (d <= 0) return leaf_a(x); return mid(leaf_b(x), d - 1) + leaf_arm(x); }
+typedef u32 (*fn)(u32);
+static fn const table[4] = { leaf_a, leaf_b, leaf_arm, leaf_b };
+u32 nested_work(void) { u32 s = 0; for (int i = 0; i < 40; i++) { s += table[i & 3](s + i); } tab[s & 255] ^= s; return s; }
+
+/* the work: calls (BL), returns (BX LR, POP {PC}), function pointers, a loop, loads and stores */
+static NOINLINE u32 work(u32 seed, int n)
+{
+    u32 a = seed;
+    for (int i = 0; i < n; i++) {
+        STEP();
+        a = table[(a >> 5) & 3](a + i);
+        if (a & 0x100) a ^= mid(a, 2);
+        tab[(a + i) & 255] += a;
+    }
+    return a;
+}
+static NOINLINE u32 masked_plain(u32 seed) { u32 c = irq_off(); u32 r = work(seed, 300); irq_restore(c); return r; }
+static NOINLINE u32 masked_ime(u32 seed)
+{
+    u32 c = irq_off();
+    u32 r = work(seed, 60);
+    R32(0x04000208) = 0;  r += work(r, 40);          /* IME off: the IRQ flag drops */
+    R32(0x04000208) = 1;  r += work(r, 40);          /* back on: pending again */
+    R32(0x04000210) = 0x1;  r += work(r, 30);         /* IE: VBlank only */
+    R32(0x04000210) = 0x1B; r += work(r, 30);
+    irq_restore(c);
+    return r;
+}
+static NOINLINE u32 masked_svc(u32 seed) { u32 c = irq_off(); u32 r = work(seed, 50); r += svc_spin(2000 + (seed & 255)); r += work(r, 50); irq_restore(c); return r; }
+static NOINLINE u32 masked_halt(u32 seed)
+{
+    u32 c = irq_off();
+    u32 r = work(seed, 20);
+    halt_cp15();                                      /* returns when IF & IE: an IRQ pending, not taken */
+    r += progress;
+    r += work(r, 40);
+    irq_restore(c);
+    return r;
+}
+static NOINLINE u32 unmasked(u32 seed) { return work(seed, 200); }
+static void draw(const u32 *v, int n)
+{
+    volatile u16 *fb = (volatile u16 *)0x06800000;
+    for (int r = 0; r < n; r++)
+        for (int b = 0; b < 32; b++) {
+            u16 col = (v[r] >> b) & 1 ? 0x7FFF : (u16)(0x0010 + r * 0x0C00);
+            for (int y = 0; y < 4; y++)
+                for (int x = 0; x < 4; x++) fb[(8 + r * 6 + y) * 256 + 8 + b * 7 + x] = col;
+        }
+}
+ARM u32 dtcm_base(void) { u32 d; __asm__ volatile("mrc p15, 0, %0, c9, c1, 0" : "=r"(d)); return d & ~0xFFFu; }
+int main(void)
+{
+    R32(0x04000304) = 0x8003;                      /* POWCNT1: LCDs, 2D A, top screen */
+    R8(0x04000240) = 0x80;                          /* VRAM A: LCDC */
+    R32(0x04000000) = 0x00020000;
+    for (int i = 0; i < 256; i++) { tab[i] = i * 0x9E3779B9u; half[i] = (u16)(i * 977); }
+    R32(dtcm_base() + 0x3FFC) = (u32)irq_handler;
+    R16(0x04000004) = 0x0018;                       /* DISPSTAT: VBlank and HBlank IRQs */
+    R16(0x04000100) = 0xF000; R16(0x04000102) = 0x00C0;   /* timer 0: /1, reload 0xF000, IRQ */
+    R16(0x04000104) = 0xC000; R16(0x04000106) = 0x00C1;   /* timer 1: /64, IRQ (nests) */
+    R32(0x04000210) = 0x1B;                         /* IE: VBlank, HBlank, timers 0 and 1 */
+    R32(0x04000208) = 1;
+    irq_restore(irq_off() & ~0x80u);                /* IRQs on in the CPSR */
+    static u32 sums[12];
+    u32 pass = 0;
+    for (;;) {
+        pass++;
+        sums[0] += masked_plain(pass);
+        sums[1] += unmasked(pass);
+        sums[2] += masked_ime(pass);
+        sums[3] += masked_svc(pass);
+        sums[4] += masked_halt(pass);
+        sums[5] = progress;
+        for (int i = 0; i < 6; i++) sums[6 + i] = irq_state[i];
+        sums[0] ^= pass << 24;
+        draw(sums, 12);
+    }
+}
