@@ -2947,7 +3050,6 @@ void BananaRenderer2D::CompositeTo(u32* dst)
         return;
     }
 
-    Composite(TopLine, SecondLine, true);
 #ifdef BANANA_NEON
     if (Banana2DFast)
     {
