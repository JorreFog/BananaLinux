 // render.2d_steps_cache (default on): the compositor's step list (which layer lines, in which order, from which
 // one up) is rebuilt only when the inputs it depends on changed since the last line
 extern bool Banana2DStepsCache;
+// render.2d_conv16 (default on): direct-colour bitmap rows (ConvertRun16) 16 pixels a NEON step, the layer's drawn/full
