     // read as the JIT compiler is created; default on). As with jit.iofast, a difftest sets it on both --a and --b
     {
@@ -370,6 +370,14 @@ bool Emu::load_rom(const std::string& path) {
         if (v == "on") unsetenv("MELONDS_JIT_NOIRQCHAIN");
         else if (v == "off") setenv("MELONDS_JIT_NOIRQCHAIN", "1", 1);
     }
+    // jit.entry_x26=on|off: off sets MELONDS_JIT_NOENTRYX26=1, on unsets it (melonDS patch 0024: ARM_Dispatch sets the
+    // fast memory base, so blocks have no entry prologue: smaller code; exact; read as the JIT compiler is created;
+    // default on). As with jit.irqchain, a difftest sets it on both --a and --b
+    {
+        const std::string v = cfg_.str("jit.entry_x26", "");
+        if (v == "on") unsetenv("MELONDS_JIT_NOENTRYX26");
+        else if (v == "off") setenv("MELONDS_JIT_NOENTRYX26", "1", 1);
+    }
     // jit.codegen=new|old sets MELONDS_JIT_OLDCODEGEN (melonDS patch 0007: the AArch64 JIT's code generation
     // improvements, each also off by its own MELONDS_JIT_NO* variable), read as the JIT compiler is created; unset,
     // the environment decides (default new). For A/B runs, bananads-difftest --a jit.codegen=old --b jit.codegen=new.
