-int BananaRenderer2D::BuildSteps(CompStep* steps, u8* full, int& bg0, bool needSecond, int& start, const u32*& startLine)
-{
+int BananaRenderer2D::BuildSteps(const CompStep*& steps, int& bg0, bool needSecond, int& start, const u32*& startLine)
+{
+    // render.2d_steps_cache: the steps depend on the layers drawn and full, the sprite priorities present, the BGs'
+    // priorities, the raw 3D path and needSecond, the same on most consecutive lines (the layer lines, OBJColor and
+    // the backdrop are fixed buffers): kept while that key holds. The raw 3D step's line is the one per-line input
+    const u64 key = (1ull << 63) | LayerDrawn | ((u64)LayerFull << 8) | ((u64)OBJPrioPresent << 16) | ((u64)Raw3D << 24)
+                  | ((u64)needSecond << 25) | ((u64)(R.BGCnt[0] & 3) << 32) | ((u64)(R.BGCnt[1] & 3) << 34)
+                  | ((u64)(R.BGCnt[2] & 3) << 36) | ((u64)(R.BGCnt[3] & 3) << 38);
+    steps = Steps;
+    if (Banana2DStepsCache && key == StepsKey)
+    {
+        bg0 = StepsBg0;
+        start = StepsStart;
+        startLine = StepsStartLine;
+        if (bg0 >= 0 && Steps[bg0].raw3d) Steps[bg0].line = Line3D;
+        return StepsN;
+    }
     int n = 0;
     bg0 = -1;
+    u8 full[8];
     // sprites of a single priority: every opaque OBJColor pixel has it, no priority test
     // (fast: the priority is read from OBJLine's bits 16-17, ResolveSpritesNeon doesn't write OBJPrio)
     const u32* objprio = !Banana2DFast ? OBJPrio : !(OBJPrioPresent & (OBJPrioPresent - 1)) ? nullptr : OBJLine;
@@ -2415,7 +2425,7 @@ int BananaRenderer2D::BuildSteps(CompStep* steps, u8* full, int& bg0, bool needS
             if ((LayerDrawn & (1<<bg)) && ((R.BGCnt[bg] & 0x3) == p))
             {
                 bool raw = (bg == 0) && Raw3D;
-                steps[n] = { raw ? Line3D : BGLine(bg), nullptr, 0, 0, raw };
+                Steps[n] = { raw ? Line3D : BGLine(bg), nullptr, 0, 0, raw };
                 full[n] = (LayerFull >> bg) & 1;
                 if (bg == 0) bg0 = n;
                 n++;
@@ -2423,7 +2433,7 @@ int BananaRenderer2D::BuildSteps(CompStep* steps, u8* full, int& bg0, bool needS
         }
         if (OBJPrioPresent & (1<<p))
         {
-            steps[n] = { OBJColor, objprio, (u32)p << prioshift, priomask, false };
+            Steps[n] = { OBJColor, objprio, (u32)p << prioshift, priomask, false };
             full[n] = 0;
             n++;
         }
@@ -2441,11 +2451,16 @@ int BananaRenderer2D::BuildSteps(CompStep* steps, u8* full, int& bg0, bool needS
             if (found == wanted)
             {
                 start = k + 1;
-                startLine = steps[k].line;
