-
-void BananaRenderer2D::PrepareScanline(Banana2DRegs& regs)
-{
-    regs.From(GPU2D);
-    if (NeedResync)
-        DoResync();
-
-    if (!GPU2D.Enabled || GPU2D.ForcedBlank)
-        return;
-
-    // the windows' horizontal state after the line, as CalcWindowMask leaves it: whatever it was before the line,
-    // the last of the two edges wins (x2 when they are equal)
-    u32 dispcnt = GPU2D.DispCnt;
-    if (dispcnt & (1<<14))
-        GPU2D.Win1Active = (GPU2D.Win1Active & 0x1) | ((GPU2D.Win1Coords[1] < GPU2D.Win1Coords[0]) ? 0x2 : 0);
-    if (dispcnt & (1<<13))
-        GPU2D.Win0Active = (GPU2D.Win0Active & 0x1) | ((GPU2D.Win0Coords[1] < GPU2D.Win0Coords[0]) ? 0x2 : 0);
-
-    if (ExtPalsResynced)
-    {
-        regs.BGExtChanged = regs.OBJExtChanged = true;
-        ExtPalsResynced = false;
-    }
-
-    if (GPU2D.Num == 0)
-    {
-        // (render.2d_fast: a set with nothing remapped or written since the last line, most lines, is skipped
-        // without deriving it (VRAMTrackingSet::Unchanged, melonDS patch 0012), and an empty derived set has nothing
-        // to make coherent or copy. Deriving one set never changes another's state except through the dirty bits
-        // it clears, and the sets are still derived in the same order, so this is exact.)
-        const bool all = !Banana2DFast;
