-
-void BananaRenderer2D::DrawScanline(u32 line)
-{
-    if (Banana2DFast)
-    {
-        // (render.2d_fast: the snapshot goes straight into R, no second copy)
-        PrepareScanline(R);
-        DrawScanlineFrom(line, R, Parent.Output3D);
-        return;
