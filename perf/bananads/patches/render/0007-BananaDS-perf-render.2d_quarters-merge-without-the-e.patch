From 88a772a2cff36b0d417c76febffd544caa4a6241 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 16:16:06 +0000
Subject: [PATCH 7/9] BananaDS perf: render.2d_quarters' merge without the
 empty halves, the backdrop as a constant

Measured on the device build (qemu-count, dsstress L5, device configuration): the four-quarter merge cost as much as
the two-step composites it replaced (the 2D thread's composite work 812k -> 890k instructions a frame), because a
line with no layer above the 3D one still read a zero line written for it (CompositeN<0>, 164k a frame), and the
base was read as a line when it is the backdrop's one colour. The merge now has the halves as template cases: no
above layer (no above lines read), the below pixel as the backdrop constant, a base line, or the below lines; the
empty halves' passes are skipped. Random-stack test (every case, including the base read as a line): 20000 quarter
cases, 0 mismatches.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PvbFhKAw3ERk5a13S651g1
---
 bananads/gpu2d/GPU2D_Banana.cpp | 569 +++-----------------------------
 1 file changed, 47 insertions(+), 522 deletions(-)

diff --git a/bananads/gpu2d/GPU2D_Banana.cpp b/bananads/gpu2d/GPU2D_Banana.cpp
index fa7ab48..caf92ba 100644
--- a/bananads/gpu2d/GPU2D_Banana.cpp
+++ b/bananads/gpu2d/GPU2D_Banana.cpp
@@ -2436,31 +2436,62 @@ void BananaRenderer2D::Composite(u32* outTop, u32* outSecond, bool needSecond)
 // BelowSec, the pixel under it), the layers above it painted onto nothing (AboveTop, AboveSec: nonzero where an
 // above layer is opaque, where two are). A quarter's top pixel is then the above one where there is one, else the
 // 3D pixel where it is opaque, else the below one; its second pixel follows the same painter's rule (the pixel that
-// was on top before the last opaque step). The same pixels as the four full passes, in a quarter of the work
-template<bool needSecond, bool raw>
-static void MergeQuarter(const u32* c3line, const u32* belowTop, const u32* belowSec, const u32* aboveTop, const u32* aboveSec, u32* outTop, u32* outSecond)
+// was on top before the last opaque step). With no layer above there is no above line to read, and with none below
+// the base itself is the below pixel (a constant when it is the backdrop). The same pixels as the four full passes.
+// belowKind: 0 the backdrop's colour, 1 a base line, 2 BelowTop/BelowSec
+template<bool needSecond, bool raw, bool hasAbove, int belowKind>
+static void MergeQuarter(const u32* c3line, const u32* base, const u32* belowTop, const u32* belowSec, const u32* aboveTop, const u32* aboveSec, u32* outTop, u32* outSecond)
 {
     const V4 flagbyte = VDup(0xFF000000), orv = VDup(0x40000000);
+    const V4 backdrop = VDup(base[0]);
     for (int i = 0; i < 256; i += 4)
     {
         V4 c = VLoad(c3line + i);
         V4 m3;
         if (raw) { m3 = VNonZero(VAnd(c, flagbyte)); c = VOr(c, orv); }
         else     m3 = VNonZero(c);
-        V4 bt = VLoad(belowTop + i);
+        V4 bt = belowKind == 0 ? backdrop : belowKind == 1 ? VLoad(base + i) : VLoad(belowTop + i);
         V4 L = VSel(m3, c, bt);                 // the top after the 3D step
-        V4 at = VLoad(aboveTop + i);
-        V4 ma = VNonZero(at);
-        VStore(outTop + i, VSel(ma, at, L));
+        V4 top = L, ma = VZero();
+        if (hasAbove)
+        {
+            V4 at = VLoad(aboveTop + i);
+            ma = VNonZero(at);
+            top = VSel(ma, at, L);
+        }
+        VStore(outTop + i, top);
         if (needSecond)
         {
-            V4 Ls = VSel(m3, bt, VLoad(belowSec + i));   // the second after the 3D step
-            V4 as = VLoad(aboveSec + i);
-            VStore(outSecond + i, VSel(ma, VSel(VNonZero(as), as, L), Ls));
+            V4 bs = belowKind == 2 ? VLoad(belowSec + i) : VZero();
+            V4 Ls = VSel(m3, bt, bs);           // the second after the 3D step
+            V4 sec = Ls;
+            if (hasAbove)
+            {
+                V4 as = VLoad(aboveSec + i);
+                sec = VSel(ma, VSel(VNonZero(as), as, L), Ls);
+            }
+            VStore(outSecond + i, sec);
         }
     }
 }
 
+template<bool needSecond, bool raw>
+static void MergeQuarterN(bool hasAbove, int belowKind, const u32* c3line, const u32* base, const u32* belowTop, const u32* belowSec, const u32* aboveTop, const u32* aboveSec, u32* outTop, u32* outSecond)
+{
+    if (hasAbove)
+    {
+        if (belowKind == 0)      MergeQuarter<needSecond, raw, true, 0>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+        else if (belowKind == 1) MergeQuarter<needSecond, raw, true, 1>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+        else                     MergeQuarter<needSecond, raw, true, 2>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+    }
+    else
+    {
+        if (belowKind == 0)      MergeQuarter<needSecond, raw, false, 0>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+        else if (belowKind == 1) MergeQuarter<needSecond, raw, false, 1>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+        else                     MergeQuarter<needSecond, raw, false, 2>(c3line, base, belowTop, belowSec, aboveTop, aboveSec, outTop, outSecond);
+    }
+}
+
 void BananaRenderer2D::CompositeHires(u32* dst, const u32* const* q3d)
 {
     // which colour effects can apply on this line? (CompositeTo's test)
@@ -2484,8 +2515,10 @@ void BananaRenderer2D::CompositeHires(u32* dst, const u32* const* q3d)
         return;
     }
     const bool onBackdrop = Banana2DFast && startLine == BackdropLine;
-    CompositeRange(steps + start, bg0 - start, startLine, onBackdrop, needSecond, false, BelowTop, BelowSec);
-    CompositeRange(steps + bg0 + 1, n - bg0 - 1, ZeroLine, false, needSecond, false, AboveTop, AboveSec);
+    const int nBelow = bg0 - start, nAbove = n - bg0 - 1;
+    if (nBelow) CompositeRange(steps + start, nBelow, startLine, onBackdrop, needSecond, false, BelowTop, BelowSec);
+    if (nAbove) CompositeRange(steps + bg0 + 1, nAbove, ZeroLine, false, needSecond, false, AboveTop, AboveSec);
+    const int belowKind = nBelow ? 2 : onBackdrop ? 0 : 1;
     const bool raw = steps[bg0].raw3d;
     const u32* const line3d = Line3D;
     for (int q = 0; q < 4; q++)
@@ -2499,521 +2532,13 @@ void BananaRenderer2D::CompositeHires(u32* dst, const u32* const* q3d)
         }
         const u32* c3 = raw ? q3d[q] : BGLine(0);
         u32* top = possible ? TopLine : outs[q];
-        if (needSecond) { if (raw) MergeQuarter<true, true>(c3, BelowTop, BelowSec, AboveTop, AboveSec, top, SecondLine); else MergeQuarter<true, false>(c3, BelowTop, BelowSec, AboveTop, AboveSec, top, SecondLine); }
-        else            { if (raw) MergeQuarter<false, true>(c3, BelowTop, BelowSec, AboveTop, AboveSec, top, nullptr);   else MergeQuarter<false, false>(c3, BelowTop, BelowSec, AboveTop, AboveSec, top, nullptr); }
+        if (needSecond) { if (raw) MergeQuarterN<true, true>(nAbove > 0, belowKind, c3, startLine, BelowTop, BelowSec, AboveTop, AboveSec, top, SecondLine); else MergeQuarterN<true, false>(nAbove > 0, belowKind, c3, startLine, BelowTop, BelowSec, AboveTop, AboveSec, top, SecondLine); }
+        else            { if (raw) MergeQuarterN<false, true>(nAbove > 0, belowKind, c3, startLine, BelowTop, BelowSec, AboveTop, AboveSec, top, nullptr);   else MergeQuarterN<false, false>(nAbove > 0, belowKind, c3, startLine, BelowTop, BelowSec, AboveTop, AboveSec, top, nullptr); }
         if (possible) EffectsTo(outs[q], effect, secondTargets);
     }
     Line3D = line3d;
 }
 
-#ifdef BANANA_NEON
-// melonDS's colour operations (GPU_ColorOp.h) on four pixels, exactly: red and blue are computed packed in one lane
-// (each channel's sum stays below 2^16 before the shift, so neither reaches the other)
-static inline uint32x4_t VBlendN(uint32x4_t v1, uint32x4_t v2, uint32x4_t eva, uint32x4_t evb, int shift)
-{
-    const uint32x4_t mrb = vdupq_n_u32(0x3F003F), mg = vdupq_n_u32(0x3F00);
-    uint32x4_t rb = vdupq_n_u32(shift == 4 ? 0x080008 : 0x100010);
-    uint32x4_t g = vdupq_n_u32(shift == 4 ? 0x000800 : 0x001000);
-    rb = vmlaq_u32(rb, vandq_u32(v1, mrb), eva);
-    rb = vmlaq_u32(rb, vandq_u32(v2, mrb), evb);
-    g = vmlaq_u32(g, vandq_u32(v1, mg), eva);
-    g = vmlaq_u32(g, vandq_u32(v2, mg), evb);
-    if (shift == 4) { rb = vshrq_n_u32(rb, 4); g = vshrq_n_u32(g, 4); }
-    else            { rb = vshrq_n_u32(rb, 5); g = vshrq_n_u32(g, 5); }
-    uint32x4_t r = vminq_u32(vandq_u32(rb, vdupq_n_u32(0xFF)), vdupq_n_u32(0x3F));
-    uint32x4_t b = vminq_u32(vandq_u32(rb, vdupq_n_u32(0x7F0000)), vdupq_n_u32(0x3F0000));
-    g = vminq_u32(vandq_u32(g, vdupq_n_u32(0x7F00)), mg);
-    return vorrq_u32(vorrq_u32(r, g), vorrq_u32(b, vdupq_n_u32(0xFF000000)));
-}
-
-template<bool up>
-static inline uint32x4_t VBright(uint32x4_t val, uint32x4_t evy)
-{
-    uint32x4_t rb = vandq_u32(val, vdupq_n_u32(0x3F003F));
-    uint32x4_t g = vandq_u32(val, vdupq_n_u32(0x3F00));
-    if (up)
-    {
-        rb = vaddq_u32(rb, vandq_u32(vshrq_n_u32(vmlaq_u32(vdupq_n_u32(8 * 0x010001), vsubq_u32(vdupq_n_u32(0x3F003F), rb), evy), 4), vdupq_n_u32(0x3F003F)));
-        g = vaddq_u32(g, vandq_u32(vshrq_n_u32(vmlaq_u32(vdupq_n_u32(8 * 0x000100), vsubq_u32(vdupq_n_u32(0x3F00), g), evy), 4), vdupq_n_u32(0x3F00)));
-    }
-    else
-    {
-        rb = vsubq_u32(rb, vandq_u32(vshrq_n_u32(vmlaq_u32(vdupq_n_u32(7 * 0x010001), rb, evy), 4), vdupq_n_u32(0x3F003F)));
-        g = vsubq_u32(g, vandq_u32(vshrq_n_u32(vmlaq_u32(vdupq_n_u32(7 * 0x000100), g, evy), 4), vdupq_n_u32(0x3F00)));
-    }
-    return vorrq_u32(vorrq_u32(rb, g), vdupq_n_u32(0xFF000000));
-}
-
-// a pixel's BLDCNT 1st-target bit (FirstBitTab) from its flag byte f
-static inline uint32x4_t VFirstBit(uint32x4_t f)
-{
-    uint32x4_t r = vbslq_u32(vtstq_u32(f, vdupq_n_u32(0x40)), vdupq_n_u32(0x01), f);
-    return vbslq_u32(vtstq_u32(f, vdupq_n_u32(0x80)), vdupq_n_u32(0x10), r);
-}
-
-template<bool up>
-void BananaRenderer2D::BrightnessPassNeon(u32* dst)
-{
-    const uint32x4_t bc = vdupq_n_u32(R.BlendCnt), evy = vdupq_n_u32(R.EVY), m20 = vdupq_n_u32(0x20);
-    const u8* wm = WindowsOn ? WindowMask : AllOnes;
-    for (int i = 0; i < 256; i += 4)
-    {
-        uint32x4_t val = vld1q_u32(&TopLine[i]);
-        uint32x4_t hit = vtstq_u32(VFirstBit(vshrq_n_u32(val, 24)), bc);
-        hit = vandq_u32(hit, vtstq_u32(VFromBytes4(*(const u32*)&wm[i]), m20));
-        vst1q_u32(&dst[i], vbslq_u32(hit, VBright<up>(val, evy), val));
-    }
-}
