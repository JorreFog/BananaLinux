-
-void BananaRenderer2D::DrawScanlineHires(u32 line, const u32* const* q3d)
-{
-    if (Banana2DFast)
-    {
-        PrepareScanline(R);
-        DrawScanlineFrom(line, R, q3d[0], q3d);
-        return;
-    }
-    Banana2DRegs regs;
-    PrepareScanline(regs);
