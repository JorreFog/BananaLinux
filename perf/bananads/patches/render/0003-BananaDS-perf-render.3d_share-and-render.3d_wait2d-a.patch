diff --git a/bananads/docs/SETTINGS.md b/bananads/docs/SETTINGS.md
index 6df8537..f4c4e2f 100644
--- a/bananads/docs/SETTINGS.md
+++ b/bananads/docs/SETTINGS.md
@@ -31,9 +31,9 @@ key can also come from the environment as `BANANADS_<KEY>` (dots become undersco
 | `render.2d_thread` | `off` (`on` at `render.scale=2`) | `on` draws the Banana 2D engine's lines (`render.2d=banana`) on a thread of their own (`bananads-2d`), the same pictures: the emulator's thread only snapshots each line (its registers, the 3D layer's line, and the VRAM, palette and OAM changes since the last line, through a copy log) and waits for the thread at the end of the frame. While display capture is on (a game's DISPCAPCNT), that frame's lines are drawn on the emulator's thread, as with `off`. It logs what it did when the game quits (`[2d]`) |
 | `render.2d_batch` | `16` | with `render.2d_thread`, the jobs (two a line: the scanline and the next line's sprites) the emulator's thread hands over before it wakes the 2D thread; the frame's last lines are kicked at VBlank and at the frame's end whatever the value. Larger: fewer wakeups a frame (each a futex syscall on the emulator's thread when the 2D thread sleeps, and an idle exit of its core), the 2D thread further behind within the frame. Same pictures |
 | `render.2d_fast` | `on` | the Banana 2D engine's fast paths (`render.2d=banana`, on either thread of `render.2d_thread`): NEON (aarch64) for the output stage (master brightness, 6-to-8-bit expansion, display modes 2-3), 16-colour text BGs (palette lookups with `tbl`, 8 pixels per `st4`), 256-colour text BGs, direct-colour bitmaps, colour effects (blending, brightness) and sprite resolving; the 3D layer read by the compositor without a pass of its own; affine BGs 4 pixels per step; per-line sprite lists; partial clears of the sprite line. `off`: the portable code. The same pixels either way. Also `BANANADS_RENDER_2D_FAST=off` |
-| `render.3d_share` | `on` | at `render.scale=2` with Gengis, the 2D thread reads Gengis's rows of the 3D frame instead of a 4 KB copy of each line's quarters (Gengis keeps two frames' rows). Exact: the same frames and audio |
+| `render.3d_share` | `on` | with Gengis and the 2D thread, a line's job points at Gengis's rows of the 3D frame (Gengis keeps two frames' rows) instead of a copy: at `render.scale=2` the line's four quarters (4 KB), at 1x the line (1 KB). Exact: the same frames and audio |
 | `render.2d_lazy` | `on` | with the 2D thread (`render.2d_thread`), a frame's last lines may be drawn while the emulator runs the next frame: at a frame's end the emulator waits only for the frame before's, and whoever reads a frame (the KMS presenter, `top()`/`bottom()`, a savestate's picture) waits for its own. Same pictures |
-| `render.3d_wait2d` | `on` | with `render.3d_share`, the 2D thread waits for each line's Gengis bin before compositing it, not the emulator's thread; the emulator waits for the 3D frame only at VBlank (before the geometry engine's next frame). Same pictures |
+| `render.3d_wait2d` | `on` | with `render.3d_share` (1x and 2x), the 2D thread waits for each line's Gengis bin before compositing it, not the emulator's thread; the emulator waits for the 3D frame only at VBlank (before the geometry engine's next frame; with `render.3d_pipeline` only for its conversion). Same pictures |
 | `render.vramtrack_skip` | `on` | VRAM tracking's per-line walk (the Banana 2D engine asks it every line) returns at once when no VRAM mapping changed and its banks have no dirty bit, as the full walk would (patches/melonds/0010). Exact. Bit 4 of `MELONDS_MEMFAST` |
 | `render.renderer` | `gengis` | the 3D renderer: `gengis` (Gengis Engine, SuperDrastic's rasterizer, on several threads; aarch64 builds) or `soft` (melonDS's software renderer) |
 | `render.scale` | `1` | `2` renders the 3D layer at 2x and gives 512x384 screens (`render.renderer=gengis` with `render.2d=banana`; otherwise 1x, with a warning). Gengis Engine renders 512x384 from melonDS's sub-pixel vertex positions; the Banana 2D engine draws its layers at 1x and, on lines where BG0 shows the 3D layer, composites them once for each of the 2x frame's four 256-pixel lines (rows 2y and 2y + 1, even and odd pixels: DraStic's quarters), with blending, windows and brightness; other lines and the bottom screen are doubled. Display capture reads quarter 0. HeartGold, RG DS Plus at 1992 MHz: 65.7 fps against 75.9 at 1x |
diff --git a/bananads/gpu2d/GPU_Banana.cpp b/bananads/gpu2d/GPU_Banana.cpp
index 08c84ed..606b5c1 100644
--- a/bananads/gpu2d/GPU_Banana.cpp
+++ b/bananads/gpu2d/GPU_Banana.cpp
@@ -461,10 +461,14 @@ void BananaRenderer::PrepareScanlineJob(Job& job, u32 line, u32*& line3d)
     line3d = nullptr;
     if (line < 192)
     {
-        // render.3d_wait2d: with the 3D frame's own rows and unit A on the 2D thread, the emulator's thread doesn't
-        // wait for them (GetLine would): the 2D thread does, before it composites the line
-        const bool rows = Quarter && Banana3DShare && Banana3DWait2D && QuarterRow && !AInPlace && QuarterRows &&
-            QuarterRows(QuarterCtx);
+        // render.3d_share: the job points at the 3D frame's own rows (at 2x the four quarters, at 1x the line:
+        // Gengis keeps two frames') instead of a copy, when they are final as they are (QuarterRows: no X scroll, no
+        // aborted frame). render.3d_wait2d: with unit A on the 2D thread, the emulator's thread doesn't wait for the
+        // line's bin (GetLine would): the 2D thread does, before it composites the line
+        const int nq = Quarter ? 4 : 1;
+        const QuarterFn quarter = Quarter ? Quarter : Share1x;
+        const bool share = quarter && Banana3DShare && QuarterRows && QuarterRows(QuarterCtx);
+        const bool rows = share && Banana3DWait2D && QuarterRow && !AInPlace;
         if (!rows)
             line3d = Rend3D->GetLine(line);
         for (int q = 0; q < 4; q++) job.Q3D[q] = job.Line3D[q];
@@ -473,14 +477,14 @@ void BananaRenderer::PrepareScanlineJob(Job& job, u32 line, u32*& line3d)
         {
             if (rows)
             {
-                for (int q = 0; q < 4; q++) job.Q3D[q] = QuarterRow(QuarterCtx, line, q);
+                for (int q = 0; q < nq; q++) job.Q3D[q] = QuarterRow(QuarterCtx, line, q);
                 job.WaitRows = true;
                 job.RowsGen = RowsGen(QuarterCtx);
             }
-            else if (Quarter && Banana3DShare && QuarterRows && QuarterRows(QuarterCtx))
+            else if (share)
             {
-                // render.3d_share: the 3D frame's own rows, not a 4 KB copy
-                for (int q = 0; q < 4; q++) job.Q3D[q] = Quarter(QuarterCtx, line, q);
+                // the 3D frame's own rows (drawn: GetQuarter waits for their bin), not a 4 KB (1 KB) copy
+                for (int q = 0; q < nq; q++) job.Q3D[q] = quarter(QuarterCtx, line, q);
             }
             else if (Quarter)
                 for (int q = 0; q < 4; q++)
diff --git a/bananads/gpu2d/GPU_Banana.h b/bananads/gpu2d/GPU_Banana.h
index 3ce15b1..b4d0c85 100644
--- a/bananads/gpu2d/GPU_Banana.h
+++ b/bananads/gpu2d/GPU_Banana.h
@@ -83,6 +83,9 @@ public:
     typedef const u32* (*QuarterFn)(void* ctx, u32 line, int q);
     typedef bool (*QuarterRowsFn)(void* ctx);  // true: the quarters are the 3D frame's own rows (render.3d_share)
     void SetHires(QuarterFn fn, void* ctx, QuarterRowsFn rows = nullptr);
+    // render.3d_share at 1x: the 3D renderer's line (q 0), the frame's own row when `rows` says so (Gengis keeps two
+    // frames' rows), so a job points at it instead of copying it; with SetHiresRows, render.3d_wait2d as at 2x
+    void SetShare1x(QuarterFn fn, void* ctx, QuarterRowsFn rows) { Drain2D(); Share1x = fn; QuarterCtx = ctx; QuarterRows = rows; }
     // render.3d_wait2d: a quarter's row without waiting, the render drawing it, and a wait for it (the 2D thread's)
     typedef unsigned (*RowsGenFn)(void* ctx);
     typedef void (*WaitRowsFn)(void* ctx, u32 line, unsigned gen);
@@ -109,6 +112,7 @@ private:
     void EmitB(u32* dst, u32 dispcnt, u16 brightness);
     void Fill(u32* dst, u32 val);
     QuarterFn Quarter = nullptr;
+    QuarterFn Share1x = nullptr;   // 1x: the 3D line as a 2x quarter function (q 0 only)
     QuarterRowsFn QuarterRows = nullptr;
     QuarterFn QuarterRow = nullptr;
     RowsGenFn RowsGen = nullptr;
diff --git a/bananads/src/gengis_renderer.h b/bananads/src/gengis_renderer.h
index c6e3fd2..ed39a2b 100644
--- a/bananads/src/gengis_renderer.h
+++ b/bananads/src/gengis_renderer.h
@@ -133,10 +133,9 @@ inline void SetHires(melonDS::SoftRenderer*, GengisRenderer3D*, int) {}
 inline void Drain2D(melonDS::BananaRenderer* r) { r->Drain2D(); }
 inline void Resync2D(melonDS::BananaRenderer* r) { r->Resync2D(); }
 inline void SetHires(melonDS::BananaRenderer* r, GengisRenderer3D* g, int scale) {
-    if (scale == 2) {
-        r->SetHires(&GengisRenderer3D::QuarterFn, g, &GengisRenderer3D::QuarterRowsFn);
-        r->SetHiresRows(&GengisRenderer3D::QuarterRowFn, &GengisRenderer3D::RowsGenFn, &GengisRenderer3D::WaitRowsFn);
-    }
+    if (scale == 2) r->SetHires(&GengisRenderer3D::QuarterFn, g, &GengisRenderer3D::QuarterRowsFn);
+    else r->SetShare1x(&GengisRenderer3D::QuarterFn, g, &GengisRenderer3D::QuarterRowsFn);  // (render.3d_share at 1x)
+    r->SetHiresRows(&GengisRenderer3D::QuarterRowFn, &GengisRenderer3D::RowsGenFn, &GengisRenderer3D::WaitRowsFn);
 }
 #endif
 
