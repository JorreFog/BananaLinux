diff --git a/bananads/docs/SETTINGS.md b/bananads/docs/SETTINGS.md
index f4c4e2f..14684d2 100644
--- a/bananads/docs/SETTINGS.md
+++ b/bananads/docs/SETTINGS.md
@@ -31,6 +31,7 @@ key can also come from the environment as `BANANADS_<KEY>` (dots become undersco
 | `render.2d_thread` | `off` (`on` at `render.scale=2`) | `on` draws the Banana 2D engine's lines (`render.2d=banana`) on a thread of their own (`bananads-2d`), the same pictures: the emulator's thread only snapshots each line (its registers, the 3D layer's line, and the VRAM, palette and OAM changes since the last line, through a copy log) and waits for the thread at the end of the frame. While display capture is on (a game's DISPCAPCNT), that frame's lines are drawn on the emulator's thread, as with `off`. It logs what it did when the game quits (`[2d]`) |
 | `render.2d_batch` | `16` | with `render.2d_thread`, the jobs (two a line: the scanline and the next line's sprites) the emulator's thread hands over before it wakes the 2D thread; the frame's last lines are kicked at VBlank and at the frame's end whatever the value. Larger: fewer wakeups a frame (each a futex syscall on the emulator's thread when the 2D thread sleeps, and an idle exit of its core), the 2D thread further behind within the frame. Same pictures |
 | `render.2d_fast` | `on` | the Banana 2D engine's fast paths (`render.2d=banana`, on either thread of `render.2d_thread`): NEON (aarch64) for the output stage (master brightness, 6-to-8-bit expansion, display modes 2-3), 16-colour text BGs (palette lookups with `tbl`, 8 pixels per `st4`), 256-colour text BGs, direct-colour bitmaps, colour effects (blending, brightness) and sprite resolving; the 3D layer read by the compositor without a pass of its own; affine BGs 4 pixels per step; per-line sprite lists; partial clears of the sprite line. `off`: the portable code. The same pixels either way. Also `BANANADS_RENDER_2D_FAST=off` |
+| `render.2d_comp_unroll` | `on` | the Banana 2D engine's compositor (the painter's pass over the layer lines, four pixels at a time) with its loop over the layers unrolled by the template (a fold over the steps), the same operations in the same order; `off`: the plain loop, which GCC compiles well only at `-O3` (BananaLinux builds at `-O2`: 2.5-3x the instructions per line). Same pixels |
 | `render.3d_share` | `on` | with Gengis and the 2D thread, a line's job points at Gengis's rows of the 3D frame (Gengis keeps two frames' rows) instead of a copy: at `render.scale=2` the line's four quarters (4 KB), at 1x the line (1 KB). Exact: the same frames and audio |
 | `render.2d_lazy` | `on` | with the 2D thread (`render.2d_thread`), a frame's last lines may be drawn while the emulator runs the next frame: at a frame's end the emulator waits only for the frame before's, and whoever reads a frame (the KMS presenter, `top()`/`bottom()`, a savestate's picture) waits for its own. Same pictures |
 | `render.3d_wait2d` | `on` | with `render.3d_share` (1x and 2x), the 2D thread waits for each line's Gengis bin before compositing it, not the emulator's thread; the emulator waits for the 3D frame only at VBlank (before the geometry engine's next frame; with `render.3d_pipeline` only for its conversion). Same pictures |
diff --git a/bananads/gpu2d/GPU2D_Banana.cpp b/bananads/gpu2d/GPU2D_Banana.cpp
index 6d5452e..c92da1f 100644
--- a/bananads/gpu2d/GPU2D_Banana.cpp
+++ b/bananads/gpu2d/GPU2D_Banana.cpp
@@ -19,6 +19,7 @@
 */
 
 #include <string.h>
+#include <utility>
 #include "GPU2D_Banana.h"
 #include "GPU_ColorOp.h"
 
@@ -126,6 +127,7 @@ namespace melonDS
 {
 
 bool Banana2DFast = true;
+bool Banana2DCompUnroll = true;
 bool Banana3DShare = true;
 bool Banana3DWait2D = true;
 
@@ -2283,10 +2285,61 @@ static void CompositeLoop(const CompStep* steps, const u32* startLine, u32* outT
     }
 }
 
+// render.2d_comp_unroll: CompositeLoop with its step loop unrolled by a fold over the steps, each step's constants a
+// variable of its own: the same operations in the same order (a fold expression goes left to right), but at the
+// device's -O2 GCC keeps CompositeLoop's per-step arrays in memory and reloads them for every step of every four
+// pixels (2.5-3x the instructions of its -O3 code); this shape costs the same at -O2 as the loop at -O3
+// (evidence: tools/perf comp_bench, 2026-10-18)
+template<bool needSecond, bool has3d>
+static inline void CompositeStep(const u32* line, const u32* prio, V4 prioval, V4 priomask, V4 orv, V4 flagbyte, int i, V4& top, V4& sec)
+{
+    V4 c = VLoad(line + i);
+    V4 m;
+    if (has3d)
+    {
+        m = VNonZero(VAnd(c, flagbyte));
+        c = VOr(c, orv);
+    }
+    else
+        m = VNonZero(c);
+    if (prio)
+        m = VAnd(m, VEq(VAnd(VLoad(prio + i), priomask), prioval));
+    if (needSecond)
+        sec = VSel(m, top, sec);
+    top = VSel(m, c, top);
+}
+
+template<int N, bool needSecond, bool has3d, bool onBackdrop, size_t... K>
+static void CompositeLoopUnrolled(const CompStep* steps, const u32* startLine, u32* outTop, u32* outSecond, std::index_sequence<K...>)
+{
+    const u32* line[N > 0 ? N : 1] = { steps[K].line... };
+    const u32* prio[N > 0 ? N : 1] = { steps[K].prio... };
+    const V4 prioval[N > 0 ? N : 1] = { VDup(steps[K].prioval)... };
+    const V4 priomask[N > 0 ? N : 1] = { VDup(steps[K].priomask)... };
+    const V4 orv[N > 0 ? N : 1] = { VDup(steps[K].raw3d ? 0x40000000u : 0u)... };
+    const V4 flagbyte = VDup(0xFF000000);
+    const V4 backdrop = VDup(startLine[0]);
+    for (int i = 0; i < 256; i += 4)
+    {
+        V4 top = onBackdrop ? backdrop : VLoad(startLine + i);
+        V4 sec = VZero();
+        (CompositeStep<needSecond, has3d>(line[K], prio[K], prioval[K], priomask[K], orv[K], flagbyte, i, top, sec), ...);
+        VStore(outTop + i, top);
+        if (needSecond)
+            VStore(outSecond + i, sec);
+    }
+}
+
 // (the backdrop case as its own loop, so neither has a test per step)
 template<int N, bool needSecond, bool has3d>
 static void CompositeN(const CompStep* steps, const u32* startLine, bool onBackdrop, u32* outTop, u32* outSecond)
 {
+    if (Banana2DCompUnroll)
+    {
+        if (onBackdrop) CompositeLoopUnrolled<N, needSecond, has3d, true>(steps, startLine, outTop, outSecond, std::make_index_sequence<N>{});
+        else            CompositeLoopUnrolled<N, needSecond, has3d, false>(steps, startLine, outTop, outSecond, std::make_index_sequence<N>{});
+        return;
+    }
     if (onBackdrop) CompositeLoop<N, needSecond, has3d, true>(steps, startLine, outTop, outSecond);
     else            CompositeLoop<N, needSecond, has3d, false>(steps, startLine, outTop, outSecond);
 }
