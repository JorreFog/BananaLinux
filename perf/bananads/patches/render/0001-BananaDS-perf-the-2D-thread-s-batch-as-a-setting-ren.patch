From 7ebe4e9cc071ab319fdf4218f24473b878bed415 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 15:26:04 +0000
Subject: [PATCH 1/8] BananaDS perf: the 2D thread's batch as a setting
 (render.2d_batch)

KickBatch, the jobs the emulator's thread hands over before it wakes the 2D thread, was a constant 16: about 24
wakeups a frame, each a futex syscall on the emulator's thread when the 2D thread sleeps (it usually does: it has
less to do) and an idle exit of the 2D thread's core (220 us on the RG DS's A55s, BANANALINUX.md B3). It is
render.2d_batch now, 16 by default, 1..512; the frame's last lines are still kicked at VBlank and at the frame's
end. Same pictures whatever the value: the batch only decides when the 2D thread is woken, never what it draws.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PvbFhKAw3ERk5a13S651g1
---
 bananads/docs/SETTINGS.md   | 1 +
 bananads/gpu2d/GPU_Banana.h | 6 +++++-
 bananads/src/emu.cpp        | 2 ++
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/bananads/docs/SETTINGS.md b/bananads/docs/SETTINGS.md
index 223568b..35cd95c 100644
--- a/bananads/docs/SETTINGS.md
+++ b/bananads/docs/SETTINGS.md
@@ -29,6 +29,7 @@ key can also come from the environment as `BANANADS_<KEY>` (dots become undersco
 | `render.geom_fast` | `on` | the 3D geometry engine's fast paths (patches/melonds/0011): the GX command ports and the GX FIFO port reached first, with the FIFO write inline; `GPU3D::Run` with each command's FIFO read, DMA and IRQ checks and cycle accounting inline; NEON for the matrix commands, the clip matrix and the vertex transform (s32 x s32 -> s64, then >> 12, as the C code); clipping only against the planes a polygon's vertices are outside of; one division per axis for a vertex's screen position; a strip's shared vertices keep the previous polygon's Z. Exact (the same vertices, polygons, GXSTAT, FIFO timing and matrix and test results). `MELONDS_GEOMFAST=0` turns it off |
 | `render.2d` | `banana` | the 2D renderer: `banana` (the Banana 2D engine, gpu2d/: melonDS's picture, pixel for pixel, in about a third of the time) or `melonds` (melonDS's own) |
 | `render.2d_thread` | `off` (`on` at `render.scale=2`) | `on` draws the Banana 2D engine's lines (`render.2d=banana`) on a thread of their own (`bananads-2d`), the same pictures: the emulator's thread only snapshots each line (its registers, the 3D layer's line, and the VRAM, palette and OAM changes since the last line, through a copy log) and waits for the thread at the end of the frame. While display capture is on (a game's DISPCAPCNT), that frame's lines are drawn on the emulator's thread, as with `off`. It logs what it did when the game quits (`[2d]`) |
+| `render.2d_batch` | `16` | with `render.2d_thread`, the jobs (two a line: the scanline and the next line's sprites) the emulator's thread hands over before it wakes the 2D thread; the frame's last lines are kicked at VBlank and at the frame's end whatever the value. Larger: fewer wakeups a frame (each a futex syscall on the emulator's thread when the 2D thread sleeps, and an idle exit of its core), the 2D thread further behind within the frame. Same pictures |
 | `render.2d_fast` | `on` | the Banana 2D engine's fast paths (`render.2d=banana`, on either thread of `render.2d_thread`): NEON (aarch64) for the output stage (master brightness, 6-to-8-bit expansion, display modes 2-3), 16-colour text BGs (palette lookups with `tbl`, 8 pixels per `st4`), 256-colour text BGs, direct-colour bitmaps, colour effects (blending, brightness) and sprite resolving; the 3D layer read by the compositor without a pass of its own; affine BGs 4 pixels per step; per-line sprite lists; partial clears of the sprite line. `off`: the portable code. The same pixels either way. Also `BANANADS_RENDER_2D_FAST=off` |
 | `render.3d_share` | `on` | at `render.scale=2` with Gengis, the 2D thread reads Gengis's rows of the 3D frame instead of a 4 KB copy of each line's quarters (Gengis keeps two frames' rows). Exact: the same frames and audio |
 | `render.2d_lazy` | `on` | with the 2D thread (`render.2d_thread`), a frame's last lines may be drawn while the emulator runs the next frame: at a frame's end the emulator waits only for the frame before's, and whoever reads a frame (the KMS presenter, `top()`/`bottom()`, a savestate's picture) waits for its own. Same pictures |
diff --git a/bananads/gpu2d/GPU_Banana.h b/bananads/gpu2d/GPU_Banana.h
index a39b595..3ce15b1 100644
--- a/bananads/gpu2d/GPU_Banana.h
+++ b/bananads/gpu2d/GPU_Banana.h
@@ -73,6 +73,10 @@ public:
 
     void SetThreaded2D(bool on);
     bool IsThreaded2D() const { return Thread2D; }
+    // render.2d_batch: the jobs (a line is two: scanline and sprites) handed over before the 2D thread is woken; a
+    // wakeup is a futex syscall on the emulator's thread when the 2D thread sleeps, and the 2D thread's idle exit.
+    // The frame's last lines are kicked at VBlank and at the frame's end whatever the batch. 1..NumJobs
+    void SetKickBatch(u32 n) { KickBatch = n < 1 ? 1 : n > NumJobs ? NumJobs : n; }
     // render.scale=2: the 3D renderer's four quarter lines of a DS line (quarter q: 2x row 2 * line + (q >> 1), its
     // even pixels or, q & 1, its odd ones). Unit A composites each line that shows the 3D layer four times, and the
     // framebuffers become 512x384 (GetFramebuffers); everything else is drawn at 1x and doubled.
@@ -138,7 +142,7 @@ private:
     // a whole frame's jobs (192 lines and 191 sprite lines): the emulator's thread doesn't wait for a 2D thread that
     // lags within the frame, which catches up in VBlank (drained at the frame's end, SwapBuffers)
     static constexpr u32 NumJobs = 512;
-    static constexpr u32 KickBatch = 16;  // jobs handed over before the thread is woken (fewer wakeups)
+    u32 KickBatch = 16;  // jobs handed over before the thread is woken (render.2d_batch; fewer wakeups when larger)
 
     Job& NewJob();
     void Submit();
diff --git a/bananads/src/emu.cpp b/bananads/src/emu.cpp
index 6fc053c..3655014 100644
--- a/bananads/src/emu.cpp
+++ b/bananads/src/emu.cpp
@@ -471,6 +471,8 @@ bool Emu::load_rom(const std::string& path) {
     // (on by default at 2x, where unit A composites four times: HeartGold at 1104 MHz 39.8 -> 49.6 fps)
     if (banana2d) banana_ = &static_cast<BananaRenderer&>(nds_->GetRenderer());
     if (banana2d && cfg_.flag("render.2d_thread", scale_ == 2)) banana_->SetThreaded2D(true);
+    // render.2d_batch: jobs handed to the 2D thread before it is woken (16: about 24 wakeups a frame)
+    if (banana2d) banana_->SetKickBatch((u32)cfg_.num("render.2d_batch", 16));
 #endif
 
     set_clock();
