diff --git a/src/NDS.cpp b/src/NDS.cpp
index 1991a5c..a738b4c 100644
--- a/src/NDS.cpp
+++ b/src/NDS.cpp
@@ -1463,6 +1463,59 @@ void NDS::RunSlicesJIT()
             break;
     }
 }
+
+// SliceChain (exact): the end of RunSlicesJIT's iteration and the start of the next, for the case where they only
+// keep time, from the ARM9's exit stubs (NDS.h). The checks are the loop's own, in the order it makes them; any
+// other case returns 0 before changing anything, and the loop then does what it always did. Continuing differs
+// from the loop only in what isn't emulated state: the ARM9's next block is reached through the exit's link or
+// lookup instead of the loop's lookup and ARM_Dispatch.
+[[gnu::always_inline]] inline u32 NDS::SliceChainStep() noexcept
+{
+    NDS& n = *this;
+    char* const sb = PinAddress(reinterpret_cast<char*>(&n.SysTimestamp));
+    const u32 shift = n.ARM9ClockShift;
+    // ExecuteJITInline's loop has ended (the stub has added the cycles; StopExecution is clear); target = the ARM9's
+    // time, as the loop takes it
+    const u64 target = n.ARM9Timestamp >> shift;
+    // the ARM7: ahead of the ARM9 (nothing to do), or halted with no IRQ to wake it (first: with a busy ARM7 this is
+    // the way out every time)
+    const bool arm7behind = n.ARM7Timestamp < target;
+    if (arm7behind && !(PinAddress(&n.ARM7)->Halted == 1 && !n.HaltInterrupted(1)))
+        return 0;
+    // RunEventsDue (or SchedNext to recompute: 0), RunTimers
+    const u64 next = SCHED(sb, SchedNext);
+    if (target >= next || target >= SCHED(sb, TimerNextMin))
+        return 0;
+    const u32 stop = n.CPUStop;
+    if ((stop & (CPUStop_GXStall | CPUStop_DMA9 | CPUStop_DMA7 | CPUStop_Sleep)) || !n.SliceChainOK)
+        return 0;
+    // GPU3D::Run's early-out
+    GPU3D& gpu3d = *PinAddress(&n.GPU.GPU3D);
+    if (!((gpu3d.CmdPIPE.IsEmpty() && !(gpu3d.GXStat & (1<<27))) || !gpu3d.GeometryEnabled || gpu3d.FlushRequest))
+        return 0;
+    // the loop goes on, and runs the ARM9 (not halted, which StopExecution would have said)
+    if (!SCHED(sb, Running) || PinAddress(&n.ARM9)->Halted)
+        return 0;
+
+    // the iteration's end: the fast branch, RunSystem with nothing due
+    gpu3d.Timestamp = target;
+    if (arm7behind)
+    {
+        n.ARM7Target = target;
+        n.ARM7Timestamp = target;
+    }
+    SCHED(sb, SysTimestamp) = target;
+    // the next iteration: NextTarget (FastSched), ARM9Target
+    const s32 slice = target < SCHED(sb, SliceNearIPCUntil) ? SCHED(sb, SliceShort) : SCHED(sb, SliceIdle);
+    const u64 max = target + slice;
+    n.ARM9Target = ((next < max + kIterationCycleMargin) ? next : max) << shift;
+    return 1;
+}
+
+u32 NDS::SliceChain9(NDS* nds) noexcept
+{
+    return nds->SliceChainStep();
+}
 #endif
 
