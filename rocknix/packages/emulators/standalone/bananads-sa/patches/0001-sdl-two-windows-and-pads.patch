BananaDS's SDL frontend on a two-screen handheld under a Wayland compositor (the AYN Thor under ROCKNIX's sway):
- sdl.windows=2: a full-screen window for each DS screen, the bottom one titled "BananaDS Bottom" (ROCKNIX's sway
  puts windows named so on its second output); the stylus is a touch on the bottom one
- pads through SDL's game controllers (ROCKNIX's InputPlumber pad), by place in Nintendo's layout; the left stick as
  the d-pad; Select + Start or the guide button quits (the game's state kept for the next start)

diff --git a/bananads/src/frontend_sdl.cpp b/bananads/src/frontend_sdl.cpp
index ed8767a..f715923 100644
--- a/bananads/src/frontend_sdl.cpp
+++ b/bananads/src/frontend_sdl.cpp
@@ -90,14 +90,45 @@ static uint32_t key_bit(SDL_Keycode k) {
     }
 }
 
+// A pad (SDL's game controller: ROCKNIX's InputPlumber pad, any USB or Bluetooth one) as the DS's buttons, by their
+// place: the right face button is the DS's A, the bottom one B, the top one X, the left one Y (Nintendo's layout)
+static uint32_t pad_bit(int b) {
+    switch (b) {
+        case SDL_CONTROLLER_BUTTON_B: return KeyA;
+        case SDL_CONTROLLER_BUTTON_A: return KeyB;
+        case SDL_CONTROLLER_BUTTON_Y: return KeyX;
+        case SDL_CONTROLLER_BUTTON_X: return KeyY;
+        case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return KeyL;
+        case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return KeyR;
+        case SDL_CONTROLLER_BUTTON_START: return KeyStart;
+        case SDL_CONTROLLER_BUTTON_BACK: return KeySelect;
+        case SDL_CONTROLLER_BUTTON_DPAD_UP: return KeyUp;
+        case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return KeyDown;
+        case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return KeyLeft;
+        case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return KeyRight;
+        default: return 0;
+    }
+}
