[Unit]
Description=BananaOS menu on both screens (with Sway)
# in EmulationStation's place: essway's own unit, with banana-ui; essway is masked for the boot when this starts
Requires=sway.service
After=sway.service
Conflicts=essway.service

[Service]
Type=simple
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStartPre=-/usr/bin/systemctl mask --runtime essway.service
ExecStartPre=-/usr/bin/systemctl stop --no-block essway.service
ExecStart=/usr/bin/start_banana.sh
WorkingDirectory=/storage
Restart=always
RestartSec=2

[Install]
WantedBy=rocknix.target
