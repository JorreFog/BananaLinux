 static void s_present(Surf *top, Surf *bot) {
+    if (two) {
+        /* each screen into its own window: the pixels with their alpha set, as the composite's */
+        Surf *sc[2] = { top, bot };
+        SDL_Renderer *rr[2] = { ren, ren2 };
+        SDL_Texture *tt[2] = { tex, tex2 };
+        for (int k = 0; k < 2; k++) {
+            Surf *f = sc[k];
+            for (int y = 0; y < f->h; y++) for (int x = 0; x < f->w; x++) comp[(size_t)y * f->w + x] = 0xff000000 | f->px[(size_t)y * f->pitch + x];
+            p_SDL_UpdateTexture(tt[k], 0, comp, f->w * 4);
+            int ow, oh; p_SDL_GetRendererOutputSize(rr[k], &ow, &oh);
+            SDL_Rect dst = fit(f->w, f->h, ow, oh);
+            p_SDL_SetRenderDrawColor(rr[k], 0, 0, 0, 255);
+            p_SDL_RenderClear(rr[k]);
+            p_SDL_RenderCopy(rr[k], tt[k], 0, &dst);
+        }
+        p_SDL_RenderPresent(ren2);
+        p_SDL_RenderPresent(ren);
+        return;
+    }
     for (size_t i = 0; i < (size_t)lw * lh; i++) comp[i] = 0xff0c0c10;
