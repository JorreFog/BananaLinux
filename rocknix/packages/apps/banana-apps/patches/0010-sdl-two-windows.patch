+/* where a screen of w x h goes in a window of ow x oh (fitted, centred) */
+static SDL_Rect fit(int w, int h, int ow, int oh) {
+    float f = MIN((float)ow / w, (float)oh / h);
+    SDL_Rect r = { 0, 0, (int)(w * f), (int)(h * f) };
+    r.x = (ow - r.w) / 2; r.y = (oh - r.h) / 2;
+    return r;
+}
