{
  // Classic: a bright handheld menu made from a mockup. The top screen: a status bar (volume, the user's name, the
  // date and time, the battery in four bars) over a large rounded photo of what is selected. The bottom screen: the
  // name in a box pointing down at a row of icons, the middle one framed in blue with START under it, and a scroll bar
  // with blue arrows. The systems at home, a system's games in a library. Only this file: library and launch use
  // home's screens.
  "name": "Classic",
  "author": "BananaOS",
  "base": "light",
  "accent": "#2a8fe0",
  "font": "inter",

  "vars": {
    "lib": "=view != 'home'",
    "blue": "#2a8fe0",
    "sky": "#7cc8f4",
    "line": "#b9bcc2",
    "pale": "#f4f5f7",
    "user": "Banana",
    "title": "=lib ? game.title : sys.name",
    "maker": "=lib ? either(game.sub, sys.name) : either(sys.maker, 'Banana')"
  },

  "input": {
    "home": { "left": "prev", "right": "next", "up": "none", "down": "none", "l": "prev:4", "r": "next:4" },
    "library": { "left": "prev", "right": "next", "up": "none", "down": "none", "l": "prev:4", "r": "next:4" }
  },
  "behavior": { "launchMs": 1100, "scrollMs": 90, "cues": { "insert": 900 } },

  "components": {
    // a battery in four bars
    "battery": { "type": "group", "w": 26, "h": 14, "children": [
      { "type": "rect", "x": 0, "y": 0, "w": 23, "h": 14, "radius": 2, "fill": "#ffffff", "border": 1.5, "borderColor": "#4a4d55" },
      { "type": "rect", "x": 23, "y": 4, "w": 3, "h": 6, "radius": 1, "fill": "#4a4d55" },
      { "type": "list", "source": "range", "count": 4, "direction": "row", "scrollMode": "none", "x": 3, "y": 3, "w": 18, "h": 8, "itemW": 3.6, "gap": 1,
        "item": { "type": "rect", "w": 3.6, "h": 8, "fill": "=battery < 20 ? '#e04848' : blue",
          "visible": "=battery < 0 ? i < 4 : i < ceil(battery / 25)" } } ] },
    // a blue arrow button of the scroll bar
    "arrow": { "type": "group", "w": 30, "h": 30, "radius": 8,
      "gradient": { "angle": 180, "stops": [ "#8fd2fb", "#3ba4ec 55%", "#2a8fe0" ] }, "border": 1.5, "borderColor": "#1f74bb",
      "children": [ { "type": "text", "w": 30, "y": 5, "align": "center", "text": "{glyph}", "font": "inter-bold", "size": 15, "color": "#ffffff" } ] },
    // an icon tile: white, a grey edge, the picture inside
    "tile": { "type": "group", "w": 104, "h": 104, "anchor": "center", "radius": 14, "fill": "#ffffff", "border": 2, "borderColor": "=line",
      "shadow": { "y": 2, "blur": 4, "color": "#00000022" },
      "children": [
        { "type": "image", "src": "{pic}", "fallback": "{icon}", "fit": "=pix ? 'pixelContain' : 'cover'", "x": 10, "y": 10, "w": 84, "h": 84, "radius": "=pix ? 0 : 6",
          "placeholder": "#e8e9ec" } ] }
  },

  "screens": {
    "home": {
      "top": [
        { "type": "rect", "gradient": { "angle": 180, "stops": [ "#ffffff", "#e9ebef" ] } },
        // the status bar
        { "type": "rect", "x": 0, "y": 0, "w": 640, "h": 40, "gradient": { "angle": 180, "stops": [ "#ffffff", "#eef0f3" ] } },
        { "type": "rect", "x": 0, "y": 40, "w": 640, "h": 2, "fill": "=line" },
        { "type": "group", "x": 14, "y": 12, "w": 24, "h": 18, "children": [
          { "type": "rect", "x": 0, "y": 5, "w": 6, "h": 8, "fill": "#4a4d55" },
          { "type": "rect", "x": 5, "y": 2, "w": 6, "h": 14, "radius": [0, 3, 3, 0], "fill": "#4a4d55" },
          { "type": "rect", "x": 14, "y": 5, "w": 2, "h": 8, "radius": 1, "fill": "#4a4d55" },
          { "type": "rect", "x": 18, "y": 2, "w": 2, "h": 14, "radius": 1, "fill": "#4a4d55" } ] },
        { "type": "text", "x": 48, "y": 9, "text": "=user", "font": "inter-semibold", "size": 18, "color": "=blue" },
        { "type": "text", "right": 56, "y": 9, "w": 220, "align": "right", "text": "{date}  {clock}", "font": "inter-semibold", "size": 18, "color": "=blue" },
        { "use": "battery", "right": 16, "y": 13 },
        // the photo: what is selected, in a thick rounded frame
        { "type": "group", "x": 40, "y": 56, "w": 560, "h": 410, "radius": 22, "fill": "#ffffff", "border": 2, "borderColor": "=line",
          "shadow": { "y": 3, "blur": 8, "color": "#00000026" },
          "children": [
            { "type": "rect", "x": 12, "y": 12, "w": 536, "h": 386, "radius": 14, "gradient": { "angle": 180, "stops": [ "=mix(sys.color, '#ffffff', 0.55)", "=mix(sys.color, '#ffffff', 0.85)" ] } },
            { "type": "image", "src": "=lib ? either(game.art, game.romIcon) : sys.icon", "fallback": "=either(game.icon, sys.icon)",
              "fit": "=!lib || !game.art ? 'pixelContain' : 'cover'", "x": 12, "y": 12, "w": 536, "h": 386, "radius": 14,
              "opacity": "=easeOut(progress(moved, 220))" },
            // the corner labels, as on the photo: the shoulder buttons
            { "type": "group", "x": 12, "y": 360, "layout": "row", "gap": 6, "align": "center", "padding": 6, "h": 38, "radius": [0, 12, 0, 14], "fill": "#ffffffd8",
              "children": [
                { "type": "group", "w": 22, "h": 22, "radius": 5, "fill": "#4a4d55", "children": [ { "type": "text", "w": 22, "y": 2, "align": "center", "text": "L", "font": "inter-bold", "size": 13, "color": "#ffffff" } ] },
                { "type": "text", "text": "=lib ? sys.name : 'Previous'", "font": "inter-semibold", "size": 15, "color": "#4a4d55" } ] },
            { "type": "group", "right": 12, "y": 360, "layout": "row", "gap": 6, "align": "center", "padding": 6, "h": 38, "radius": [12, 0, 14, 0], "fill": "#ffffffd8",
              "children": [
                { "type": "text", "text": "=lib ? plural(count, 'game') : plural(count, 'system')", "font": "inter-semibold", "size": 15, "color": "#4a4d55" },
                { "type": "group", "w": 22, "h": 22, "radius": 5, "fill": "#4a4d55", "children": [ { "type": "text", "w": 22, "y": 2, "align": "center", "text": "R", "font": "inter-bold", "size": 13, "color": "#ffffff" } ] } ] }
          ] }
      ],
      "bottom": [
        { "type": "rect", "gradient": { "angle": 180, "stops": [ "#eef0f3", "#ffffff 40%", "#e4e6ea" ] } },
        // the name box and its pointer down at the selection
        { "type": "group", "x": 70, "y": 22, "w": 500, "h": 96, "radius": 16, "fill": "#ffffff", "border": 3, "borderColor": "=line",
          "shadow": { "y": 2, "blur": 5, "color": "#00000020" },
          "children": [
            { "type": "text", "x": 16, "w": 468, "y": 18, "align": "center", "text": "{title}", "font": "inter-bold", "size": 24, "color": "#2b2d33",
              "opacity": "=easeOut(progress(moved, 180))" },
            { "type": "text", "x": 16, "w": 468, "y": 56, "align": "center", "text": "{maker}", "font": "inter-medium", "size": 17, "color": "#5d6069" } ] },
        { "type": "text", "x": 320, "y": 124, "anchor": "top", "text": "▼", "font": "inter", "size": 20, "color": "=line" },
        // the icons: a row, the selection in the middle
        { "type": "list", "source": "systems", "direction": "row", "scrollMode": "center", "visible": "=!lib",
          "x": 0, "y": 150, "w": 640, "h": 200, "itemW": 124, "itemH": 200, "gap": 10,
          "item": { "type": "group", "w": 124, "h": 200, "children": [
            { "use": "tile", "x": 62, "y": 96, "scale": "=sel ? 1.12 : 1", "smooth": { "scale": 80 },
              "with": { "pic": "{item.icon}", "icon": "{item.icon}", "pix": 1 } } ] } },
        { "type": "list", "source": "games", "direction": "row", "scrollMode": "center", "visible": "=lib",
          "x": 0, "y": 150, "w": 640, "h": 200, "itemW": 124, "itemH": 200, "gap": 10,
          "item": { "type": "group", "w": 124, "h": 200, "opacity": "=sel ? 1 : 1 - launch.progress", "children": [
            { "use": "tile", "x": 62, "y": 96, "scale": "=sel ? 1.12 + 0.2 * easeOutBack(launch.progress) : 1", "smooth": { "scale": 80 },
              "with": { "pic": "=either(item.art, item.romIcon)", "icon": "=either(item.icon, sys.icon)", "pix": "=!item.art" } } ] } },
        // the frame round the selection, START under it
        { "type": "group", "x": 320, "y": 262, "w": 146, "h": 172, "anchor": "center", "onTap": "a",
          "children": [
            { "type": "rect", "radius": 20, "border": 5, "borderColor": "=sky", "shadow": { "blur": 8, "color": "#7cc8f430" } },
            { "type": "group", "x": 25, "y": 140, "w": 96, "h": 30, "radius": [0, 0, 16, 16],
              "gradient": { "angle": 180, "stops": [ "#8fd2fb", "#3ba4ec 55%", "#2a8fe0" ] },
              "children": [ { "type": "text", "w": 96, "y": 5, "align": "center", "text": "START", "font": "inter-bold", "size": 16, "color": "#ffffff", "spacing": 1 } ] } ] },
        // the scroll bar: arrows at the ends, ticks along the track, the thumb where the selection is
        { "type": "group", "x": 20, "y": 412, "w": 600, "h": 42, "radius": 12, "fill": "#dfe2e7", "border": 1.5, "borderColor": "=line",
          "children": [
            { "use": "arrow", "x": 6, "y": 6, "onTap": "left", "with": { "glyph": "◀" } },
            { "use": "arrow", "right": 6, "y": 6, "onTap": "right", "with": { "glyph": "▶" } },
            { "type": "rect", "x": 48, "y": 19, "w": 504, "h": 4, "radius": 2, "fill": "#b4b8c0" },
            { "type": "list", "source": "range", "count": "=count", "direction": "free", "range": 999, "scrollMode": "none",
              "item": { "type": "rect", "x": "=52 + 496 * i / max(1, n - 1)", "y": 17, "w": 2, "h": 8, "anchor": "top", "fill": "#9a9ea8" } },
            { "type": "rect", "x": "=52 + 496 * scroll / max(1, count - 1)", "y": 10, "w": 34, "h": 22, "anchor": "top", "radius": 6,
              "gradient": { "angle": 180, "stops": [ "#ffffff", "#e3e6eb" ] }, "border": 1.5, "borderColor": "#8f949e" }
          ] }
      ]
    }
  }
}
